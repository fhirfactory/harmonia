<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>net.fhirfactory.harmonia</groupId>
        <artifactId>paradeigma</artifactId>
        <version>1.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>paradeigma-test</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <packaging>jar</packaging>
    <name>Harmonia :: Paradeigma :: Test Suite</name>
    <description>Paradeigma Test Suite — Comprehensive automated unit, component, integration, and E2E scenario test suite validating all 9 interfaces, fan-out, routing, concurrency, and failure recovery</description>

    <dependencies>
        <!-- Paradeigma Submodules -->
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>paradeigma-common</artifactId>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>paradeigma-pas</artifactId>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>paradeigma-emr</artifactId>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>paradeigma-lms</artifactId>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>paradeigma-rispac</artifactId>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>paradeigma-scenarios</artifactId>
        </dependency>

        <!-- Harmonia Platform Modules -->
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>erga</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>praxis</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>mnemosyne-clinical</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>pylai-fhir-registry</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>petasos-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>petasos-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>pylai-mllp-base</artifactId>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>calliope</artifactId>
        </dependency>

        <!-- Themis (Policy & Authorisation Subsystem) -->
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>themis-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>themis-core</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>net.fhirfactory.harmonia</groupId>
            <artifactId>themis-audit</artifactId>
            <version>${project.version}</version>
        </dependency>

        <!-- Apache Camel Core for Pipeline Testing -->
        <dependency>
            <groupId>org.apache.camel</groupId>
            <artifactId>camel-core</artifactId>
        </dependency>

        <!-- Testing -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-core</artifactId>
            <version>${logback.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
