% =============================================================================
% ArchiMate 3.2 Formal Relationship Connectors (Arrows)
% =============================================================================
\tikzset{
    % 1. Composition (Solid Line, Solid Diamond at Source)
    archi-composition/.style = {
        -{Diamond[length=6pt, width=5.5pt, fill=black]},
        line width=0.85pt,
        draw=black!85
    },
    % 2. Aggregation (Solid Line, Hollow Diamond at Source)
    archi-aggregation/.style = {
        -{Diamond[length=6pt, width=5.5pt, fill=white]},
        line width=0.85pt,
        draw=black!85
    },
    % 3. Assignment (Solid Line with Solid Circle at Source, Arrow at Target)
    archi-assignment/.style = {
        {Circle[length=3.5pt, fill=black!85]}-{Latex[length=4.5pt, width=3.5pt]},
        line width=0.85pt,
        draw=black!85
    },
    % 4. Realization (Dashed Line, Hollow Triangle Arrow at Target)
    archi-realization/.style = {
        -{Triangle[length=5.5pt, width=5.5pt, fill=white]},
        dashed,
        line width=0.85pt,
        draw=black!85
    },
    % 5. Serving / Used-By (Solid Line, Open Vee Arrow at Target)
    archi-serving/.style = {
        -{Stealth[length=5.5pt, width=4.5pt, open]},
        line width=0.85pt,
        draw=black!85
    },
    % 6. Access (Dashed Line, Open Vee Arrow at Target)
    archi-access/.style = {
        -{Stealth[length=5.5pt, width=4.5pt, open]},
        dashed,
        line width=0.85pt,
        draw=black!85
    },
    % 7. Flow (Dashed Line, Solid Filled Arrow at Target)
    archi-flow/.style = {
        -{Latex[length=5.5pt, width=4.5pt, fill=black!85]},
        dashed,
        line width=0.85pt,
        draw=black!85
    },
    % 8. Triggering (Solid Line, Solid Filled Arrow at Target)
    archi-triggering/.style = {
        -{Latex[length=5.5pt, width=4.5pt, fill=black!85]},
        line width=0.95pt,
        draw=black!85
    },
    % 9. Association (Solid Line, No Arrow)
    archi-association/.style = {
        -,
        line width=0.85pt,
        draw=black!85
    },
    % 10. Influence (Dashed Line, Open Vee Arrow)
    archi-influence/.style = {
        -{Stealth[length=5pt, width=4pt, open]},
        dash pattern=on 3pt off 2pt,
        line width=0.8pt,
        draw=black!85
    }
}

% Helper Macros for Stereotypes & Badges
\newcommand{\archibadge}[1]{{\fontsize{6.5pt}{7.5pt}\selectfont\color{black!65}\textbf{\guillemotleft #1\guillemotright}}\\[1.5pt]}
\newcommand{\archiname}[1]{{\fontsize{8.5pt}{10.5pt}\selectfont\textbf{#1}}}
\newcommand{\archidesc}[1]{{\fontsize{7pt}{8.5pt}\selectfont\textit{#1}}}

