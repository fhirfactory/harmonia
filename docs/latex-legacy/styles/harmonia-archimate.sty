\definecolor{archigroupdraw}{HTML}{CBD5E1}
\definecolor{archiboxfill}{HTML}{F1F5F9}
\definecolor{archiboxdraw}{HTML}{94A3B8}

% =============================================================================
% Base Node Dimensions & Default Geometry
% =============================================================================
\tikzset{
    archimate-base/.style = {
        align=center,
        font=\sffamily\footnotesize,
        line width=0.75pt,
        inner sep=4pt,
        text=black,
        drop shadow={opacity=0.12, shadow xshift=1.2pt, shadow yshift=-1.2pt}
    },
    archimate-box/.style = {
        archimate-base,
        rectangle,
        rounded corners=3pt,
        minimum width=2.8cm,
        minimum height=1.25cm
    },
    archimate-service/.style = {
        archimate-base,
        rectangle,
        rounded corners=9pt,
        minimum width=2.8cm,
        minimum height=1.1cm
    },
    archimate-interface/.style = {
        archimate-base,
        rectangle,
        rounded corners=2pt,
        minimum width=2.6cm,
        minimum height=1.05cm
    },
    archimate-process/.style = {
        archimate-base,
        rectangle,
        rounded corners=4pt,
        minimum width=2.8cm,
        minimum height=1.2cm
    },
    archimate-group/.style = {
        draw=archigroupdraw,
        fill=archigroupfill,
        line width=0.75pt,
        dashed,
        rounded corners=6pt,
        inner sep=10pt
    },
    archimate-plate/.style = {
        draw=archiboxdraw,
        fill=archiboxfill,
        line width=0.75pt,
        rounded corners=6pt,
        inner sep=10pt
    },
    archi-lbl/.style = {
        fill=white,
        fill opacity=0.92,
        text opacity=1.0,
        rounded corners=2pt,
        inner sep=1.5pt,
        font=\sffamily\fontsize{6.5pt}{7.5pt}\selectfont\bfseries,
        draw=gray!35,
        line width=0.4pt
    },
    archi-plate-bg/.style = {
        draw=gray!35,
        fill=gray!4,
        line width=0.75pt,
        dashed,
        rounded corners=6pt,
        inner sep=10pt
    },
    archi-plate-solid/.style = {
        draw=gray!30,
        fill=gray!3,
        line width=0.75pt,
        rounded corners=6pt,
        inner sep=10pt
    },
    archi-plate-title/.style = {
        font=\sffamily\bfseries\scriptsize\color{gray!65},
        anchor=north west
    }
}

