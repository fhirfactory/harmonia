\definecolor{archimotivtext}{HTML}{321128}

% Strategy Layer (Warm Sand / Ochre)
\definecolor{archistratfill}{HTML}{FDF4E3}
\definecolor{archistratdraw}{HTML}{B58428}
\definecolor{archistrattext}{HTML}{422F07}

% Business Layer (Soft Amber / Warm Gold)
\definecolor{archibizfill}{HTML}{FEF9C3}
\definecolor{archibizdraw}{HTML}{B45309}
\definecolor{archibiztext}{HTML}{451A03}

% Application Layer (Clean Soft Sky / Cyan)
\definecolor{archiappfill}{HTML}{E0F2FE}
\definecolor{archiappdraw}{HTML}{0284C7}
\definecolor{archiapptext}{HTML}{0C4A6E}

% Technology Layer (Pale Soft Sage / Emerald)
\definecolor{architechfill}{HTML}{DCFCE7}
\definecolor{architechdraw}{HTML}{16A34A}
\definecolor{architechtext}{HTML}{14532D}

% Physical & Deployment Layer (Cool Slate)
