{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:harmonia:rads:business-architecture-reference:1",
  "title": "Harmonia Business Architecture reference candidate capture",
  "description": "Representation contract only. Architectural authority remains with the cited RADS sources and Business Architecture Metamodel.",
  "type": "object",
  "properties": {
    "$schema": {
      "const": "./business-architecture.schema.json"
    },
    "schema_version": {
      "const": 1
    },
    "capture_status": {
      "const": "candidate"
    },
    "capture_date": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "source_branch": {
      "type": "string",
      "minLength": 1
    },
    "source_commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "authority": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "pattern": "^docs/markdown/"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "path",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "unresolved_meanings": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "views": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "catalogue_contexts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/catalogueContext"
      }
    },
    "elements": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/element"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/relationship"
      }
    }
  },
  "required": [
    "$schema",
    "schema_version",
    "capture_status",
    "capture_date",
    "source_branch",
    "source_commit",
    "authority",
    "sources",
    "unresolved_meanings",
    "views",
    "catalogue_contexts",
    "elements",
    "relationships"
  ],
  "additionalProperties": false,
  "$defs": {
    "sourceReference": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "line": {
          "type": "integer",
          "minimum": 1
        },
        "text": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "source",
        "line",
        "text",
        "anchor"
      ],
      "additionalProperties": false
    },
    "view": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "business_region",
            "business_enabling_view"
          ]
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        }
      },
      "required": [
        "key",
        "name",
        "kind",
        "sources"
      ],
      "additionalProperties": false
    },
    "catalogueContext": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "catalogue_label": {
          "type": "string",
          "minLength": 1
        },
        "container": {
          "type": "string",
          "minLength": 1
        },
        "view": {
          "type": "string",
          "minLength": 1
        },
        "element": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "element_status": {
          "enum": [
            "established",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        }
      },
      "required": [
        "key",
        "name",
        "catalogue_label",
        "container",
        "view",
        "element",
        "element_status",
        "reason",
        "summary",
        "sources"
      ],
      "additionalProperties": false
    },
    "element": {
      "type": "object",
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "capability",
            "feature",
            "function",
            "service",
            "process"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "established",
            "candidate"
          ]
        },
        "category": {
          "enum": [
            "business",
            "business_enabling"
          ]
        },
        "tier": {
          "enum": [
            null,
            "CT1",
            "CT2",
            "CT3",
            "FT"
          ]
        },
        "canonical_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "local_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "name_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "id_aliases": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "capability_parent": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "ancestry_status": {
          "enum": [
            "established",
            "unresolved"
          ]
        },
        "owner": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "views": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "catalogue_context": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        },
        "unresolved": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "summary": {
          "type": "string"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        },
        "catalogue_label": {
          "type": "string",
          "minLength": 1
        },
        "documented_tier_label": {
          "enum": [
            "L1",
            "L2",
            "L3"
          ]
        },
        "relevance": {
          "enum": [
            null,
            "Reference",
            "Adjacent",
            "Harmonia-Relevant",
            "Harmonia-Core"
          ]
        }
      },
      "required": [
        "key",
        "type",
        "name",
        "status",
        "canonical_id",
        "ancestry_status",
        "unresolved",
        "sources"
      ],
      "additionalProperties": false
    },
    "relationship": {
      "type": "object",
      "properties": {
        "type": {
          "enum": [
            "capability_decomposition",
            "responsibility_parent",
            "enabled_by",
            "realises_feature",
            "associated_feature",
            "contributes_feature",
            "governed_process",
            "participating_function",
            "uses_process",
            "exposes_process"
          ]
        },
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "established",
            "unresolved"
          ]
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/sourceReference"
          }
        }
      },
      "required": [
        "type",
        "from",
        "to",
        "status",
        "sources"
      ],
      "additionalProperties": false
    }
  }
}
