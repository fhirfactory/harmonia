{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Harmonia governed architecture identity register",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "semantic_namespace", "records", "events"],
  "properties": {
    "schema_version": {"const": 1},
    "semantic_namespace": {"type": "string", "minLength": 1},
    "records": {"type": "array", "items": {"$ref": "#/$defs/record"}},
    "events": {"type": "array", "items": {"$ref": "#/$defs/event"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "strings": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
    "evidence": {
      "type": "object", "additionalProperties": false,
      "required": ["source_document", "source_section", "source_sha256", "release"],
      "properties": {
        "source_document": {"$ref": "#/$defs/text"},
        "source_section": {"$ref": "#/$defs/text"},
        "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"}
      }
    },
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "scope", "value", "facet"],
      "properties": {
        "kind": {"enum": ["source/capture", "navigation/register", "structural", "implementation"]},
        "scope": {"$ref": "#/$defs/text"},
        "value": {"$ref": "#/$defs/text"},
        "facet": {"type": "string"}
      }
    },
    "record": {
      "type": "object", "additionalProperties": false,
      "required": ["canonical_architecture_id", "origin", "construct_type", "name", "status", "aliases", "source_identifiers", "provenance", "authority", "successors"],
      "properties": {
        "canonical_architecture_id": {"$ref": "#/$defs/text"},
        "origin": {"enum": ["retained", "allocated"]},
        "construct_type": {"enum": ["Capability", "Feature", "Function", "Service", "Process", "Behaviour", "Actor", "Role", "Interaction", "Collaboration", "Information", "Data", "Application", "Technology", "Motivation", "Strategy", "ImplementationMigration", "TraceabilityRelationship"]},
        "name": {"$ref": "#/$defs/text"},
        "status": {"enum": ["active", "deprecated", "retired"]},
        "aliases": {"$ref": "#/$defs/strings"},
        "successors": {"$ref": "#/$defs/strings"},
        "source_identifiers": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/source"}},
        "authority": {"$ref": "#/$defs/evidence"},
        "provenance": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/evidence"}},
        "archimate": {
          "type": "object", "additionalProperties": false,
          "required": ["mode", "semantic_id"],
          "properties": {
            "mode": {"enum": ["locked", "derived"]},
            "semantic_id": {"type": "string", "pattern": "^id-[0-9a-f]{32}$"}
          }
        },
        "relationship": {
          "type": "object", "additionalProperties": false,
          "required": ["source", "target", "predicate"],
          "properties": {
            "source": {"$ref": "#/$defs/text"},
            "target": {"$ref": "#/$defs/text"},
            "predicate": {"$ref": "#/$defs/text"}
          }
        }
      }
    },
    "event": {
      "type": "object", "additionalProperties": false,
      "required": ["kind", "identities", "authority"],
      "properties": {
        "kind": {"enum": ["allocate", "adopt", "rename", "relocate", "reclassify", "deprecate", "retire", "replace", "merge", "split", "bind", "provenance"]},
        "identities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "authority": {"$ref": "#/$defs/evidence"}
      }
    }
  }
}
