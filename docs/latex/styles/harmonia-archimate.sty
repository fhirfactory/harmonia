\definecolor{archimotivdraw}{HTML}{7A3B69}
\definecolor{archimotivtext}{HTML}{2B1124}

% Strategy Layer (Sand / Warm Ochre)
\definecolor{archistratfill}{HTML}{F2E3C6}
\definecolor{archistratdraw}{HTML}{A67C1E}
\definecolor{archistrattext}{HTML}{3D2B05}

% Business Layer (Yellow / Amber)
\definecolor{archibizfill}{HTML}{FFFFB5}
\definecolor{archibizdraw}{HTML}{9E8B00}
\definecolor{archibiztext}{HTML}{383200}

% Application Layer (Light Blue / Cyan)
\definecolor{archiappfill}{HTML}{B5FFFF}
\definecolor{archiappdraw}{HTML}{008099}
\definecolor{archiapptext}{HTML}{002E38}

% Technology Layer (Pale Green)
\definecolor{architechfill}{HTML}{C9E4B5}
\definecolor{architechdraw}{HTML}{4D8A29}
\definecolor{architechtext}{HTML}{1A3609}

% Physical & Deployment Layer (Greenish Slate / Olive Green)
\definecolor{archiphysfill}{HTML}{D5E8D4}
\definecolor{archiphysdraw}{HTML}{54804E}
\definecolor{archiphystext}{HTML}{1C3319}

% Implementation & Migration Layer (Rose / Pink)
\definecolor{archiimplfill}{HTML}{FADBD8}
\definecolor{archiimpldraw}{HTML}{B03A2E}
\definecolor{archiimpltext}{HTML}{49120D}

% Data & Information Layer (Pale Teal)
\definecolor{archidatafill}{HTML}{D1F2EB}
\definecolor{archidatadraw}{HTML}{117A65}
\definecolor{archidatatext}{HTML}{0B3C32}

% Group / Plate / Boundary Colors
\definecolor{archigroupfill}{HTML}{F8F9F9}
\definecolor{archigroupdraw}{HTML}{BDC3C7}
\definecolor{archiboxfill}{HTML}{F2F4F4}
\definecolor{archiboxdraw}{HTML}{95A5A6}

% =============================================================================
% Base Node Dimensions & Default Geometry
% =============================================================================
\tikzset{
    archimate-base/.style = {
        align=center,
        font=\sffamily\footnotesize,
        line width=0.8pt,
        inner sep=4pt,
        text=black,
        drop shadow={opacity=0.15, shadow xshift=1.5pt, shadow yshift=-1.5pt}
    },
    archimate-box/.style = {
        archimate-base,
        rectangle,
        rounded corners=2pt,
        minimum width=2.8cm,
        minimum height=1.3cm
    },
    archimate-service/.style = {
        archimate-base,
        rectangle,
        rounded corners=9pt,
        minimum width=2.8cm,
        minimum height=1.1cm
    },
    archimate-interface/.style = {
        archimate-base,
        rectangle,
        rounded corners=1pt,
        minimum width=2.6cm,
        minimum height=1.0cm
    },
    archimate-process/.style = {
        archimate-base,
        rectangle,
        rounded corners=3pt,
        minimum width=2.8cm,
        minimum height=1.2cm
    },
    archimate-group/.style = {
        draw=archigroupdraw,
        fill=archigroupfill,
        line width=0.8pt,
        dashed,
        rounded corners=4pt,
        inner sep=10pt
    },
    archimate-plate/.style = {
        draw=archiboxdraw,
        fill=archiboxfill,
        line width=0.9pt,
        rounded corners=4pt,
        inner sep=12pt
    }
}

