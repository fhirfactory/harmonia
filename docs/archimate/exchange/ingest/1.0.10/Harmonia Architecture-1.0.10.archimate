              <folder name="[Feature] Medication Order Ingestion" id="id-c5f49fec3d574606a16e6b4032fa0ba8">
                <element xsi:type="archimate:Capability" name="Medication Order Ingestion" id="id-41f5134accc85a82904baca65799badc">
                  <documentation>Ingest inpatient and discharge prescription orders.

