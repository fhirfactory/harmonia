                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;The encounter lifecycle distinguishes the planned opportunity, presence, active encounter and locally applicable completion context. It supplies an administrative progression frame for care information rather than evidence that every clinical objective has been met. The relation to Strategy's ON_LEAVE state remains unresolved, and local signing or legal-closure descriptions do not become universal completion rules.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:episode--encounter-administration&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-ADMINISTRATION-INFORMATION-ENABLEMENT.CT2-BEC-EPISODE-ENCOUNTER-ADMINISTRATION.PR-ENCOUNTER-LIFECYCLE-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Encounter Lifecycle Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Episode \\&amp; Encounter Administration}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the clinical and administrative lifecycle of an acute, emergency, inpatient, or outpatient encounter between a patient and healthcare services.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Planned /\\allowbreak{} Booked → Arrived → Triaged /\\allowbreak{} Ingested → Active In-Progress → Discharged → Completed /\\allowbreak{} Encoded (Scoped illustration; ON\\_LEAVE relationship unresolved)\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Planned / Booked}}: Elective admission or clinic appointment scheduled.\n\n\n\n\\item \n\\texttt{\\seqsplit{Arrived}}: Patient presents at facility or emergency desk.\n\n\n\n\\item \n\\texttt{\\seqsplit{Triaged / Ingested}}: Clinical triage category assigned; encounter record activated.\n\n\n\n\\item \n\\texttt{\\seqsplit{Active In-Progress}}: Inpatient care, bedside monitoring, and clinical orders actively underway.\n\n\n\n\\item \n\\texttt{\\seqsplit{Discharged}}: Patient clinically discharged; care-place vacated.\n\n\n\n\\item \n\\texttt{\\seqsplit{Completed / Encoded}}: Clinical documentation finalized, ICD/\\allowbreak{}DRG coding completed, and encounter legally closed.\n\n\n\n\\end{itemize}\n\n\n\\item \n\\textbf{Scope qualification}: These completion criteria retain their locally described applicability; they do not establish universal signing, legal closure or originating authority over clinical information. Finalisation, signing and legal qualification remain distinct. The relationship with Strategy \\texttt{\\seqsplit{ON\\_LEAVE}}, including applicability and transitions, remains unresolved.\n\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-ADMINISTRATION-INFORMATION-ENABLEMENT.CT2-BEC-CARE-FULFILMENT-ADMINISTRATION-ENABLEMENT.CT3-BEC-EPISODE-ENCOUNTER-ADMINISTRATION.PR-ENCOUNTER-LIFECYCLE-PROCESS&quot;],&quot;key&quot;:&quot;process:encounter-lifecycle-process&quot;,&quot;latex_label&quot;:&quot;process:encounter-lifecycle-process&quot;,&quot;local_id&quot;:&quot;ENCOUNTER-LIFECYCLE-PROCESS&quot;,&quot;name&quot;:&quot;Encounter Lifecycle Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-episode-encounter-administration&quot;,&quot;owner_key&quot;:&quot;capability:episode--encounter-administration&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-encounter-lifecycle-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:episode--encounter-administration&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;34-encounter-lifecycle-process&quot;,&quot;line&quot;:119,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 3.4 Encounter Lifecycle Process&quot;},{&quot;anchor&quot;:&quot;34-encounter-lifecycle-process&quot;,&quot;line&quot;:120,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Episode &amp; Encounter Administration`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:service-administration&quot;]}"/>
