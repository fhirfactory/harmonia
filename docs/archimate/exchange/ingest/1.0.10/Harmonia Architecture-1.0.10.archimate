;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Proposed&quot;,&quot;overview&quot;:&quot;Mobile availability cannot be interpreted as a simple on-duty count because distance, assignments and suitable skills affect deliverability.&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-mobile-staff-management&quot;,&quot;owner_key&quot;:&quot;capability:mobile-staff-management&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_rationale&quot;:&quot;This behaviour changes or exposes the bounded concern of Mobile Staff Management, rather than inheriting an adjacent responsibility.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Inferred from capability-specific behaviour, v0.3 inspection and current architectural evidence&quot;,&quot;evidence&quot;:[{&quot;line&quot;:34,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/information-responsibility/information-responsibility.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;[Context-specific Capacity Management](../behaviours/04-health-service-operations.md#capacity-management-responsibility-boundary) establishes/manages capacity meaning for Clinic &amp; Practice Operations, Ward Operations, Theatre Operations, Emergency Department Operations, Outpatient Operations and Mobile Staff Management. Their local information responsibilities express available, committed and utilised capacity without prescribing a shared formal Information Object or identical model. Bed/care-place and equipment state contribute; they do not alone establish service capacity. Service Capacity Management consumes/coordinates those capacity states; Work Allocation &amp; Dispatch and Discharge Management may consume them without acquiring their ownership. Exact provider contracts remain unestablished.&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;reference_id&quot;:&quot;HCM-FT-mobile-service-capacity-management&quot;,&quot;sources&quot;:[],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;FT&quot;,&quot;type&quot;:&quot;feature&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[]},&quot;provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Inferred from capability-specific behaviour, v0.3 inspection and current architectural evidence&quot;,&quot;evidence&quot;:[{&quot;line&quot;:34,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/information-responsibility/information-responsibility.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;[Context-specific Capacity Management](../behaviours/04-health-service-operations.md#capacity-management-responsibility-boundary) establishes/manages capacity meaning for Clinic &amp; Practice Operations, Ward Operations, Theatre Operations, Emergency Department Operations, Outpatient Operations and Mobile Staff Management. Their local information responsibilities express available, committed and utilised capacity without prescribing a shared formal Information Object or identical model. Bed/care-place and equipment state contribute; they do not alone establish service capacity. Service Capacity Management consumes/coordinates those capacity states; Work Allocation &amp; Dispatch and Discharge Management may consume them without acquiring their ownership. Exact provider contracts remain unestablished.&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-FT-mobile-service-capacity-management&quot;,&quot;reviewed_resp