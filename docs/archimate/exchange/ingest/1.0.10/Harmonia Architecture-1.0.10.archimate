n&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-BEC-care-movement-transition-coordination&quot;,&quot;parent_key&quot;:&quot;proposal:bec-care-movement-transition-coordination&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The responsibility concerns coordinate movement of people/materials and operational departure readiness across care boundaries. It is the finest capability frame required for the established behaviour; the older contextual heading is not another capability tier.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;reference_id&quot;:&quot;HCM-BEC-clinical-logistics-coordination&quot;,&quot;relevance&quot;:&quot;Harmonia-Relevant&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-enabling-capabilities.md&quot;,&quot;docs/markdown/03-business-architecture/behaviours/04-health-service-operations.md&quot;],&quot;s