              <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;49-bed-turnover-process&quot;,&quot;line&quot;:203,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.9 Bed Turnover Process&quot;},{&quot;anchor&quot;:&quot;49-bed-turnover-process&quot;,&quot;line&quot;:204,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Bed &amp; Care-Place Management`&quot;}]"/>
              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;Bed turnover connects the release of a care place with the operational work needed to return it to use. Its progression preserves the difference between vacancy, cleaning and readiness. A place can be empty while work remains outstanding, and a completed turnover does not by itself prove that the service has capacity for the next patient.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:bed--care-place-management&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-BED-CARE-PLACE-MANAGEMENT.PR-BED-TURNOVER-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Bed Turnover Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Bed \\&amp; Care-Place Management}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the rapid physical turnover, cleaning, sanitisation, and re-allocation of inpatient and emergency care-places.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Bed Vacated → Cleaning Dispatched → Sanitisation In-Progress → Terminal Cleaning Verified → Bed Ready /\\allowbreak{} Available → Bed Allocated /\\allowbreak{} Occupied\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Bed Vacated}}: Prior patient discharged or transferred.\n\n\n\n\\item \n\\texttt{\\seqsplit{Cleaning Dispatched}}: Cleaning job allocated to environmental services team.\n\n\n\n\\item \n\\texttt{\\seqsplit{Sanitisation In-Progress}}: Ward cleaning or isolation decontamination underway.\n\n\n\n\\item \n\\texttt{\\seqsplit{Terminal Cleaning Verified}}: Ward coordinator or supervisor verifies care-place readiness.\n\n\n\n\\item \n\\texttt{\\seqsplit{Bed Ready / Available}}: Bed marked available for incoming patient allocation.\n\n\n\n\\item \n\\texttt{\\seqsplit{Bed Allocated / Occupied}}: Incoming patient allocated and physically placed in bed.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-RESOURCE-CAPACITY-COORDINATION.CT3-BEC-BED-CARE-PLACE-MANAGEMENT.PR-BED-TURNOVER-PROCESS&quot;],&quot;key&quot;:&quot;process:bed-turnover-process&quot;,&quot;latex_label&quot;:&quot;process:bed-turnover-process&quot;,&quot;local_id&quot;:&quot;BED-TURNOVER-PROCESS&quot;,&quot;name&quot;:&quot;Bed Turnover Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-bed-care-place-management&quot;,&quot;owner_key&quot;:&quot;capability:bed--care-place-management&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-bed-turnover-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:bed--care-place-management&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;49-bed-turnover-process&quot;,&quot;line&quot;:203,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.9 Bed Turnover Process&quot;},{&quot;anchor&quot;:&quot;49-bed-turnover-process&quot;,&quot;line&quot;:204,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Bed &amp; Care-Place Management`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:health-service-operations&quot;]}"/>
              <property key="v0.2 / Unresolved Dimensions" value="[&quot;feature_association&quot;]"/>
              <property key="v0.2 / Source Owner Reference" value="HCM-BEC-bed-care-place-management"/>
