              <folder name="[Feature] Practitioner Profile Governance" id="id-814501d6bcf84eaca5076bb367a48905">
                <element xsi:type="archimate:Capability" name="Practitioner Profile Governance" id="id-99fd4d1c8c21544cadf1ae4735acd6ca">
                  <documentation>Maintain core professional demographic details, qualifications, and active practice status.

