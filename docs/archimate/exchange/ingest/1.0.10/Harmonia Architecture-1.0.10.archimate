        <property key="Baseline / Architecture Identity Status" value="Unresolved — representation ID only"/>
        <property key="Baseline / Source Projection Key" value="driver:5"/>
        <property key="Baseline / Review State" value="Retained baseline standing"/>
        <property key="canonicalId" value="1dbf34b452b6497f914c704e037aec24"/>
        <property key="displayName" value="Statutory Health Information Privacy &amp; Protection"/>
        <property key="friendlyName" value="StatutoryHealthInformationPrivacyAndProtection"/>
