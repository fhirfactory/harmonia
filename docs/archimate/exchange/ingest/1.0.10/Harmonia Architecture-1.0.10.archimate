                  <property key="v0.2 / Architecture Identity Status" value="Unresolved — representation ID only"/>
                  <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;410-operational-work-progression-process&quot;,&quot;line&quot;:218,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.10 Operational Work Progression Process&quot;},{&quot;anchor&quot;:&quot;410-operational-work-progression-process&quot;,&quot;line&quot;:219,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Work Allocation &amp; Dispatch`&quot;}]"/>
                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;Operational work progression makes the path from a recognised support requirement to assigned and reported work explicit. Acknowledgement and activity progress help distinguish a dispatch from actual performance and expose impediments requiring operational attention. This responsibility remains bounded to authorised support work rather than ownership of the clinician's worklist.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:work-allocation--dispatch&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-WORK-ALLOCATION-DISPATCH.PR-OPERATIONAL-WORK-PROGRESSION-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Operational Work Progression Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Work Allocation \\&amp; Dispatch}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the dispatch, assignment, execution, and completion of facility operational jobs (e.g., equipment moves, waste removal, linen supply).\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Work Requested → Queued in Dispatch → Assigned to Worker → Job Accepted → Work In-Progress → Work Completed /\\allowbreak{} Aborted\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Work Requested}}: Facility support task submitted by clinical unit.\n\n\n\n\\item \n\\texttt{\\seqsplit{Queued in Dispatch}}: Job prioritized in operational queue.\n\n\n\n\\item \n\\texttt{\\seqsplit{Assigned to Worker}}: Job allocated to specific staff member or team.\n\n\n\n\\item \n\\texttt{\\seqsplit{Job Accepted}}: Worker acknowledges dispatch on mobile device.\n\n\n\n\\item \n\\texttt{\\seqsplit{Work In-Progress}}: Task actively being executed.\n\n\n\n\\item \n\\texttt{\\seqsplit{Work Completed / Aborted}}: Job marked finished or formally cancelled with reason.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-OPERATIONAL-WORKFORCE-COORDINATION.CT3-BEC-WORK-ALLOCATION-DISPATCH.PR-OPERATIONAL-WORK-PROGRESSION-PROCESS&quot;],&quot;key&quot;:&quot;process:operational-work-progression-process&quot;,&quot;latex_label&quot;:&quot;process:operational-work-progression-process&quot;,&quot;local_id&quot;:&quot;OPERATIONAL-WORK-PROGRESSION-PROCESS&quot;,&quot;name&quot;:&quot;Operational Work Progression Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-work-allocation-dispatch&quot;,&quot;owner_key&quot;:&quot;capability:work-allocation--dispatch&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-operational-work-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:work-allocation--dispatch&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;410-operational-work-progression-process&quot;,&quot;line&quot;:218,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.10 Operational Work Progression Process&quot;},{&quot;anchor&quot;:&quot;410-operational-work-progression-process&quot;,&quot;line&quot;:219,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Work Allocation &amp; Dispatch`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:health-service-operations&quot;]}"/>
                  <property key="v0.2 / Unresolved Dimensions" value="[&quot;feature_association&quot;]"/>
