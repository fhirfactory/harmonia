              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Coverage is broader than rostering. Applying an available resource to a care requirement and progressing a particular support work item remain separate operational responsibilities.&quot;,&quot;Capability Overview&quot;:&quot;Health Workforce Management governs practitioners' professional standing, authorised participation and the ability to cover required enterprise work. Its three children separate qualification from engagement and privilege, and both from whole-enterprise coverage. This prevents an available or rostered person from being treated as automatically qualified and privileged for a particular activity.&quot;,&quot;Intent&quot;:&quot;Support legitimate practitioner participation and an informed understanding of service-coverage gaps and risks.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-WORKFORCE-ORGANISATIONAL-CAPABILITY.CT2-HEALTH-WORKFORCE-MANAGEMENT&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:workforce--organisational-capability&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-WORKFORCE-ORGANISATIONAL-CAPABILITY.CT2-HEALTH-WORKFORCE-MANAGEMENT&quot;,&quot;canonical_name&quot;:&quot;Health Workforce Management&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nGovern practitioners’ professional standing, engagement/\\allowbreak{}privilege and whole-enterprise service coverage.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:health-workforce-management&quot;,&quot;latex_label&quot;:&quot;cap:bc-health-workforce-management&quot;,&quot;local_id&quot;:&quot;HEALTH-WORKFO