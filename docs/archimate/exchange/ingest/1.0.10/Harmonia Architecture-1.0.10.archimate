              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Deployment consumes roster, qualification and privilege context without changing their authoritative records. Operational capacity differs from strategic capacity planning and from the unresolved collective service-readiness concern.&quot;,&quot;Capability Overview&quot;:&quot;This capability connects care demand with scheduled opportunities, suitable care places and legitimately usable operational resources. Its children distinguish a booking, a place allocation, the readiness of that place, resource deployment, flow coordination and service-level usable capacity. An empty bed or an available practitioner is relevant evidence, but neither alone establishes that the service can accommodate care.&quot;,&quot;Intent&quot;:&quot;Support care requirements with an operationally credible combination of time, place, resources and capacity.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-CARE-ACCESS-COORDINATION.CT2-CARE-SCHEDULING-CAPACITY-MANAGEMENT&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:care-access--coordination&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-CARE-ACCESS-COORDINATION.CT2-CARE-SCHEDULING-CAPACITY-MANAGEMENT&quot;,&quot;canonical_name&quot;:&quot;Care Scheduling &amp; Capacity Management&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nManage scheduled opportunities, care places, usable operational capacity and care-demand resourcing.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:care-scheduling--capacity-management&quot;,&quot;latex_label&quot;:&quot;cap:bc-care-sch