              <folder name="Processes" id="id-688c2e0f292248a1a353accbc9cfa7e9">
                <element xsi:type="archimate:BusinessProcess" name="Governed Person Identity Correction Process" id="id-46e16f772bab5982ae8fae3daa900739">
                  <documentation>•
Owning Capability: Person Identity (under Client Administration)

•
Process Purpose: Processes externally authoritative identity corrections and merge/unlink outcomes, applies their consequences to Harmonia-managed identity information and identifier associations, and communicates resulting changes with an audit history.

•
Authority boundary: Person correction/merge decisions originate externally. Internal triage, evidence verification and approval concern applicability and governed processing of that authoritative outcome, not person matching, golden-record determination, master-person selection or originating merge adjudication.

•
State Progression Lifecycle: Correction Requested → HIM Triage → Evidence Verified → Correction Approved → Merge/Unlink Executed → Change Broadcasted → Closed

•
Key State Dispositions:

•
Correction Requested: Externally authoritative correction or merge/unlink outcome received for governed application.

•
HIM Triage: Health Information Manager reviews the received decision/outcome and its applicability.

•
Evidence Verified: Authoritative source decision and supporting provenance/documentation verified.

•
Correction Approved: Governed application of the externally authoritative outcome approved; this does not originate a person-merge decision.

•
Merge/Unlink Executed: External merge/unlink consequences applied to Harmonia's managed identifier associations and audit history.

•
Change Broadcasted: Downstream clinical systems notified of merged or rectified identity.

This Process governs the application of an externally authoritative correction rather than originating a person-merge judgement. Triage, evidence verification and approval establish that the received outcome should be applied to Harmonia's associations. The progression and change communication preserve why the managed identity account changed without making internal approval a master-person decision.</documentation>
                  <property key="v0.2 / Source Capture Key" value="process:governed-person-identity-correction-process"/>
                  <property key="v0.2 / Snapshot Reference ID" value="HCM-PR-governed-person-identity-correction-process"/>
                  <property key="v0.2 / LaTeX Label" value="process:governed-person-identity-correction-process"/>
                  <property key="v0.2 / Construct Type" value="process"/>
                  <property key="v0.2 / Architectural Status" value="Canonical"/>
                  <property key="v0.2 / Record State" value="current"/>
                  <property key="v0.2 / Placement Status" value="Established"/>
                  <property key="v0.2 / Structural ID Status" value="Proposed"/>
                  <property key="v0.2 / Structural Canonical ID" value="CT1-BEC-HEALTHCARE-ENTITY-INFORMATION-ENABLEMENT.CT2-BEC-CLIENT-ADMINISTRATION.CT3-BEC-PERSON-IDENTITY.PR-GOVERNED-PERSON-IDENTITY-CORRECTION-PROCESS"/>
                  <property key="v0.2 / Name Status" value="Canonical"/>
                  <property key="v0.2 / Canonical Name" value="Governed Person Identity Correction Process"/>
                  <property key="v0.2 / Architecture Identity Status" value="Unresolved — representation ID only"/>
                  <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;21-governed-person-identity-correction-process&quot;,&quot;line&quot;:69,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 2.1 Governed Person Identity Correction Process&quot;},{&quot;anchor&quot;:&quot;21-governed-person-identity-correction-process&quot;,&quot;line&quot;:70,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Person Identity` (under `Client Administration`)&quot;}]"/>
                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;This Process governs the application of an externally authoritative correction rather than originating a person-merge judgement. Triage, evidence verification and approval establish that the received outcome should be applied to Harmonia's associations. The progression and change communication preserve why the managed identity account changed without making internal approval a master-person decision.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:person-identity&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-HEALTHCARE-ENTITY-INFORMATION-ENABLEMENT.CT2-BEC-CLIENT-ADMINISTRATION.CT3-BEC-PERSON-IDENTITY.PR-GOVERNED-PERSON-IDENTITY-CORRECTION-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Governed Person Identity Correction Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Person Identity}} (under \\texttt{\\seqsplit{Client Administration}})\n\n\n\n\\item \n\\textbf{Process Purpose}: Processes externally authoritative identity corrections and merge/\\allowbreak{}unlink outcomes, applies their consequences to Harmonia-managed identity information and identifier associations, and communicates resulting changes with an audit history.\n\n\n\n\\item \n\\textbf{Authority boundary}: Person correction/\\allowbreak{}merge decisions originate externally. Internal triage, evidence verification and approval concern applicability and governed processing of that authoritative outcome, not person matching, golden-record determination, master-person selection or originating merge adjudication.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Correction Requested → HIM Triage → Evidence Verified → Correction Approved → Merge/\\allowbreak{}Unlink Executed → Change Broadcasted → Closed\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Correction Requested}}: Externally authoritative correction or merge/\\allowbreak{}unlink outcome received for governed application.\n\n\n\n\\item \n\\texttt{\\seqsplit{HIM Triage}}: Health Information Manager reviews the received decision/\\allowbreak{}outcome and its applicability.\n\n\n\n\\item \n\\texttt{\\seqsplit{Evidence Verified}}: Authoritative source decision and supporting provenance/\\allowbreak{}documentation verified.\n\n\n\n\\item \n\\texttt{\\seqsplit{Correction Approved}}: Governed application of the externally authoritative outcome approved; this does not originate a person-merge decision.\n\n\n\n\\item \n\\texttt{\\seqsplit{Merge/Unlink Executed}}: External merge/\\allowbreak{}unlink consequences applied to Harmonia's managed identifier associations and audit history.\n\n\n\n\\item \n\\texttt{\\seqsplit{Change Broadcasted}}: Downstream clinical systems notified of merged or rectified identity.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;process:governed-person-identity-correction-process&quot;,&quot;latex_label&quot;:&quot;process:governed-person-identity-correction-process&quot;,&quot;local_id&quot;:&quot;GOVERNED-PERSON-IDENTITY-CORRECTION-PROCESS&quot;,&quot;name&quot;:&quot;Governed Person Identity Correction Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-person-identity&quot;,&quot;owner_key&quot;:&quot;capability:person-identity&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-governed-person-identity-correction-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:person-identity&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;21-governed-person-identity-correction-process&quot;,&quot;line&quot;:69,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 2.1 Governed Person Identity Correction Process&quot;},{&quot;anchor&quot;:&quot;21-governed-person-identity-correction-process&quot;,&quot;line&quot;:70,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Person Identity` (under `Client Administration`)&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:entity-management&quot;]}"/>
                  <property key="v0.2 / Unresolved Dimensions" value="[&quot;feature_association&quot;]"/>
                  <property key="v0.2 / Source Owner Reference" value="HCM-BEC-person-identity"/>
                  <property key="v0.2 / Deferred Relationship Assertions" value="[{&quot;disposition&quot;:&quot;metadata_and_finding&quot;,&quot;reason&quot;:&quot;Process responsibility/governance is not automatically Assignment or Composition.&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;snapshot_pointer&quot;:&quot;/relationships/278&quot;,&quot;source_assertion&quot;:{&quot;from&quot;:&quot;function:apply-governed-person-identity-correction&quot;,&quot;sources&quot;:[{&quot;anchor&quot;:&quot;21-person-identity&quot;,&quot;line&quot;:35,&quot;source&quot;:&quot;em&quot;,&quot;text&quot;:&quot; - *Governed Process*: **Governed Person Identity Correction Process**.&quot;}],&quot;status&quot;:&quot;established&quot;,&quot;to&quot;:&quot;process:governed-person-identity-correction-process&quot;,&quot;type&quot;:&quot;governed_process&quot;},&quot;source_index&quot;:278}]"/>
                  <property key="Baseline / Textual Baseline Reference" value="docs/markdown/governance/baseline/processes.md#hcm-pr-governed-person-identity-correction-process"/>
