            <property key="v0.2 / Source SHA256" value="fe714504735eccf4a2922681e1d142d3aa5a5767996a94a5a46bee8ec8ec795c"/>
          </element>
          <element xsi:type="archimate:ArchimateDiagramModel" name="Source evidence — rad-business" id="id-661aaecfa2fe5dc8a61f4aef64d3f23f">
            <child xsi:type="archimate:Note" id="id-c3a101ca07bd5085b60ca7b0f6a69290" font="1|Sans|12.0|0|GTK|1|" fontColor="#000000" lineColor="#5c5c5c" textAlignment="1" fillColor="#ebf2f8">
