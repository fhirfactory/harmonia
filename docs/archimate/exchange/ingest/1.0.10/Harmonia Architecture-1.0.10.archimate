                <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;412-specimen-transport-process&quot;,&quot;line&quot;:248,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.12 Specimen Transport Process&quot;},{&quot;anchor&quot;:&quot;412-specimen-transport-process&quot;,&quot;line&quot;:249,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Clinical Logistics Coordination`&quot;}]"/>
                <property key="v0.2 / Snapshot Record JSON" value="{&quot;adjudication_note&quot;:&quot;HUMAN ADJUDICATION REQUIRED: The Canonical Process includes blood products as well as bio-specimens and surgical biopsies. Whether the blood-product wording denotes diagnostic specimens or transported health materiel is unadjudicated; the original Process is preserved without narrowing it.&quot;,&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;Specimen transport preserves the movement and custody account connecting collection context with laboratory receipt. It makes the journey of the material explainable rather than reducing it to a sent/received pair. Delivery remains distinct from specimen acceptance, diagnostic performance and the eventual professional interpretation of its evidence.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:clinical-logistics-coordination&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CLINICAL-LOGISTICS-COORDINATION.PR-SPECIMEN-TRANSPORT-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Specimen Transport Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Clinical Logistics Coordination}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the physical courier chain-of-custody, transport, and delivery of pathology bio-specimens, blood products, and surgical biopsies.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Specimen Packaged → Courier Dispatched → Chain-of-Custody Signed → In-Transit (Monitored) → Lab Ingress Received → Specimen Accepted\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Specimen Packaged}}: Clinical unit packages bio-sample with barcode manifest.\n\n\n\n\\item \n\\texttt{\\seqsplit{Courier Dispatched}}: Courier route assigned for pickup.\n\n\n\n\\item \n\\texttt{\\seqsplit{Chain-of-Custody Signed}}: Courier scans barcode and accepts legal custody.\n\n\n\n\\item \n\\texttt{\\seqsplit{In-Transit (Monitored)}}: Specimen in transit under temperature/\\allowbreak{}time constraints.\n\n\n\n\\item \n\\texttt{\\seqsplit{Lab Ingress Received}}: Central pathology specimen reception logs physical receipt.\n\n\n\n\\item \n\\texttt{\\seqsplit{Specimen Accepted}}: Specimen integrity verified and passed to analytical track.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-MOVEMENT-TRANSITION-COORDINATION.CT3-BEC-CLINICAL-LOGISTICS-COORDINATION.PR-SPECIMEN-TRANSPORT-PROCESS&quot;],&quot;key&quot;:&quot;process:specimen-transport-process&quot;,&quot;latex_label&quot;:&quot;process:specimen-transport-process&quot;,&quot;local_id&quot;:&quot;SPECIMEN-TRANSPORT-PROCESS&quot;,&quot;name&quot;:&quot;Specimen Transport Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-clinical-logistics-coordination&quot;,&quot;owner_key&quot;:&quot;capability:clinical-logistics-coordination&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;pre_review_record&quot;:{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;Specimen transport preserves the movement and custody account connecting collection context with laboratory receipt. It makes the journey of the material explainable rather than reducing it to a sent/received pair. Delivery remains distinct from specimen acceptance, diagnostic performance and the eventual professional interpretation of its evidence.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:clinical-logistics-coordination&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-MOVEMENT-TRANSITION-COORDINATION.CT3-BEC-CLINICAL-LOGISTICS-COORDINATION.PR-SPECIMEN-TRANSPORT-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Specimen Transport Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Clinical Logistics Coordination}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the physical courier chain-of-custody, transport, and delivery of pathology bio-specimens, blood products, and surgical biopsies.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Specimen Packaged → Courier Dispatched → Chain-of-Custody Signed → In-Transit (Monitored) → Lab Ingress Received → Specimen Accepted\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Specimen Packaged}}: Clinical unit packages bio-sample with barcode manifest.\n\n\n\n\\item \n\\texttt{\\seqsplit{Courier Dispatched}}: Courier route assigned for pickup.\n\n\n\n\\item \n\\texttt{\\seqsplit{Chain-of-Custody Signed}}: Courier scans barcode and accepts legal custody.\n\n\n\n\\item \n\\texttt{\\seqsplit{In-Transit (Monitored)}}: Specimen in transit under temperature/\\allowbreak{}time constraints.\n\n\n\n\\item \n\\texttt{\\seqsplit{Lab Ingress Received}}: Central pathology specimen reception logs physical receipt.\n\n\n\n\\item \n\\texttt{\\seqsplit{Specimen Accepted}}: Specimen integrity verified and passed to analytical track.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;process:specimen-transport-process&quot;,&quot;latex_label&quot;:&quot;process:specimen-transport-process&quot;,&quot;local_id&quot;:&quot;SPECIMEN-TRANSPORT-PROCESS&quot;,&quot;name&quot;:&quot;Specimen Transport Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-clinical-logistics-coordination&quot;,&quot;owner_key&quot;:&quot;capability:clinical-logistics-coordination&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;reference_id&quot;:&quot;HCM-PR-specimen-transport-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:clinical-logistics-coordination&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;412-specimen-transport-process&quot;,&quot;line&quot;:248,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.12 Specimen Transport Process&quot;},{&quot;anchor&quot;:&quot;412-specimen-transport-process&quot;,&quot;line&quot;:249,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Clinical Logistics Coordination`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:health-service-operations&quot;]},&quot;record_state&quot;:&quot;pending_adjudication&quot;,&quot;reference_id&quot;:&quot;HCM-PR-specimen-transport-process&quot;,&quot;responsi