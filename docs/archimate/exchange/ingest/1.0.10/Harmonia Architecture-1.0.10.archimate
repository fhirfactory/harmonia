              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Egress ends Harmonia management of the emitted representation. Retained delivery evidence does not extend control over an external recipient or transfer payload authority.&quot;,&quot;Capability Overview&quot;:&quot;Interoperability &amp; Exchange moves information across participating boundaries through destination resolution, transformation, delivery and acknowledgements. It preserves the difference between technical transmission and the recipient's business response so that an exchange can be understood under its actual contract. Standards govern the external representation while internal management semantics remain private.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;EC-08&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-EC-COORDINATED-ACTIVITY-INTERACTION.CT2-EC-08&quot;,&quot;canonical_name&quot;:&quot;Interoperability &amp; Exchange&quot;,&quot;category&quot;:&quot;enterprise&quot;,&quot;confidence&quot;:&quot;High&quot;,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Architectural Scope}: Resolve destinations, transform schemas, route, transport, deliver, acknowledge, and coordinate standards-based information exchange across enterprise boundaries.\n\n\n\n\\item \n\\textbf{Functional Responsibilities}:\n\n\n\\begin{itemize}\n\n\\item \nProviding multi-protocol boundary adaptation for healthcare standards (HL7 v2, FHIR REST, DICOM, secure messaging).\n\n\n\n\\item \nExecuting bidirectional structural and semantic transformations between legacy formats and canonical representations.\n\n\n\n\\item \nEnsuring reliable addressed delivery and fan-out distribution to external clinical endpoints.\n\n\n\n\\item \nProcessing and distinguishing technical delivery acknowledgements from business acknowledgements.\n\n\n\n\\end{itemize}\n\n\n\\item \n\\textbf{Boundary Rule}: Egress terminates Harmonia management of the emitted representation (Axiom AX-13).\n\n\n\n\\end{itemize}\n&quot;,&quot;id_aliases&quot;:[&quot;EC-08&quot;],&quot;key&quot;:&quot;enterprise:ec-08&quot;,&quot;latex_label&quot;:&quot;cap:ec-08&quot;,&quot;local_id&quot;:&quot;EC-08&quot;,&quot;name&quot;:&quot;Interoperability &amp; Exchange&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-EC-coordinated-activity-interaction&quot;,&quot;parent_key&quot;:&quot;proposal:ec-coordinated-activity-interaction&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The established reusable responsibility is a constituent ability of Coordinated Activity &amp; Interaction; its canonical scope and exclusions remain unchanged.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;EC-08&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/enterprise-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;ec-08-interoperability-exchange&quot;,&quot;line&quot;:166,&quot;source&quot;:&quot;enterprise&quot;,&quot;text&quot;:&quot;### EC-08: Interoperability &amp; Exchange&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT2&quot;,&quot;type&quot;:&quot;enterprise_capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[]}"/>
              <property key="v0.2 / Source Parent Reference" value="HCM-EC-coordinated-activity-interaction"/>
