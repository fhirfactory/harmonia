              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Compartment assurance does not decide access. Subject-specific protection assurance does not create additional macro-level Health Service Assurance trees.&quot;,&quot;Capability Overview&quot;:&quot;Health Information Protection governs the consequences of information exposure and the safeguards protecting information and its operating environment. Privacy safeguards, estate protection, access-practice monitoring, compartment assurance and classification assurance address different questions. Together they distinguish appropriate arrangements from evidence of how information is actually handled, including physical and printed handling.&quot;,&quot;Intent&quot;:&quot;Protect information and the people affected by its use, with an intelligible basis for evaluating protective arrangements.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-HEALTH-INFORMATION-PROTECTION&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:security-privacy--digital-trust&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-HEALTH-INFORMATION-PROTECTION&quot;,&quot;canonical_name&quot;:&quot;Health Information Protection&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nGovern privacy consequences and adequate protection of the information estate and its environment.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:health-information-protection&quot;,&quot;latex_label&quot;:&quot;cap:bc-health-information-protection&quot;,&quot;local_id&quot;:&quot;HEALTH-