              <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;47-theatre-case-progression-process&quot;,&quot;line&quot;:170,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.7 Theatre Case Progression Process&quot;},{&quot;anchor&quot;:&quot;47-theatre-case-progression-process&quot;,&quot;line&quot;:171,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Theatre Operations`&quot;}]"/>
              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;Theatre case progression follows reported milestones of the surgical encounter so that supporting participants can coordinate around the actual situation. The state account concerns what the clinical service reports has occurred. It does not make the integration mechanism the actor administering anaesthesia, performing surgery or managing clinical handover.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:theatre-operations&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-THEATRE-OPERATIONS.PR-THEATRE-CASE-PROGRESSION-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Theatre Case Progression Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Theatre Operations}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the perioperative operational milestones of a surgical procedure within the operating theatre suite.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Case Called → In Anaesthetic Bay → Anaesthesia Commenced → Patient in Theatre → Knife-to-Skin → Procedure Finished → In PACU Recovery → Ward Handover Complete\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Case Called}}: Theatre team requests ward to send patient for surgery.\n\n\n\n\\item \n\\texttt{\\seqsplit{In Anaesthetic Bay}}: Patient arrives in theatre holding and identity/\\allowbreak{}consent verified.\n\n\n\n\\item \n\\texttt{\\seqsplit{Anaesthesia Commenced}}: Anaesthetic induction underway.\n\n\n\n\\item \n\\texttt{\\seqsplit{Patient in Theatre}}: Patient transferred onto operating table.\n\n\n\n\\item \n\\texttt{\\seqsplit{Knife-to-Skin}}: Surgical incision initiated (operative start).\n\n\n\n\\item \n\\texttt{\\seqsplit{Procedure Finished}}: Wound closure completed and dressings applied.\n\n\n\n\\item \n\\texttt{\\seqsplit{In PACU Recovery}}: Patient monitored in post-anaesthesia care unit.\n\n\n\n\\item \n\\texttt{\\seqsplit{Ward Handover Complete}}: Post-operative clinical handover to inpatient ward completed.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-SETTING-OPERATIONS-ENABLEMENT.CT3-BEC-THEATRE-OPERATIONS.PR-THEATRE-CASE-PROGRESSION-PROCESS&quot;],&quot;key&quot;:&quot;process:theatre-case-progression-process&quot;,&quot;latex_label&quot;:&quot;process:theatre-case-progression-process&quot;,&quot;local_id&quot;:&quot;THEATRE-CASE-PROGRESSION-PROCESS&quot;,&quot;name&quot;:&quot;Theatre Case Progression Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-theatre-operations&quot;,&quot;owner_key&quot;:&quot;capability:theatre-operations&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-theatre-case-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:theatre-operations&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;47-theatre-case-progression-process&quot;,&quot;line&quot;:170,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.7 Theatre Case Progression Process&quot;},{&quot;anchor&quot;:&quot;47-theatre-case-progression-process&quot;,&quot;line&quot;:171,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Theatre Operations`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:health-service-operations&quot;]}"/>
              <property key="v0.2 / Unresolved Dimensions" value="[&quot;feature_association&quot;]"/>
              <property key="v0.2 / Source Owner Reference" value="HCM-BEC-theatre-operations"/>
              <property key="v0.2 / Deferred Relationship Assertions" value="[{&quot;disposition&quot;:&quot;metadata_and_finding&quot;,&quot;reason&quot;:&quot;Process responsibility/governance is not automatically Assignment or Composition.&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;snapshot_pointer&quot;:&quot;/relationships/285&quot;,&quot;source_assertion&quot;:{&quot;from&quot;:&quot;function:manage-theatre-case-progression&quot;,&quot;sources&quot;:[{&quot;anchor&quot;:&quot;23-theatre-operations&quot;,&quot;line&quot;:115,&quot;source&quot;:&quot;hso&quot;,&quot;text&quot;:&quot; - *Governed Process*: **Theatre Case Progression Process**.&quot;}],&quot;status&quot;:&quot;established&quot;,&quot;to&quot;:&quot;process:theatre-case-progression-process&quot;,&quot;type&quot;:&quot;governed_process&quot;},&quot;source_index&quot;:285}]"/>
