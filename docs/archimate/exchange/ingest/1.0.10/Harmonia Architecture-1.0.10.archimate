&quot;HCM-BEC-workflow-activity-coordination&quot;,&quot;owner_key&quot;:&quot;capability:workflow--activity-coordination&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;pre_review_record&quot;:{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;Synthetic Task progression concerns automated non-human execution, including waiting for a dependency and producing an output. It must remain distinct from human work orders and external clinical task lists. The disconnected stalled/failed outcome in the illustration leaves its relation to the success path unresolved; no reopening or post-completion failure transition is inferred.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:workflow--activity-coordination&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-HUMAN-COLLABORATION-WORK-ENABLEMENT.CT2-BEC-OPERATIONAL-ACTIVITY-TEMPORAL-ENABLEMENT.CT3-BEC-WORKFLOW-ACTIVITY-COORDINATION.PR-SYNTHETIC-TASK-PROGRESSION-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Synthetic Task Progression Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Workflow \\&amp; Activity Coordination}}\n\n\n\n\\item \n\\textbf{Activity Archetype}: \\textbf{Non-Human Executable Work} — automated system workflows, batch syndications, or policy evaluation tasks.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}:\n\n\n\n\\end{itemize}\n\n\\textit{RAD diagram: textual source notation.}\n\\begin{Verbatim}[breaklines,fontsize=\\footnotesize]\ngraph LR\n D[\&quot;Draft / Scheduled\&quot;] --> E[\&quot;Executing\&quot;]\n E --> W[\&quot;Awaiting-Dependency\&quot;]\n W --> C[\&quot;Completed\&quot;]\n F[\&quot;Progression Stalled / Failed&lt;br/>Outcome/position unresolved\&quot;]\n NOTE[\&quot;Illustrative progression, not a normative transition model.&lt;br/>No Completed-to-Stalled/Failed transition is established.\&quot;]\n classDef note fill:#fff8dc,stroke:#8a6d3b,stroke-dasharray:5 5;\n class NOTE,F note;\n\\end{Verbatim}\n\n\\begin{itemize}\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Draft / Scheduled}}: Automated task instantiated and scheduled for processing.\n\n\n\n\\item \n\\texttt{\\seqsplit{Executing}}: System actively processing task.\n\n\n\n\\item \n\\texttt{\\seqsplit{Awaiting-Dependency}}: Paused awaiting asynchronous external reply or event.\n\n\n\n\\item \n\\texttt{\\seqsplit{Completed}}: Automated execution succeeded and output artifact produced.\n\n\n\n\\item \n\\texttt{\\seqsplit{Progression Stalled / Failed}}: Transient fault triggers scheduled recovery attempt; permanent failure records failure evidence.\n\n\n\n\\end{itemize}\n\n\n\\item \n\\textbf{Preserved uncertainty}: Whether stalled/\\allowbreak{}failed is an alternative outcome, reopening/\\allowbreak{}post-completion behaviour or a presentation defect remains unresolved. Its disconnected diagram node does not make success and failure equivalent or establish post-completion transitions.\n\n\n\n\\end{itemize}\n\n\\par\\smallskip\n\n\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;process:synthetic-task-progression-process&quot;,&quot;latex_label&quot;:&quot;process:synthetic-task-progression-process&quot;,&quot;local_id&quot;:&quot;SYNTHETIC-TASK-PROGRESSION-PROCESS&quot;,&quot;name&quot;:&quot;Synthetic Task Progression Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-workflow-activity-coordination&quot;,&quot;owner_key&quot;:&quot;capability:workflow--activity-coordination&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;reference_id&quot;:&quot;HCM-PR-synthetic-task-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:workflow--activity-coordination&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;516-synthetic-task-progression-process&quot;,&quot;line&quot;:322,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 5.16 Synthetic Task Progression Process&quot;},{&quot;anchor&quot;:&quot;516-synthetic-task-progression-process&quot;,&quot;line&quot;:323,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Workflow &amp; Activity Coordination`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:intrinsic--shared-enablement&quot;]},&quot;record_state&quot;:&quot;pending_adjudication&quot;,&quot;reference_id&quot;:&quot;HCM-PR-synthetic-task-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:workflow--activity-coordination&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;516-synthetic-task-progression-process&quot;,&quot;line&quot;:322,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 5.16 Synthetic Task Progression Process&quot;},{&quot;anchor&quot;:&quot;516-synthetic-task-progression-process&quot;,&quot;line&quot;:323,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Workflow &amp; Activity Coordination`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:intrinsic--shared-enablement&quot;]}"/>
