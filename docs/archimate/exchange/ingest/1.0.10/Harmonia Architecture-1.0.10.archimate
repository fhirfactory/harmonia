              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Federation or Single Sign-On does not guarantee identity quality. Enforcement spans physical, procedural and digital controls; it is broader than a runtime policy engine.&quot;,&quot;Capability Overview&quot;:&quot;This capability governs who may act and how controlled concerns are identified and protected across the organisation. Its children separate confidence in a claimed identity, identity models, contextual identity quality, authentication, access-control context, assurance, collaboration and enforcement. That separation prevents successful authentication from being treated as sufficient authority for every use.&quot;,&quot;Intent&quot;:&quot;Make identity confidence and control requirements appropriate to the circumstances in which access or activity occurs.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-DIGITAL-IDENTITY-ACCESS-GOVERNANCE&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:security-privacy--digital-trust&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-DIGITAL-IDENTITY-ACCESS-GOVERNANCE&quot;,&quot;canonical_name&quot;:&quot;Digital Identity &amp; Access Governance&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nGovern sufficient identity confidence and coherent access controls across the organisation.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:digital-identity--access-governance&quot;,&quot;latex_label&quot;:&quot;cap:bc-digital-identity-access-governance&quot;,&quot;local_id&quot;:&quot;DIGI