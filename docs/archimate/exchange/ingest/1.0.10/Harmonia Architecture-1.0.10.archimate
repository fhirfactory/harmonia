        <property key="displayName" value="AX-16 Operational Activity &amp; Entity State Progress Together"/>
        <property key="friendlyName" value="OperationalActivityAndEntityStateProgressTogether"/>
        <property key="canonicalName" value="MOT-OperationalActivityAndEntityStateProgressTogether"/>
