              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Relationship integrity is not a physical database design. Correlating entities does not establish originating clinical identity authority or a new standalone Correlation capability.&quot;,&quot;Capability Overview&quot;:&quot;This reusable capability keeps managed healthcare entities identifiable and their relationships structurally intelligible. It supplies common identity, alias and relationship behaviour recurring in persons, practitioners, organisations, locations and devices. Reuse concerns those architectural responsibilities, allowing the healthcare-specific meaning of each entity to remain with its governing context.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;EC-01&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-EC-GOVERNED-INFORMATION-OPERATIONS.CT2-EC-01&quot;,&quot;canonical_name&quot;:&quot;Managed Entity &amp; Relationship&quot;,&quot;category&quot;:&quot;enterprise&quot;,&quot;confidence&quot;:&quot;High&quot;,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Architectural Scope}: Identify, classify, relate, and maintain the structural integrity of managed healthcare and administrative entities throughout the enterprise landscape.\n\n\n\n\\item \n\\textbf{Functional Responsibilities}:\n\n\n\\begin{itemize}\n\n\\item \nUniquely identifying core domain entities (Persons, Practitioners, Roles, Organisations, Locations, Services, Devices).\n\n\n\n\\item \nResolving and maintaining multi-authority identifier systems and aliases without destructive overwriting.\n\n\n\n\\item \nRepresenting and traversing multi-dimensional relationships (affiliations, organizational hierarchies, physical location trees, care team memberships).\n\n\n\n\\item \nMaintaining referential integrity across interconnected entity graphs.\n\n\n\n\\end{itemize}\n\n\n\\item \n\\textbf{Anti-Responsibilities}: Does not own physical database relational tables or foreign key constraints (Domain 04/\\allowbreak{}07).\n\n\n\n\\end{itemize}\n&quot;,&quot;id_aliases&quot;:[&quot;EC-01&quot;],&quot;key&quot;:&quot;enterprise:ec-01&quot;,&quot;latex_label&quot;:&quot;cap:ec-01&quot;,&quot;local_id&quot;:&quot;EC-01&quot;,&quot;name&quot;:&quot;Managed Entity &amp; Relationship&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-EC-governed-information-operations&quot;,&quot;parent_key&quot;:&quot;proposal:ec-governed-information-operations&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The established reusable responsibility is a constituent ability of Governed Information Operations; its canonical scope and exclusions remain unchanged.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;EC-01&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/enterprise-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;ec-01-managed-entity-relationship&quot;,&quot;line&quot;:103,&quot;source&quot;:&quot;enterprise&quot;,&quot;text&quot;:&quot;### EC-01: Managed Entity &amp; Relationship&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT2&quot;,&quot;type&quot;:&quot;enterprise_capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[]}"/>
              <property key="v0.2 / Source Parent Reference" value="HCM-EC-governed-information-operations"/>
