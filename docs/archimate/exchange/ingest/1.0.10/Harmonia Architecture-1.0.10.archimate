\section{Enterprise CT2: Information Authority Qualification}
\label{cap:ec-information-authority-qualification}
\index{Information Authority Qualification}
\begingroup\small\setlength{\TableWidth}{\dimexpr\linewidth-6\tabcolsep-4\arrayrulewidth\relax}
\begin{longtable}{|>{\raggedright\arraybackslash}p{0.2\TableWidth}|>{\raggedright\arraybackslash}p{0.48\TableWidth}|>{\raggedright\arraybackslash}p{0.32\TableWidth}|}
