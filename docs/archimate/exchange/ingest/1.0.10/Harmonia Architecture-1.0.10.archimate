                <property key="v0.2 / Structural ID Status" value="Established"/>
                <property key="v0.2 / Structural Canonical ID" value="CT1-INDIVIDUAL-CARE-DELIVERY.CT2-INDIVIDUAL-HEALTH-MONITORING.CT3-CARE-RESPONSE-MONITORING"/>
