              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Business lifecycle integrity does not prescribe locks, database isolation or worker implementation, and illustrative state names do not define every subject's transitions.&quot;,&quot;Capability Overview&quot;:&quot;Managed State &amp; Lifecycle provides reusable responsibility for valid progression, temporal applicability and non-destructive change. A directory relationship, clinical document and operational work item have different business states, yet all need an intelligible distinction between current standing, historical state and invalid transitions. The capability captures that recurrence without replacing each subject's lifecycle meaning.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;EC-03&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-EC-GOVERNED-INFORMATION-OPERATIONS.CT2-EC-03&quot;,&quot;canonical_name&quot;:&quot;Managed State &amp; Lifecycle&quot;,&quot;category&quot;:&quot;enterprise&quot;,&quot;confidence&quot;:&quot;High&quot;,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Architectural Scope}: Govern the current and historical state, effective temporal periods, state transition validations, and lifecycle progression of managed integration artifacts and entities.\n\n\n\n\\item \n\\textbf{Functional Responsibilities}:\n\n\n\\begin{itemize}\n\n\\item \nDefining and enforcing valid state transition state machines (e.g., \\texttt{\\seqsplit{REQUESTED}} → \\texttt{\\seqsplit{VALIDATED}} → \\texttt{\\seqsplit{IN\\_PROGRESS}} → \\texttt{\\seqsplit{COMPLETED}}).\n\n\n\n\\item \nMaintaining temporal validity intervals (effective start and end dates) for relationships, credentials, and states.\n\n\n\n\\item \nSupporting non-destructive state progression, preserving historical state versions for longitudinal review.\n\n\n\n\\item \nRejecting illegal or out-of-order state transitions while accommodating idempotent replay.\n\n\n\n\\end{itemize}\n\n\n\\item \n\\textbf{Anti-Responsibilities}: Does not define thread-level mutexes or database transaction isolation levels.\n\n\n\n\\end{itemize}\n&quot;,&quot;id_aliases&quot;:[&quot;EC-03&quot;],&quot;key&quot;:&quot;enterprise:ec-03&quot;,&quot;latex_label&quot;:&quot;cap:ec-03&quot;,&quot;local_id&quot;:&quot;EC-03&quot;,&quot;name&quot;:&quot;Managed State &amp; Lifecycle&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-EC-governed-information-operations&quot;,&quot;parent_key&quot;:&quot;proposal:ec-governed-information-operations&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The established reusable responsibility is a constituent ability of Governed Information Operations; its canonical scope and exclusions remain unchanged.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;EC-03&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/enterprise-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;ec-03-managed-state-lifecycle&quot;,&quot;line&quot;:121,&quot;source&quot;:&quot;enterprise&quot;,&quot;text&quot;:&quot;### EC-03: Managed State &amp; Lifecycle&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT2&quot;,&quot;type&quot;:&quot;enterprise_capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[]}"/>
              <property key="v0.2 / Source Parent Reference" value="HCM-EC-governed-information-operations"/>
