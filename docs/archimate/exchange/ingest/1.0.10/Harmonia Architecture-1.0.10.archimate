ot;,&quot;evidence&quot;:[{&quot;line&quot;:33,&quot;path&quot;:&quot;docs/markdown/05-information-systems-architecture/design-notes/DesignNote-Identity-Authentication-and-Authorisation-Architecture.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Identity.Authentication is a **Separately Provided Capability (SEP)**. Harmonia's primary authentication pattern is standards-based OIDC/OAuth integration with an externally managed Identity Provider.&quot;},{&quot;line&quot;:348,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-07 --- Security Is Intrinsic to Managed Operations&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-EC-operation-bound-policy-enforcement&quot;,&quot;relevance&quot;:&quot;Proposed materiality; no inherited Core classification&quot;,&quot;sources&quot;:[],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT3&quot;,&quot;type&quot;:&quot;enterprise_capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[]}"/>
