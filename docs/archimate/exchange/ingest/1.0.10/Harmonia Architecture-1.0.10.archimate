              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Not every exchanged request or activity is chargeable. Provision of evidence does not establish a charging decision or an enterprise financial system.&quot;,&quot;Capability Overview&quot;:&quot;Financial &amp; Commercial Services provides the financial business frame needed for the bounded R1/R2 responsibility. Its established child identifies and supplies information about chargeable or cost-relevant clinical activity. The purpose is to make applicable activity evidence available to the responsible financial context without expanding the model into pricing, claims or revenue management.&quot;,&quot;Intent&quot;:&quot;Support legitimate funding, financial and charging purposes with relevant clinical-activity information.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-CORPORATE-RESOURCES-ENTERPRISE-SERVICES.CT2-FINANCIAL-COMMERCIAL-SERVICES&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:corporate-resources--enterprise-services&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-CORPORATE-RESOURCES-ENTERPRISE-SERVICES.CT2-FINANCIAL-COMMERCIAL-SERVICES&quot;,&quot;canonical_name&quot;:&quot;Financial &amp; Commercial Services&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nProvide the financial/\\allowbreak{}commercial business context materially required for R1/\\allowbreak{}R2.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:financial--commercial-services&quot;,&quot;latex_label&quot;:&quot;cap:bc-financial-commercial-services&quot;,&quot;local_id&quot;:&quot;FINANCIAL-COMMERCIAL-SERVICES