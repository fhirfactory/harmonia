                  <property key="friendlyName" value="EntityInformationEnablement.ProviderAdministration.PractitionerProfileAdministration.NationalPractitionerVerification.PractitionerVerificationProcess"/>
                  <property key="canonicalName" value="CT1-BEC-EntityInformationEnablement.CT2-BEC-ProviderAdministration.CT3-BEC-PractitionerProfileAdministration.FEAT-NationalPractitionerVerification.PR-PractitionerVerificationProcess"/>
