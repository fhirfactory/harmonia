              <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;ct2--medication--pharmacy-services&quot;,&quot;line&quot;:477,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;##### CT2 — Medication &amp; Pharmacy Services&quot;},{&quot;anchor&quot;:&quot;ct2--medication--pharmacy-services&quot;,&quot;line&quot;:479,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Tier and ancestry:** CT2; parent Diagnostic, Therapeutic &amp; Clinical Support Services (CT1).&quot;},{&quot;anchor&quot;:&quot;ct2--medication--pharmacy-services&quot;,&quot;line&quot;:481,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Provide professional medication/pharmacy services under applicable controls.&quot;},{&quot;anchor&quot;:&quot;ct2--medication--pharmacy-services&quot;,&quot;line&quot;:492,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Boundary:** Medication prescribed ≠ dispensed ≠ provided ≠ administered. Advice does not establish diagnosis, prescribing or authority to alter treatment. Dose aid provision does not establish the regimen; commercial packaging examples do not define the capability. These are pharmacy responsibilities, distinct from clinical intervention, and do not prescribe a medication sequence. Medication Advice’s detailed scope remains subject to refinement. OI-BC-001 remains unresolved; compounding/preparation is neither established, rejected nor silently subsumed.&quot;},{&quot;anchor&quot;:&quot;oi-bc-001--medication-compounding-and-preparation&quot;,&quot;line&quot;:1184,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;### OI-BC-001 — Medication Compounding and Preparation&quot;}]"/>
              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Advice does not confer prescribing authority, and dose aids do not establish a regimen. Whether specialised compounding/preparation warrants a separate capability remains unresolved under OI-BC-001.&quot;,&quot;Capability Overview&quot;:&quot;This capability frames professional medication provision and medication-specific advice. Prescription dispensing, non-prescription provision, advice and dose administration aids answer different needs, even where exercised by one pharmacy. The decomposition keeps the authorised regimen, provision of medicine and actual administration separate so that a supply event is not mistaken for treatment performed.&quot;,&quot;Intent&quot;:&quot;Support safe, professionally controlled access to and use of medication within the established pharmacy responsibility.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-DIAGNOSTIC-THERAPEUTIC-CLINICAL-SUPPORT-SERVICES.CT2-MEDICATION-PHARMACY-SERVICES&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:diagnostic-therapeutic--clinical-support-services&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;,&quot;medication_compounding&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-DIAGNOSTIC-THERAPEUTIC-CLINICAL-SUPPORT-SERVICES.CT2-MEDICATION-PHARMACY-SERVICES&quot;,&quot;canonical_name&quot;:&quot;Medication &amp; Pharmacy Services&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nProvide professional medication/\\allowbreak{}pharmacy services under applicable controls.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:medication--pharmacy-services&quot;,&quot;latex_label&