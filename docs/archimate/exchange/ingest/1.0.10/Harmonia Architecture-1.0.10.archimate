              <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Diagnostic interpretation is limited to the service's professional scope; patient-level Clinical Determination considers the wider clinical context. The children do not prescribe a universal diagnostic workflow or establish a Diagnostic Order Management capability.&quot;,&quot;Capability Overview&quot;:&quot;Diagnostic Support Provision covers the distinct responsibilities through which a diagnostic service obtains evidence and makes its findings available. Diagnostic scheduling, service performance, specimen stewardship, data management, interpretation, report governance and report distribution each establish a different outcome. Their separation allows preliminary, amended or final information to retain its professional and evidentiary standing without treating delivery as authorisation.&quot;,&quot;Intent&quot;:&quot;Make diagnostic evidence and professionally governed findings usable by the appropriate care participants.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-DIAGNOSTIC-THERAPEUTIC-CLINICAL-SUPPORT-SERVICES.CT2-DIAGNOSTIC-SUPPORT-PROVISION&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:diagnostic-therapeutic--clinical-support-services&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-DIAGNOSTIC-THERAPEUTIC-CLINICAL-SUPPORT-SERVICES.CT2-DIAGNOSTIC-SUPPORT-PROVISION&quot;,&quot;canonical_name&quot;:&quot;Diagnostic Support Provision&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nProvide diagnostic services and manage their evidence, interpretation and governed reporting.\n\n&quot;,&quot;id_aliases&quot;:[