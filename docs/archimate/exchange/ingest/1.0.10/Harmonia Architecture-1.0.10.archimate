hority over clinical execution and its result.&quot;,&quot;Intent&quot;:&quot;Preserve an intelligible connection between the original request, its destination, progression and returned outcome.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;tier&quot;,&quot;root_status&quot;,&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-ADMINISTRATION-INFORMATION-ENABLEMENT.CT2-BEC-CARE-FULFILMENT-ADMINISTRATION-ENABLEMENT.CT3-BEC-ORDER-ADMINISTRATION&quot;,&quot;canonical_name&quot;:&quot;Order Administration&quot;,&quot;category&quot;:&quot;business_enabling&quot;,&quot;confidence&quot;:&quot;High&quot;,&quot;governed_definition_latex&quot;:&quot;&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;capability:order-administration&quot;,&quot;latex_label&quot;:&quot;cap:bec-order-administration&quot;,&quot;local_id&quot;:&quot;BEC-ORDER-ADMINISTRATION&quot;,&quot;name&quot;:&quot;Order Administration&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-BEC-care-fulfilment-administration-enablement&quot;,&quot;parent_key&quot;:&quot;proposal:bec-care-fulfilment-administration-enablement&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-ti