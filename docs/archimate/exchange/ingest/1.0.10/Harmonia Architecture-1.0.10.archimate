            <folder name="[Feature] Document Versioning &amp; Supersession" id="id-d242f41923284992a6837663020d1ed1">
              <folder name="Functions" id="id-a6bcbc6d47b048cfb9b3850cfb37ab6a">
                <element xsi:type="archimate:BusinessFunction" name="Govern Clinical Document Lifecycle" id="id-0e3572d859da5d5a8f5500dd2fbcfa7e">
                  <documentation>Manages document states (scoped illustration, not a universal transition model): Draft → Preliminary → Final → Amended → Superseded → Entered-in-Error.</documentation>
                  <property key="v0.2 / Source Capture Key" value="function:govern-clinical-document-lifecycle"/>
                  <property key="v0.2 / Snapshot Reference ID" value="HCM-FN-govern-clinical-document-lifecycle"/>
                  <property key="v0.2 / LaTeX Label" value="function:govern-clinical-document-lifecycle"/>
                  <property key="v0.2 / Construct Type" value="function"/>
                  <property key="v0.2 / Architectural Status" value="Canonical"/>
                  <property key="v0.2 / Record State" value="current"/>
                  <property key="v0.2 / Placement Status" value="Established"/>
                  <property key="v0.2 / Structural ID Status" value="Proposed"/>
                  <property key="v0.2 / Structural Canonical ID" value="CT1-BEC-CARE-ADMINISTRATION-INFORMATION-ENABLEMENT.CT2-BEC-CLINICAL-RECORD-ADMINISTRATION.FN-GOVERN-CLINICAL-DOCUMENT-LIFECYCLE"/>
                  <property key="v0.2 / Historical ID Aliases" value="[&quot;CT1-BEC-CARE-ADMINISTRATION-INFORMATION-ENABLEMENT.CT2-BEC-CARE-DOCUMENTATION-COMMUNICATION-ENABLEMENT.CT3-BEC-CLINICAL-RECORD-ADMINISTRATION.FN-GOVERN-CLINICAL-DOCUMENT-LIFECYCLE&quot;]"/>
                  <property key="v0.2 / Name Status" value="Canonical"/>
                  <property key="v0.2 / Canonical Name" value="Govern Clinical Document Lifecycle"/>
                  <property key="v0.2 / Architecture Identity Status" value="Unresolved — representation ID only"/>
