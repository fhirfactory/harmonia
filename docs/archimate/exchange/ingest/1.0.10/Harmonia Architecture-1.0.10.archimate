cal&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-workflow-activity-coordination&quot;,&quot;owner_key&quot;:&quot;capability:workflow--activity-coordination&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;reference_id&quot;:&quot;HCM-PR-work-order-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:workflow--activity-coordination&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;514-work-order-progression-process&quot;,&quot;line&quot;:282,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 5.14 Work Order Progression Process&quot;},{&quot;anchor&quot;:&quot;514-work-order-progression-process&quot;,&quot;line&quot;:283,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Workflow &amp; Activity Coordination`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:intrinsic--shared-enablement&quot;]},&quot;record_state&quot;:&quot;pending_adjudication&quot;,&quot;reference_id&quot;:&quot;HCM-PR-work-order-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:workflow--activity-coordination&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;514-work-order-progression-process&quot;,&quot;line&quot;:282,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 5.14 Work Order Progression Process&quot;},{&quot;anchor&quot;:&quot;514-work-order-progression-process&quot;,&quot;line&quot;:283,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Workflow &