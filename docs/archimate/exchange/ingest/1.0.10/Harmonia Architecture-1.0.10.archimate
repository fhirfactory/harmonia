                  <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;22-practitioner-verification-process&quot;,&quot;line&quot;:85,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 2.2 Practitioner Verification Process&quot;},{&quot;anchor&quot;:&quot;22-practitioner-verification-process&quot;,&quot;line&quot;:86,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Provider Administration`&quot;}]"/>
                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;Verification progresses from checking the recognised professional source to the locally applicable endorsement and continuing verification status. The distinction matters because a nationally identifiable practitioner is not automatically privileged for every service activity. The illustrated progression retains the health service's endorsement responsibility rather than letting directory ingestion grant clinical authority.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:provider-administration&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-HEALTHCARE-ENTITY-INFORMATION-ENABLEMENT.CT2-BEC-PROVIDER-ADMINISTRATION.PR-PRACTITIONER-VERIFICATION-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Practitioner Verification Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Provider Administration}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the lifecycle of validating, certifying, and periodically re-verifying a healthcare practitioner's professional credentials, registration status, and clinical scope of practice.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Verification Initiated → Regulatory Registry Queried → Credentials Validated → Privileges Endorsed → Active Verified → Expired /\\allowbreak{} Suspended\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Verification Initiated}}: New practitioner registration or periodic re-credentialing triggered.\n\n\n\n\\item \n\\texttt{\\seqsplit{Regulatory Registry Queried}}: Real-time query executed against national registry (e.g., AHPRA).\n\n\n\n\\item \n\\texttt{\\seqsplit{Credentials Validated}}: Primary qualifications, specialist endorsements, and sanctions checked.\n\n\n\n\\item \n\\texttt{\\seqsplit{Privileges Endorsed}}: Health service medical administration endorses admitting/\\allowbreak{}procedural scope.\n\n\n\n\\item \n\\texttt{\\seqsplit{Active Verified}}: Practitioner verified for clinical ordering and electronic communication.\n\n\n\n\\item \n\\texttt{\\seqsplit{Expired / Suspended}}: Verification lapses or regulatory sanction triggers privilege suspension.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;process:practitioner-verification-process&quot;,&quot;latex_label&quot;:&quot;process:practitioner-verification-process&quot;,&quot;local_id&quot;:&quot;PRACTITIONER-VERIFICATION-PROCESS&quot;,&quot;name&quot;:&quot;Practitioner Verification Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-provider-administration&quot;,&quot;owner_key&quot;:&quot;capability:provider-administration&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-practitioner-verification-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:provider-administration&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;22-practitioner-verification-process&quot;,&quot;line&quot;:85,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 2.2 Practitioner Verification Process&quot;},{&quot;anchor&quot;:&quot;22-practitioner-verification-process&quot;,&quot;line&quot;:86,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Provider Administration`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:entity-management&quot;]}"/>
                  <property key="v0.2 / Unresolved Dimensions" value="[&quot;feature_association&quot;]"/>
                  <property key="v0.2 / Source Owner Reference" value="HCM-BEC-provider-administration"/>
                  <property key="v0.2 / Deferred Relationship Assertions" value="[{&quot;disposition&quot;:&quot;metadata_and_finding&quot;,&quot;reason&quot;:&quot;Process responsibility/governance is not automatically Assignment or Composition.&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;snapshot_pointer&quot;:&quot;/relationships/279&quot;,&quot;source_assertion&quot;:{&quot;from&quot;:&quot;function:verify-practitioner-registration&quot;,&quot;sources&quot;:[{&quot;anchor&quot;:&quot;3-provider-administration&quot;,&quot;line&quot;:94,&quot;source&quot;:&quot;em&quot;,&quot;text&quot;:&quot; - *Governed Process*: **Practitioner Verification Process**.&quot;}],&quot;status&quot;:&quot;established&quot;,&quot;to&quot;:&quot;process:practitioner-verification-process&quot;,&quot;type&quot;:&quot;governed_process&quot;},&quot;source_index&quot;:279}]"/>
                  <property key="Baseline / Textual Baseline Reference" value="docs/markdown/governance/baseline/processes.md#hcm-pr-practitioner-verification-process"/>
