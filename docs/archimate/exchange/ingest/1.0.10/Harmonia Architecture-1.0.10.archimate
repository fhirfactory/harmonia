            <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Information provision does not own trials, ethics approval or specialist research analysis. Evaluating innovation does not authorise adoption or implementation.&quot;,&quot;Capability Overview&quot;:&quot;This capability frames the deliberately bounded research and innovation responsibilities material to Harmonia's R1/R2 architecture. Research Information Support concerns provision of existing information for authorised research; Health Innovation concerns evaluation of proposed or emerging innovation. These establish useful enterprise context without implying a complete research organisation or innovation lifecycle.&quot;,&quot;Harmonia Architectural Relevance&quot;:&quot;Governed provision of existing information materially enables authorised research. Innovation evaluation has no separate platform assignment; the CT1 classification must not be inherited by each descendant.&quot;,&quot;Intent&quot;:&quot;Support legitimate research information needs and informed consideration of changes to health-service or clinical practice.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-HEALTH-RESEARCH-INNOVATION&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:&quot;CT1&quot;},&quot;baseline_unresolved&quot;:[],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-HEALTH-RESEARCH-INNOVATION&quot;,&quot;canonical_name&quot;:&quot;Health Research &amp; Innovation&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nProvide existing health information for authorised research under applicable constraints and evaluate health innovation; deliberately under-decomposed for R1/\\allowbreak{}R2.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;capability:health-research--innovation&quot;,&quot;latex_label&quot;:&quot;cap:bc-health-research-innovation&quot;,&quot;local_id&quot;:&quot;HEALTH-RESEARCH-INNOVATION&quot;,&quot;name&quot;:&quot;Health Research &amp; Innovation&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BC-health-research-innovation&quot;,&quot;relevance&quot;:&quot;Harmonia-Relevant&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;13-health-research--innovation&quot;,&quot;line&quot;:824,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;#### 13. Health Research &amp; Innovation&quot;},{&quot;anchor&quot;:&quot;13-health-research--innovation&quot;,&quot;line&quot;:828,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Provide existing health information for authorised research under applicable constraints and evaluate health innovation; deliberately under-decomposed for R1/R2.&quot;},{&quot;anchor&quot;:null,&quot;line&quot;:120,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;catalogue domains below are explicitly **CT1 roots**; each branch statement&quot;}],&quot;structural_id_status&quot;:&quot;Established&quot;,&quot;tier&quot;:&quot;CT1&quot;,&quot;type&quot;:&quot;capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[&quot;region:research--innovation&quot;]}"/>
