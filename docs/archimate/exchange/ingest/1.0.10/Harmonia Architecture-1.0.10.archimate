              <folder name="[Feature] Virtual Care Session Context Binding" id="id-46a8b346bd604083a7209fb40199a283">
                <element xsi:type="archimate:Capability" name="Virtual Care Session Context Binding" id="id-3135686eb16c5fabacc1675448e54251">
                  <documentation>Associate synchronous virtual/telehealth consultations with the longitudinal health record and active care episode.

Virtual-session binding associates a consultation with the enduring record and the relevant episode. It preserves the clinical context across delivery modes without turning the communication session itself into proof of clinical conclusions or adequacy of care.</documentation>
                  <property key="v0.2 / Source Capture Key" value="feature:virtual-care-session-context-binding"/>
                  <property key="v0.2 / Snapshot Reference ID" value="FEAT-SD-20"/>
