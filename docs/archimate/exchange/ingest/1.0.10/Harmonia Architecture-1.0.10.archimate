nisational change.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;capability:health-service-direction--stewardship&quot;,&quot;latex_label&quot;:&quot;cap:bc-health-service-direction-stewardship&quot;,&quot;local_id&quot;:&quot;HEALTH-SERVICE-DIRECTION-STEWARDSHIP&quot;,&quot;name&quot;:&quot;Health Service Direction &amp; Stewardship&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BC-health-service-direction-stewardship&quot;,&quot;relevance&quot;:&quot;Harmonia-Relevant&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;14-health-service-direction--stewardship&quot;,&quot;line&quot;:864,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;#### 14. Health Service Direction &amp; Stewardship&quot;},{&quot;anchor&quot;:&quot;14-health-service-direction--stewardship&quot;,&quot;line&quot;:868,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Model needed health services and their viability requirements, support establishment/improvement and align services with the wider ecosystem of dependencies, resources, financial arrangements and organisational change.&quot;},{&quot;anchor&quot;:null,&quot;line&quot;:120,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;catalogue domains below are explicitly **CT1 roots**; each branch statement&quot;}],&quot;structural_id_status&quot;:&quot;Established&quot;,&quot;tier&quot;:&quot;CT1&quot;,&quot;type&quot;:&quot;capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[&quot;region:health-service-management&quot;]}"/>
