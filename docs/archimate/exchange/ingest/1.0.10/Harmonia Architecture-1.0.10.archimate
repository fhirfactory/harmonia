            <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Care access, appointments and operational coordination enable care but do not establish that it has been performed. Clinical judgement and the authority to deliver care remain with the responsible participants; possession or coordination of their information does not transfer that authority to Harmonia.&quot;,&quot;Capability Overview&quot;:&quot;Individual Care Delivery is the organisation's ability to understand an individual's health and act on that understanding through purposeful care. Its six constituent abilities distinguish establishing findings, interpreting their clinical meaning, choosing a response, performing care, observing change and evaluating care against its objectives. These distinctions describe responsibilities and outcomes rather than a compulsory sequence: a consultation or continuing episode may revisit several of them.\n\nThe same ability can be exercised in a hospital, a general practice, a home or a virtual consultation. Setting and time pattern affect the circumstances of care without changing the responsibility represented by this capability.&quot;,&quot;Harmonia Architectural Relevance&quot;:&quot;Harmonia supplies and connects information used in individual care. The approved Health Information Access support trace is bounded: records can inform care, but direct assessment can establish findings independently, and access to a proposed intervention does not authorise its performance.&quot;,&quot;Intent&quot;:&quot;Support clinically meaningful care whose intent, performance, observed effects and continuing appropriateness can be distinguished.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-INDIVIDUAL-CARE-DELIVERY&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:&quot;CT1&quot;},&quot;baseline_unresolved&quot;:[],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-INDIVIDUAL-CARE-DELIVERY&quot;,&quot;canonical_name&quot;:&quot;Individual Care Delivery&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nAssess, clinically determine, plan, intervene, monitor and review individual care independently of setting, mode, time pattern or organisational arrangement.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;capability:individual-care-delivery&quot;,&quot;latex_label&quot;:&quot;cap:bc-individual-care-delivery&quot;,&quot;local_id&quot;:&quot;INDIVIDUAL-CARE-DELIVERY&quot;,&quot;name&quot;:&quot;Individual Care Delivery&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BC-individual-care-delivery&quot;,&quot;relevance&quot;:&quot;Harmonia-Relevant&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;01-individual-care-delivery&quot;,&quot;line&quot;:148,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;#### 01. Individual Care Delivery&quot;},{&quot;anchor&quot;:&quot;01-individual-care-delivery&quot;,&quot;line&quot;:152,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Assess, clinically determine, plan, intervene, monitor and review individual care independently of setting, mode, time pattern or organisational arrangement.&quot;},{&quot;anchor&quot;:null,&quot;line&quot;:120,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;catalogue domains below are explicitly **CT1 roots**; each branch statement&quot;}],&quot;structural_id_status&quot;:&quot;Established&quot;,&quot;tier&quot;:&quot;CT1&quot;,&quot;type&quot;:&quot;capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[&quot;region:care--health-delivery&quot;]}"/>
            <property key="v0.2 / Deferred Relationship Assertions" value="[{&quot;disposition&quot;:&quot;metadata_and_finding&quot;,&quot;reason&quot;:&quot;Material-enablement Association profile explicitly still requires review in the mapping authority.&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;snapshot_pointer&quot;:&quot;/relationships/268&quot;,&quot;source_assertion&quot;:{&quot;from&quot;:&quot;capability:individual-care-delivery&quot;,&quot;sources&quot;:[{&quot;anchor&quot;:&quot;0106-individual-care-review&quot;,&quot;line&quot;:314,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;The previously approved [B2.1 support trace](../../05-information-systems-architecture/traceability/b2-1-individual-care-delivery-health-information-access.md) is preserved without extending it to CT3s or establishing runtime dependencies.&quot;}],&quot;status&quot;:&quot;established&quot;,&quot;to&quot;:&quot;capability:health-information-access&quot;,&quot;type&quot;:&quot;enabled_by&quot;},&quot;source_index&quot;:268},{&quot;disposition&quot;:&quot;metadata_and_finding&quot;,&quot;reason&quot;:&quot;Material-enablement Association profile explicitly still requires review in the mapping authority.&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;snapshot_pointer&quot;:&quot;/relationships/665&quot;,&quot;source_assertion&quot;:{&quot;from&quot;:&quot;capability:individual-care-delivery&quot;,&quot;provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Semantic responsibility analysis; no authority transfer&quot;,&quot;evidence&quot;:[{&quot;line&quot;:10,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/information-responsibility/information-responsibility.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### 1.2 Non-Transfer of Ownership Guardrail&quot;}],&quot;method&q