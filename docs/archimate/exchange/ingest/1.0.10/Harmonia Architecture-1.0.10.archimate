                  <property key="v0.2 / Snapshot Reference ID" value="HCM-PR-indeterminate-activity-outcome-reconciliation-process"/>
                  <property key="v0.2 / LaTeX Label" value="process:indeterminate-activity-outcome-reconciliation-process"/>
                  <property key="v0.2 / Construct Type" value="process"/>
                  <property key="v0.2 / Architectural Status" value="Proposed"/>
                  <property key="v0.2 / Record State" value="pending_adjudication"/>
