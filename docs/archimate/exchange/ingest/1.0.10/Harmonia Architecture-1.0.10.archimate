        <property key="Baseline / Review State" value="Retained baseline standing"/>
        <property key="canonicalId" value="e2f8b62e2cbd486282d68b6009c06de6"/>
        <property key="displayName" value="Reliable Subject Identity and Referential Integrity"/>
        <property key="friendlyName" value="ReliableSubjectIdentityAndReferentialIntegrity"/>
