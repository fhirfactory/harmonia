              <folder name="Processes" id="id-600da8eca6c24675bce240736bf0e716">
                <element xsi:type="archimate:BusinessProcess" name="Clinic / Operational Queue Progression Process" id="id-6d1d76ff79ee5bc0856e025561f5dc85">
                  <documentation>•
Owning Capability: Clinic &amp; Practice Operations

•
Process Purpose: Governs the movement and state tracking of outpatients through an ambulatory specialty clinic session.

•
State Progression Lifecycle: Scheduled → Patient Arrived → Checked-In → Roomed / Pre-Consult → Consultation In-Progress → Consultation Concluded → Departed

•
Key State Dispositions:

•
Scheduled: Appointment booked on session list.

•
Patient Arrived: Patient enters waiting area.

•
Checked-In: Reception verifies demographics and marks patient ready.

•
Roomed / Pre-Consult: Nursing staff record baseline vitals and room patient.

•
Consultation In-Progress: Clinician actively conducting consultation.

•
Consultation Concluded: Clinical discussion finished; follow-up orders placed.

•
Departed: Patient checks out and departs clinic facility.

This Process follows an individual's operational passage through the clinic. Waiting, rooming, consultation and departure have different implications for flow and communication, while the clinic's overall session has its own state. The progression is therefore patient-specific operational context rather than a complete account of clinic capacity or clinical priority.</documentation>
                  <property key="v0.2 / Source Capture Key" value="process:clinic--operational-queue-progression-process"/>
                  <property key="v0.2 / Snapshot Reference ID" value="HCM-PR-clinic-operational-queue-progression-process"/>
                  <property key="v0.2 / LaTeX Label" value="process:clinic-operational-queue-progression-process"/>
                  <property key="v0.2 / Construct Type" value="process"/>
                  <property key="v0.2 / Architectural Status" value="Canonical"/>
                  <property key="v0.2 / Record State" value="current"/>
                  <property key="v0.2 / Placement Status" value="Established"/>
                  <property key="v0.2 / Structural ID Status" value="Proposed"/>
                  <property key="v0.2 / Structural Canonical ID" value="CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CLINIC-PRACTICE-OPERATIONS.PR-CLINIC-OPERATIONAL-QUEUE-PROGRESSION-PROCESS"/>
                  <property key="v0.2 / Historical ID Aliases" value="[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-SETTING-OPERATIONS-ENABLEMENT.CT3-BEC-CLINIC-PRACTICE-OPERATIONS.PR-CLINIC-OPERATIONAL-QUEUE-PROGRESSION-PROCESS&quot;]"/>
                  <property key="v0.2 / Name Status" value="Canonical"/>
                  <property key="v0.2 / Canonical Name" value="Clinic / Operational Queue Progression Process"/>
                  <property key="v0.2 / Architecture Identity Status" value="Unresolved — representation ID only"/>
                  <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;48-clinic--operational-queue-progression-process&quot;,&quot;line&quot;:187,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.8 Clinic / Operational Queue Progression Process&quot;},{&quot;anchor&quot;:&quot;48-clinic--operational-queue-progression-process&quot;,&quot;line&quot;:188,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Clinic &amp; Practice Operations`&quot;}]"/>
                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;This Process follows an individual's operational passage through the clinic. Waiting, rooming, consultation and departure have different implications for flow and communication, while the clinic's overall session has its own state. The progression is therefore patient-specific operational context rather than a complete account of clinic capacity or clinical priority.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:clinic--practice-operations&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CLINIC-PRACTICE-OPERATIONS.PR-CLINIC-OPERATIONAL-QUEUE-PROGRESSION-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Clinic / Operational Queue Progression Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Clinic \\&amp; Practice Operations}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the movement and state tracking of outpatients through an ambulatory specialty clinic session.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Scheduled → Patient Arrived → Checked-In → Roomed /\\allowbreak{} Pre-Consult → Consultation In-Progress → Consultation Concluded → Departed\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Scheduled}}: Appointment booked on session list.\n\n\n\n\\item \n\\texttt{\\seqsplit{Patient Arrived}}: Patient enters waiting area.\n\n\n\n\\item \n\\texttt{\\seqsplit{Checked-In}}: Reception verifies demographics and marks patient ready.\n\n\n\n\\item \n\\texttt{\\seqsplit{Roomed / Pre-Consult}}: Nursing staff record baseline vitals and room patient.\n\n\n\n\\item \n\\texttt{\\seqsplit{Consultation In-Progress}}: Clinician actively conducting consultation.\n\n\n\n\\item \n\\texttt{\\seqsplit{Consultation Concluded}}: Clinical discussion finished; follow-up orders placed.\n\n\n\n\\item \n\\texttt{\\seqsplit{Departed}}: Patient checks out and departs clinic facility.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-SETTING-OPERATIONS-ENABLEMENT.CT3-BEC-CLINIC-PRACTICE-OPERATIONS.PR-CLINIC-OPERATIONAL-QUEUE-PROGRESSION-PROCESS&quot;],&quot;key&quot;:&quot;process:clinic--operational-queue-progression-process&quot;,&quot;latex_label&quot;:&quot;process:clinic-operational-queue-progression-process&quot;,&quot;local_id&quot;:&quot;CLINIC-OPERATIONAL-QUEUE-PROGRESSION-PROCESS&quot;,&quot;name&quot;:&quot;Clinic / Operational Queue Progression Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-clinic-practice-operations&quot;,&quot;owner_key&quot;:&quot;capability:clinic--practice-operations&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-clinic-operational-queue-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:clinic--practice-operations&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;48-clinic--operational-queue-progression-process&quot;,&quot;line&quot;:187,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.8 Clinic / Operational Queue Progression Process&quot;},{&quot;anchor&quot;:&quot;48-clinic--operational-queue-progression-process&quot;,&quot;line&quot;:188,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Clinic &amp; Practice Operations`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:health-service-operations&quot;]}"/>
                  <property key="v0.2 / Unresolved Dimensions" value="[&quot;feature_association&quot;]"/>
                  <property key="v0.2 / Source Owner Reference" value="HCM-BEC-clinic-practice-operations"/>
                  <property key="v0.2 / Deferred Relationship Assertions" value="[{&quot;disposition&quot;:&quot;metadata_and_finding&quot;,&quot;reason&quot;:&quot;Process responsibility/governance is not automatically Assignment or Composition.&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;snapshot_pointer&quot;:&quot;/relationships/284&quot;,&quot;source_assertion&quot;:{&quot;from&quot;:&quot;function:manage-clinic-queue-progression&quot;,&quot;sources&quot;:[{&quot;anchor&quot;:&quot;21-clinic--practice-operations&quot;,&quot;line&quot;:84,&quot;source&quot;:&quot;hso&quot;,&quot;text&quot;:&quot; - *Governed Process*: **Clinic / Operational Queue Progression Process**.&quot;}],&quot;status&quot;:&quot;established&quot;,&quot;to&quot;:&quot;process:clinic--operational-queue-progression-process&quot;,&quot;type&quot;:&quot;governed_process&quot;},&quot;source_index&quot;:284}]"/>
