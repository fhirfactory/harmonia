<?xml version="1.0" encoding="UTF-8"?>
<!--
  Copyright (c) 2026 Mark Hunter
  Petasos Apache ActiveMQ Artemis Configuration: Backup Node A (Protecting Group A)
-->
<core xmlns="urn:activemq:core" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="urn:activemq:core https://schema.activemq.org/activemq-core.xsd">

   <name>artemis-backup-a</name>
   <persistence-enabled>true</persistence-enabled>
   <journal-type>NIO</journal-type>

   <!-- Dedicated storage directories for Backup A -->
   <bindings-directory>./data/bindings</bindings-directory>
   <journal-directory>./data/journal</journal-directory>
   <large-messages-directory>./data/large-messages</large-messages-directory>
   <paging-directory>./data/paging</paging-directory>

   <connectors>
      <!-- Local connector -->
      <connector name="artemis">tcp://artemis-backup-a:61616</connector>
      <!-- Connectors for all cluster & replication peers -->
      <connector name="primary-a-connector">tcp://artemis-primary-a:61616</connector>
      <connector name="backup-a-connector">tcp://artemis-backup-a:61616</connector>
      <connector name="primary-b-connector">tcp://artemis-primary-b:61616</connector>
      <connector name="backup-b-connector">tcp://artemis-backup-b:61616</connector>
   </connectors>

   <acceptors>
      <acceptor name="artemis">tcp://0.0.0.0:61616?tcpSendBufferSize=1048576;tcpReceiveBufferSize=1048576;protocols=CORE,AMQP,OPENWIRE;connectionTtl=60000;connectionTtlCheckInterval=10000</acceptor>
   </acceptors>

   <!-- Replication HA Policy: Backup for Group A with failback enabled -->
   <ha-policy>
      <replication>
         <backup>
            <group-name>group-a</group-name>
            <allow-failback>true</allow-failback>
         </backup>
      </replication>
   </ha-policy>

   <!-- Cluster authentication credentials -->
   <cluster-user>${CLUSTER_USER:artemisCluster}</cluster-user>
   <cluster-password>${CLUSTER_PASSWORD:artemisClusterPassword}</cluster-password>

   <!-- Clustered server-side message distribution -->
   <cluster-connections>
      <cluster-connection name="petasos-cluster">
         <connector-ref>artemis</connector-ref>
         <retry-interval>500</retry-interval>
         <retry-interval-multiplier>1.5</retry-interval-multiplier>
         <max-retry-interval>2000</max-retry-interval>
         <reconnect-attempts>-1</reconnect-attempts>
         <use-duplicate-detection>true</use-duplicate-detection>
         <message-load-balancing>ON_DEMAND</message-load-balancing>
         <max-hops>1</max-hops>
         <static-connectors>
            <connector-ref>primary-a-connector</connector-ref>
            <connector-ref>backup-a-connector</connector-ref>
            <connector-ref>primary-b-connector</connector-ref>
            <connector-ref>backup-b-connector</connector-ref>
         </static-connectors>
      </cluster-connection>
   </cluster-connections>

   <!-- Addressing, Duplicate Detection, DLQ, Expiry, Paging, and Redistribution -->
   <address-settings>
      <address-setting match="#">
         <dead-letter-address>DLQ</dead-letter-address>
         <expiry-address>ExpiryQueue</expiry-address>
         <redelivery-delay>1000</redelivery-delay>
         <redelivery-delay-multiplier>1.5</redelivery-delay-multiplier>
         <max-delivery-attempts>3</max-delivery-attempts>
         <redistribution-delay>0</redistribution-delay>
         <id-cache-size>20000</id-cache-size>
         <max-size-bytes>104857600</max-size-bytes>
         <page-size-bytes>10485760</page-size-bytes>
         <address-full-policy>PAGE</address-full-policy>
         <auto-create-queues>true</auto-create-queues>
         <auto-create-addresses>true</auto-create-addresses>
         <auto-delete-queues>false</auto-delete-queues>
         <auto-delete-addresses>false</auto-delete-addresses>
      </address-setting>
   </address-settings>

   <addresses>
      <address name="DLQ">
         <anycast>
            <queue name="DLQ" />
         </anycast>
      </address>
      <address name="ExpiryQueue">
         <anycast>
            <queue name="ExpiryQueue" />
         </anycast>
      </address>
   </addresses>

   <security-enabled>true</security-enabled>
   <security-settings>
      <security-setting match="#">
         <permission type="createAddress" roles="admin,harmonia"/>
         <permission type="deleteAddress" roles="admin"/>
         <permission type="createNonDurableQueue" roles="admin,harmonia"/>
         <permission type="deleteNonDurableQueue" roles="admin,harmonia"/>
         <permission type="createDurableQueue" roles="admin,harmonia"/>
         <permission type="deleteDurableQueue" roles="admin"/>
         <permission type="send" roles="admin,harmonia"/>
         <permission type="consume" roles="admin,harmonia"/>
         <permission type="browse" roles="admin,harmonia"/>
         <permission type="manage" roles="admin"/>
      </security-setting>
   </security-settings>

</core>
