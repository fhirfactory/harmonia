    </element>
    <element identifier="ct1" xsi:type="Capability">
      <name xml:lang="en">[CT1] Diagnostic parent</name>
    </element>
    <element identifier="ct2" xsi:type="Capability">
      <name xml:lang="en">[CT2] Diagnostic child</name>
    </element>
    <element identifier="simple" xsi:type="Capability">
      <name xml:lang="en">Simple canonical leaf</name>
    </element>
    <element identifier="child" xsi:type="Capability">
      <name xml:lang="en">Child leaf</name>
    </element>
    <element identifier="context-cap" xsi:type="Capability">
      <name xml:lang="en">Canonical contextual Capability</name>
    </element>
    <element identifier="ct3" xsi:type="Capability">
      <name xml:lang="en">[CT3] Diagnostic leaf</name>
    </element>
    <element identifier="a-ct1" xsi:type="Capability">
      <name xml:lang="en">[CT1] Folder-plus-element parent</name>
    </element>
    <element identifier="a-ct2" xsi:type="Capability">
      <name xml:lang="en">[CT2] Folder-plus-element child</name>
    </element>
    <element identifier="a-ct3" xsi:type="Capability">
      <name xml:lang="en">[CT3] Folder-plus-element leaf</name>
    </element>
    <element identifier="stream" xsi:type="ValueStream">
      <name xml:lang="en">Diagnostic Value Stream</name>
    </element>
    <element identifier="context-function" xsi:type="BusinessFunction">
      <name xml:lang="en">Contextual behaviour</name>
    </element>
    <element identifier="product" xsi:type="Product">
      <name xml:lang="en">Diagnostic Product</name>
    </element>
    <element identifier="care" xsi:type="DataObject">
      <name xml:lang="en">[Topic] Diagnostic Care</name>
    </element>
    <element identifier="encounter" xsi:type="DataObject">
      <name xml:lang="en">[Topic] Diagnostic Encounter</name>
    </element>
    <element identifier="a-care" xsi:type="DataObject">
      <name xml:lang="en">[Topic] Folder-plus-element Care</name>
    </element>
    <element identifier="a-encounter" xsi:type="DataObject">
      <name xml:lang="en">[Topic] Folder-plus-element Encounter</name>
    </element>
    <element identifier="driver" xsi:type="Driver">
      <name xml:lang="en">Driver with reference-only children</name>
    </element>
