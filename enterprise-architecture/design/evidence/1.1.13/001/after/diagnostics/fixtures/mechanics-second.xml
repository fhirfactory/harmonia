  <organizations>
    <item>
      <label xml:lang="en">Strategy</label>
      <item>
        <label xml:lang="en">Diagnostic cases</label>
        <item>
          <label xml:lang="en">1 Simple folder</label>
          <item identifierRef="simple" />
        </item>
        <item>
          <label xml:lang="en">2 Combined parent item</label>
          <item>
            <label xml:lang="en">Parent folder label</label>
            <item identifierRef="child" />
          </item>
        </item>
        <item>
          <label xml:lang="en">3 Canonical primary location</label>
          <item identifierRef="context-cap" />
        </item>
        <item>
          <label xml:lang="en">4 Nested Strategy</label>
          <item>
            <label xml:lang="en">CT1 parent</label>
            <item>
              <label xml:lang="en">CT2 parent</label>
              <item identifierRef="ct3" />
            </item>
          </item>
        </item>
        <item>
          <label xml:lang="en">6 Candidate A Strategy</label>
          <item>
            <label xml:lang="en">CT1 folder</label>
            <item>
              <label xml:lang="en">CT2 folder</label>
              <item identifierRef="a-ct2" />
              <item identifierRef="a-ct3" />
            </item>
            <item identifierRef="a-ct1" />
          </item>
        </item>
        <item>
          <label xml:lang="en">7 Logical Business mixed types</label>
          <item identifierRef="stream" />
        </item>
      </item>
      <item identifierRef="parent" />
      <item identifierRef="ct1" />
      <item identifierRef="ct2" />
    </item>
    <item>
      <label xml:lang="en">Business</label>
      <item>
        <label xml:lang="en">Diagnostic cases</label>
        <item>
          <label xml:lang="en">3 Business context</label>
          <item>
            <label xml:lang="en">CT1 context</label>
            <documentation xml:lang="en">Reference to context-cap; not identifierRef</documentation>
            <item>
              <label xml:lang="en">CT2 context</label>
              <item identifierRef="context-function" />
            </item>
          </item>
        </item>
        <item>
          <label xml:lang="en">7 Logical Business mixed types</label>
          <item identifierRef="product" />
        </item>
      </item>
    </item>
    <item>
      <label xml:lang="en">Application</label>
      <item>
        <label xml:lang="en">Diagnostic cases</label>
        <item>
          <label xml:lang="en">5 Nested Application</label>
          <item>
            <label xml:lang="en">Care parent</label>
            <item identifierRef="encounter" />
          </item>
        </item>
        <item>
          <label xml:lang="en">6 Candidate A Application</label>
          <item>
            <label xml:lang="en">Care folder</label>
            <item identifierRef="a-care" />
            <item identifierRef="a-encounter" />
          </item>
        </item>
      </item>
      <item identifierRef="care" />
    </item>
    <item>
      <label xml:lang="en">Motivation</label>
      <item identifierRef="driver" />
    </item>
  </organizations>
</model>
