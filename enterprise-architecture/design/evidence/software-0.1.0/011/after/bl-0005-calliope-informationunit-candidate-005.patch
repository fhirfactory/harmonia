@@ -0,0 +1,101 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.util.Objects;
+import net.fhirfactory.harmonia.model.core.naming.Topic;
+
+/**
+ * Describes the container in which an InformationUnit's Content is carried.
+ *
+ * <p>{@code containerConcept} says what the container represents (for
+ * example, a FHIR Bundle or an HL7 v2 batch); {@code containerSchema}
+ * identifies its schema, and {@code containerMediaType} records the IANA media
+ * type identifier used to carry it. All three are required: every container
+ * has a concept, and a container without additional structure uses the
+ * predefined qualified Calliope {@code RAW} Topic, which the factory package supplies
+ * (Draft 002.005 §1.6). These Topics are independent of the IU's own
+ * {@code informationConcept} classification.</p>
+ *
+ * <p>Immutable and safe for concurrent use.</p>
+ */
+public final class ContainerMetadata {
+    private final Topic containerConcept;
+    private final Topic containerSchema;
+    private final String containerMediaType;
+
+    private ContainerMetadata(Topic containerConcept, Topic containerSchema, String containerMediaType) {
+        this.containerConcept = containerConcept;
+        this.containerSchema = containerSchema;
+        this.containerMediaType = containerMediaType;
+    }
+
+    /**
+     * Creates container metadata from an explicit concept, schema and media type.
+     *
+     * @param containerConcept what the container represents
+     * @param containerSchema the container's schema, or the {@code RAW} Topic
+     * @param containerMediaType IANA media type identifier, for example {@code application/fhir+json}
+     * @return an immutable value
+     * @throws InformationModelException {@code MISSING_INPUT} when an argument is null;
+     *         {@code INVALID_INPUT} when the media type is malformed
+     */
+    public static ContainerMetadata of(Topic containerConcept, Topic containerSchema, String containerMediaType) {
+        return new ContainerMetadata(ModelChecks.required(containerConcept, "container.containerConcept"),
+                ModelChecks.required(containerSchema, "container.containerSchema"),
+                ModelChecks.mediaType(containerMediaType, "container.containerMediaType"));
+    }
+
+    /**
+     * Returns what the container represents.
+     *
+     * @return what the container represents
+     */
+    public Topic getContainerConcept() {
+        return containerConcept;
+    }
+
+    /**
+     * Returns the container schema Topic, including its entry versions.
+     *
+     * @return the container schema Topic, including its entry versions
+     */
+    public Topic getContainerSchema() {
+        return containerSchema;
+    }
+
+    /**
+     * Returns the normalised IANA media type identifier for the container.
+     *
+     * @return the normalised IANA media type identifier for the container
+     */
+    public String getContainerMediaType() {
+        return containerMediaType;
+    }
+
+    /** Compares Topics including entry versions, because schema versions are meaningful. */
+    @Override
+    public boolean equals(Object other) {
+        if (this == other) {
+            return true;
+        }
+        if (!(other instanceof ContainerMetadata that)) {
+            return false;
+        }
+        return ModelChecks.sameVersionedTopic(containerConcept, that.containerConcept)
+                && ModelChecks.sameVersionedTopic(containerSchema, that.containerSchema)
+                && containerMediaType.equals(that.containerMediaType);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(containerConcept, containerSchema, containerMediaType);
+    }
+
+    /** Classification Topics only; no Content is reachable from this value. */
+    @Override
+    public String toString() {
+        return "ContainerMetadata{concept=" + containerConcept.getCanonicalNameWithVersion()
+                + ", schema=" + containerSchema.getCanonicalNameWithVersion()
+                + ", mediaType=" + containerMediaType + "}";
+    }
+}
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/Content.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/Content.java
new file mode 100644
index 00000000..dc41e418
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/Content.java
@@ -0,0 +1,127 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.net.URI;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import java.util.Objects;
+import java.util.Optional;
+import net.fhirfactory.harmonia.model.core.information.entity.valuesets.InformationFailureCategory;
+
+/**
+ * One portable Content carrier: either inline bytes or an external locator.
+ *
+ * <p>Draft 002.005 §1.7 requires exactly one of {@code reference} or
+ * {@code data}. The two factories make the "both" and "neither" states
+ * unrepresentable. Calliope preserves supplied bytes exactly and treats a
+ * reference as an opaque locator for externally persisted Content: it never
+ * retrieves, verifies, decodes or manages referenced Content. Generating and
+ * associating provider references belongs to Mneme, Mnemosyne and the
+ * PersistenceService under the governed interaction contract.</p>
+ *
+ * <p>Byte arrays are copied on the way in and on the way out, so a caller can
+ * never change a governed representation by mutating a shared buffer.</p>
+ */
+public final class Content {
+    private final URI reference;
+    private final byte[] data;
+
+    private Content(URI reference, byte[] data) {
+        this.reference = reference;
+        this.data = data;
+    }
+
+    /**
+     * Creates Content carried inline as an exact byte sequence.
+     *
+     * <p>An IU may be constructed with inline Content before any persistence
+     * reference exists.</p>
+     *
+     * @param data bytes to preserve; an empty array is valid Content
+     * @return an immutable defensive snapshot
+     * @throws InformationModelException {@code MISSING_INPUT} when data is null
+     */
+    public static Content inline(byte[] data) {
+        return new Content(null, ModelChecks.required(data, "content.data").clone());
+    }
+
+    /**
+     * Creates inline Content from text, encoded exactly once as UTF-8.
+     *
+     * <p>This is a convenience for text Content; the encoding is a carriage
+     * decision and is not recorded as a schema.</p>
+     *
+     * @param text text to carry
+     * @return inline Content holding the UTF-8 bytes of the text
+     * @throws InformationModelException {@code MISSING_INPUT} when text is null
+     */
+    public static Content inlineText(String text) {
+        return new Content(null, ModelChecks.required(text, "content.data").getBytes(StandardCharsets.UTF_8));
+    }
+
+    /**
+     * Creates Content represented only by a provider-supplied absolute locator.
+     *
+     * @param reference opaque absolute URI for externally persisted Content
+     * @return a reference-only Content value
+     * @throws InformationModelException {@code MISSING_INPUT} for null, {@code INVALID_INPUT}
+     *         for a relative URI
+     */
+    public static Content reference(URI reference) {
+        ModelChecks.required(reference, "content.reference");
+        if (!reference.isAbsolute()) {
+            throw InformationModelException.of(InformationFailureCategory.INVALID_INPUT, "content.reference");
+        }
+        return new Content(reference, null);
+    }
+
+    /**
+     * Returns whether the Content is carried inline.
+     *
+     * @return true for inline data, false for a reference
+     */
+    public boolean isInline() {
+        return data != null;
+    }
+
+    /**
+     * Returns the opaque locator; no remote lookup is performed.
+     *
+     * @return the reference, or empty for inline Content
+     */
+    public Optional<URI> getReference() {
+        return Optional.ofNullable(reference);
+    }
+
+    /**
+     * Returns an independent copy of the inline bytes.
+     *
+     * @return a fresh copy of the data, or empty for reference-only Content
+     */
+    public Optional<byte[]> getData() {
+        return data == null ? Optional.empty() : Optional.of(data.clone());
+    }
+
+    /** Compares the carrier kind and exact bytes or locator. */
+    @Override
+    public boolean equals(Object other) {
+        if (this == other) {
+            return true;
+        }
+        if (!(other instanceof Content content)) {
+            return false;
+        }
+        return Objects.equals(reference, content.reference) && Arrays.equals(data, content.data);
+    }
+
+    @Override
+    public int hashCode() {
+        return 31 * Objects.hashCode(reference) + Arrays.hashCode(data);
+    }
+
+    /** Omits both payload bytes and locator because either may be sensitive. */
+    @Override
+    public String toString() {
+        return "Content{carrier=" + (data == null ? "reference" : "inline") + "}";
+    }
+}
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/ContentDetail.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/ContentDetail.java
new file mode 100644
index 00000000..3898766b
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/ContentDetail.java
@@ -0,0 +1,178 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.time.Duration;
+import java.util.Objects;
+import java.util.Optional;
+
+/**
+ * Optional provider-supplied characteristics of the represented Content.
+ *
+ * <p>Every value is optional because not every value is meaningful for every
+ * Content (a PNG has no duration; an HL7 message has no pages). An empty
+ * instance is the initialised default required by Draft 002.005 §1.</p>
+ *
+ * <p>The content provider supplies {@code size} (in bytes), {@code checksum}
+ * and {@code checksumAlgorithm} for the actual Content bytes - for a
+ * reference, the referenced bytes. Calliope does not compute or verify any
+ * digest and does not parse Content to check dimensions; the PersistenceService
+ * decides how and when verification occurs (§1.7). A checksum and its
+ * algorithm must be supplied together so a digest can never be read under the
+ * wrong algorithm. {@link #DEFAULT_CHECKSUM_ALGORITHM} is the default a
+ * provider uses when it generates a digest; Calliope never silently assigns it
+ * to a caller-supplied checksum.</p>
+ */
+public final class ContentDetail {
+    /** Default digest algorithm for provider-generated checksums. */
+    public static final String DEFAULT_CHECKSUM_ALGORITHM = "SHA-256";
+
+    private static final ContentDetail EMPTY = new ContentDetail(new ContentDetailBuilder());
+
+    private final Long size;
+    private final String language;
+    private final Long height;
+    private final Long width;
+    private final Long frames;
+    private final Duration duration;
+    private final Long pages;
+    private final String checksum;
+    private final String checksumAlgorithm;
+
+    /** Captures an already validated builder state. */
+    ContentDetail(ContentDetailBuilder builder) {
+        this.size = builder.size;
+        this.language = builder.language;
+        this.height = builder.height;
+        this.width = builder.width;
+        this.frames = builder.frames;
+        this.duration = builder.duration;
+        this.pages = builder.pages;
+        this.checksum = builder.checksum;
+        this.checksumAlgorithm = builder.checksumAlgorithm;
+    }
+
+    /**
+     * Returns a new, reusable, caller-confined builder.
+     *
+     * @return an empty builder
+     */
+    public static ContentDetailBuilder builder() {
+        return new ContentDetailBuilder();
+    }
+
+    /**
+     * Returns the empty detail value for Content without known details.
+     *
+     * @return a shared immutable empty instance
+     */
+    public static ContentDetail empty() {
+        return EMPTY;
+    }
+
+    /**
+     * Returns the Content size in bytes, when supplied.
+     *
+     * @return the Content size in bytes, when supplied
+     */
+    public Optional<Long> getSize() {
+        return Optional.ofNullable(size);
+    }
+
+    /**
+     * Returns the BCP-47 language tag, when supplied.
+     *
+     * @return the BCP-47 language tag, when supplied
+     */
+    public Optional<String> getLanguage() {
+        return Optional.ofNullable(language);
+    }
+
+    /**
+     * Returns the pixel height for image or video Content, when supplied.
+     *
+     * @return the pixel height for image or video Content, when supplied
+     */
+    public Optional<Long> getHeight() {
+        return Optional.ofNullable(height);
+    }
+
+    /**
+     * Returns the pixel width for image or video Content, when supplied.
+     *
+     * @return the pixel width for image or video Content, when supplied
+     */
+    public Optional<Long> getWidth() {
+        return Optional.ofNullable(width);
+    }
+
+    /**
+     * Returns the frame count for multi-frame Content, when supplied.
+     *
+     * @return the frame count for multi-frame Content, when supplied
+     */
+    public Optional<Long> getFrames() {
+        return Optional.ofNullable(frames);
+    }
+
+    /**
+     * Returns the playing duration for time-based Content, when supplied.
+     *
+     * @return the playing duration for time-based Content, when supplied
+     */
+    public Optional<Duration> getDuration() {
+        return Optional.ofNullable(duration);
+    }
+
+    /**
+     * Returns the page count for paged Content, when supplied.
+     *
+     * @return the page count for paged Content, when supplied
+     */
+    public Optional<Long> getPages() {
+        return Optional.ofNullable(pages);
+    }
+
+    /**
+     * Returns the provider-supplied digest text, when supplied.
+     *
+     * @return the provider-supplied digest text, when supplied
+     */
+    public Optional<String> getChecksum() {
+        return Optional.ofNullable(checksum);
+    }
+
+    /**
+     * Returns the digest algorithm; present exactly when a checksum is present.
+     *
+     * @return the digest algorithm; present exactly when a checksum is present
+     */
+    public Optional<String> getChecksumAlgorithm() {
+        return Optional.ofNullable(checksumAlgorithm);
+    }
+
+    @Override
+    public boolean equals(Object other) {
+        if (this == other) {
+            return true;
+        }
+        if (!(other instanceof ContentDetail that)) {
+            return false;
+        }
+        return Objects.equals(size, that.size) && Objects.equals(language, that.language)
+                && Objects.equals(height, that.height) && Objects.equals(width, that.width)
+                && Objects.equals(frames, that.frames) && Objects.equals(duration, that.duration)
+                && Objects.equals(pages, that.pages) && Objects.equals(checksum, that.checksum)
+                && Objects.equals(checksumAlgorithm, that.checksumAlgorithm);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(size, language, height, width, frames, duration, pages, checksum, checksumAlgorithm);
+    }
+
+    /** Reports only presence, because payload-derived values can be identifying. */
+    @Override
+    public String toString() {
+        return "ContentDetail{sizePresent=" + (size != null) + ", checksumPresent=" + (checksum != null) + "}";
+    }
+}
