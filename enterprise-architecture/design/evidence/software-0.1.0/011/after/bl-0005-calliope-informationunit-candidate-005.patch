+                .filter(method -> !Set.of("reviseInformationAuthority", "deriveSuccessorAsClone")
+                        .contains(method.getName()))
+                .filter(method -> Arrays.stream(method.getParameterTypes()).anyMatch(protectedTypes::contains))
+                .map(Method::getName)
+                .toList();
