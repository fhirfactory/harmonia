+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+/**
+ * Release-defined builders for governed InformationUnit vocabulary Topics.
+ *
+ * <p>{@link net.fhirfactory.harmonia.model.core.information.entity.factory.InformationVocabulary}
+ * supplies distinct qualified {@code RAW} container and content schemas and
+ * FHIR R4 resource schema Topics using their versioned containment paths. It
+ * also builds generic profile Topics beneath their own governing-standard
+ * paths, without binding a profile to an underlying resource. Media types belong to dedicated metadata
+ * fields and are not built as concepts or schemas. Callers needing other Topics
+ * use the Calliope Naming API directly.</p>
+ *
+ * <p>This package depends on Naming, {@code valuesets} and {@code datatypes};
+ * the root package depends on it, never the reverse.</p>
+ */
+package net.fhirfactory.harmonia.model.core.information.entity.factory;
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/package-info.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/package-info.java
new file mode 100644
index 00000000..8a5c8f8f
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/package-info.java
@@ -0,0 +1,20 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+/**
+ * The Calliope InformationUnit model (BL-0005, Draft 002.007 §1).
+ *
+ * <p>{@link net.fhirfactory.harmonia.model.core.information.entity.InformationUnit}
+ * is Harmonia's atomic, individually governed unit of information, built with
+ * {@link net.fhirfactory.harmonia.model.core.information.entity.InformationUnitBuilder}.
+ * Its two successor operations distinguish a complete clone from a caller-built
+ * minimum-metadata derivation through
+ * {@link net.fhirfactory.harmonia.model.core.information.entity.MinimumMetadataSuccessorBuilder}.
+ * Its constituents live in {@code datatypes}, closed value sets in
+ * {@code valuesets}, and governed vocabulary builders in {@code factory}.</p>
+ *
+ * <p>Package dependencies are one-way:
+ * {@code valuesets <- datatypes <- factory}, and this root package may use all
+ * three. Every package depends only on the JDK and Calliope Naming. The model
+ * is a shared, standalone library: it performs no persistence, caching,
+ * authorisation, reference resolution, routing, logging or serialisation.</p>
+ */
+package net.fhirfactory.harmonia.model.core.information.entity;
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/valuesets/FhirR4ResourceType.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/valuesets/FhirR4ResourceType.java
new file mode 100644
index 00000000..b0aebaa8
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/valuesets/FhirR4ResourceType.java
@@ -0,0 +1,318 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.valuesets;
+
+/**
+ * The 146 concrete resource types defined by HL7 FHIR R4 (version 4.0.1).
+ *
+ * <p>This is the release-defined source for FHIR {@code contentSchema} Topics.
+ * The standard's recognised release designation is {@link #FHIR_R4_RELEASE},
+ * while {@link #FHIR_R4_VERSION} records its specific technical version.
+ * Constant names intentionally deviate from Java's UPPER_SNAKE convention: each
+ * constant's {@link #name()} is exactly the FHIR resource type name, so there
+ * is no hand-maintained mapping table that could drift from the standard. The
+ * list was taken from {@code org.hl7.fhir.r4.model.ResourceType} and excludes
+ * the abstract {@code Resource} and {@code DomainResource} types.</p>
+ *
+ * <p>A resource type identifies schema structure. It does not identify a
+ * serialisation: the same Patient structure may be carried as JSON or XML.</p>
+ */
+public enum FhirR4ResourceType {
+    /** The FHIR R4 {@code Account} resource type. */
+    Account,
+    /** The FHIR R4 {@code ActivityDefinition} resource type. */
+    ActivityDefinition,
+    /** The FHIR R4 {@code AdverseEvent} resource type. */
