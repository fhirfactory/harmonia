+        assertEquals(OptionalLong.of(2), held.getManagedRevision());
+        assertTrue(held.isLegalHold());
+    }
+
+    @Test
+    void activeGenerationIsOpaqueButBounded() {
+        expectFailure(InformationFailureCategory.INVALID_INPUT, "cache.activeGeneration",
