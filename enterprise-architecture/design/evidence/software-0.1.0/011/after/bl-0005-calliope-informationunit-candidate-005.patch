+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/InformationRepresentation.java
@@ -0,0 +1,97 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.util.Objects;
+
+/**
+ * The single governed representation of an InformationUnit.
+ *
+ * <p>Each IU has exactly one representation (Draft 002.005 §1.6). Governed
+ * revisions preserve it, and this class deliberately offers no "with" methods:
+ * a transformation that produces a new representation - even a semantically
+ * equivalent one - must create a new IU with a new UUID and provenance
+ * linking it to its source. Establishing a persistence locator later does not
+ * replace this value either; Mnemosyne records that locator in the single
+ * authoritative association for the IU revision (§2).</p>
+ *
+ * <p>Immutable and safe for concurrent use.</p>
+ */
+public final class InformationRepresentation {
+    private final ContainerMetadata containerMetadata;
+    private final ContentMetadata contentMetadata;
+    private final Content content;
+
+    private InformationRepresentation(ContainerMetadata containerMetadata, ContentMetadata contentMetadata,
+                                      Content content) {
+        this.containerMetadata = containerMetadata;
+        this.contentMetadata = contentMetadata;
+        this.content = content;
+    }
+
+    /**
+     * Creates the governed representation.
+     *
+     * @param containerMetadata container concept and schema
+     * @param contentMetadata content concept, schema and detail
+     * @param content exactly one inline or reference carrier
+     * @return an immutable representation
+     * @throws InformationModelException {@code MISSING_INPUT} when any argument is null
+     */
+    public static InformationRepresentation of(ContainerMetadata containerMetadata,
+                                               ContentMetadata contentMetadata, Content content) {
+        return new InformationRepresentation(
+                ModelChecks.required(containerMetadata, "representation.containerMetadata"),
+                ModelChecks.required(contentMetadata, "representation.contentMetadata"),
+                ModelChecks.required(content, "representation.content"));
+    }
+
+    /**
+     * Returns the container description.
+     *
+     * @return the container description
+     */
+    public ContainerMetadata getContainerMetadata() {
+        return containerMetadata;
+    }
+
+    /**
+     * Returns the Content description.
+     *
+     * @return the Content description
+     */
+    public ContentMetadata getContentMetadata() {
+        return contentMetadata;
+    }
+
+    /**
+     * Returns the Content carrier, which defensively copies inline bytes.
+     *
+     * @return the Content carrier, which defensively copies inline bytes
+     */
+    public Content getContent() {
+        return content;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+        if (this == other) {
+            return true;
+        }
+        if (!(other instanceof InformationRepresentation that)) {
+            return false;
+        }
+        return containerMetadata.equals(that.containerMetadata) && contentMetadata.equals(that.contentMetadata)
+                && content.equals(that.content);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(containerMetadata, contentMetadata, content);
+    }
+
+    /** Delegates to constituents that already omit payload and locator values. */
+    @Override
+    public String toString() {
+        return "InformationRepresentation{" + containerMetadata + ", " + contentMetadata + ", " + content + "}";
+    }
+}
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/InformationUnitRelationship.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/InformationUnitRelationship.java
new file mode 100644
index 00000000..c0331657
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/InformationUnitRelationship.java
@@ -0,0 +1,183 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.net.URI;
+import java.net.URISyntaxException;
+import java.util.Locale;
+import java.util.Objects;
+import java.util.Optional;
+import java.util.UUID;
+import net.fhirfactory.harmonia.model.core.information.entity.valuesets.InformationFailureCategory;
+import net.fhirfactory.harmonia.model.core.information.entity.valuesets.RelationshipRole;
+import net.fhirfactory.harmonia.model.core.information.entity.valuesets.RelationshipType;
+
+/**
+ * One typed semantic link from an InformationUnit to an internal or external target.
+ *
+ * <p>Draft 002.005 §1.4 defines the shape {@code type}, {@code role} and
+ * {@code target : URI}. The target must be an absolute URI, which supports
+ * URN-based persistent identities ({@code urn:uuid:...}, {@code urn:oid:...})
+ * as well as URLs; {@link #getTargetText()} gives its string form and
+ * {@link #parse(RelationshipType, RelationshipRole, String)} reads it back.</p>
+ *
+ * <p>An {@code INTERNAL_IU} target must identify the IU by its UUID, in the
+ * {@code urn:uuid:} form. The IU's classification-derived name
+ * ({@code InformationUnit.getName()}) is a designation, not an identity, and
+ * is rejected as a target. Calliope checks only this local structure. It does
+ * not resolve targets, confirm that a remote target exists, or create
+ * reciprocal links: Mneme validates local references where applicable and
+ * preserves remote references as supplied. These semantic links are also
+ * separate from {@code Content.reference}, which only locates persisted
+ * Content.</p>
+ */
+public final class InformationUnitRelationship {
+    private static final String UUID_URN_PREFIX = "urn:uuid:";
+
+    private final RelationshipType type;
+    private final RelationshipRole role;
+    private final URI target;
+
+    private InformationUnitRelationship(RelationshipType type, RelationshipRole role, URI target) {
+        this.type = type;
+        this.role = role;
+        this.target = target;
+    }
+
+    /**
+     * Creates a relationship to any supported target.
+     *
+     * @param type kind of target
+     * @param role semantic role of the link
+     * @param target absolute target URI; {@code urn:uuid:<uuid>} for {@code INTERNAL_IU}
+     * @return an immutable relationship
+     * @throws InformationModelException {@code MISSING_INPUT} for null arguments;
+     *         {@code INVALID_INPUT} for a relative target or a malformed IU UUID URN
+     */
+    public static InformationUnitRelationship of(RelationshipType type, RelationshipRole role, URI target) {
+        ModelChecks.required(type, "relationship.type");
+        ModelChecks.required(role, "relationship.role");
+        ModelChecks.required(target, "relationship.target");
+        if (!target.isAbsolute()) {
+            throw InformationModelException.of(InformationFailureCategory.INVALID_INPUT, "relationship.target");
+        }
+        if (type == RelationshipType.INTERNAL_IU && uuidOf(target) == null) {
+            throw InformationModelException.of(InformationFailureCategory.INVALID_INPUT, "relationship.target");
+        }
+        return new InformationUnitRelationship(type, role, target);
+    }
+
+    /**
+     * Parses a target from its string form and creates the relationship.
+     *
+     * @param type kind of target
+     * @param role semantic role of the link
+     * @param target absolute URI text
+     * @return an immutable relationship
+     * @throws InformationModelException {@code MISSING_INPUT} for null; {@code INVALID_INPUT} when
+     *         the text is not a URI or violates {@link #of(RelationshipType, RelationshipRole, URI)}
+     */
+    public static InformationUnitRelationship parse(RelationshipType type, RelationshipRole role, String target) {
+        ModelChecks.required(target, "relationship.target");
+        try {
+            return of(type, role, new URI(target));
+        } catch (URISyntaxException malformed) {
+            throw InformationModelException.of(InformationFailureCategory.INVALID_INPUT, "relationship.target");
+        }
+    }
+
+    /**
+     * Creates an {@code INTERNAL_IU} relationship to another IU identified by UUID.
+     *
+     * @param role semantic role of the link
+     * @param informationUnitId the target IU's sole instance identifier
+     * @return a relationship whose target is {@code urn:uuid:<id>}
+     * @throws InformationModelException {@code MISSING_INPUT} for null arguments
+     */
+    public static InformationUnitRelationship toInformationUnit(RelationshipRole role, UUID informationUnitId) {
+        ModelChecks.required(informationUnitId, "relationship.target");
+        return of(RelationshipType.INTERNAL_IU, role, URI.create(UUID_URN_PREFIX + informationUnitId));
+    }
+
+    /**
+     * Returns the kind of target.
+     *
+     * @return the kind of target
+     */
+    public RelationshipType getType() {
+        return type;
+    }
+
+    /**
+     * Returns the semantic role.
+     *
+     * @return the semantic role
+     */
+    public RelationshipRole getRole() {
+        return role;
+    }
+
+    /**
+     * Returns the absolute target URI, preserved as supplied.
+     *
+     * @return the absolute target URI, preserved as supplied
+     */
+    public URI getTarget() {
+        return target;
+    }
+
+    /**
+     * Returns the target's string representation, which {@link #parse} accepts.
+     *
+     * @return the target's string representation, which {@link #parse} accepts
+     */
+    public String getTargetText() {
+        return target.toString();
+    }
+
+    /**
+     * Returns the target IU's UUID for an {@code INTERNAL_IU} relationship.
+     *
+     * @return the UUID, or empty for every other relationship type
+     */
+    public Optional<UUID> getTargetInformationUnitId() {
+        return type == RelationshipType.INTERNAL_IU ? Optional.of(uuidOf(target)) : Optional.empty();
+    }
+
+    @Override
+    public boolean equals(Object other) {
+        if (this == other) {
+            return true;
+        }
+        if (!(other instanceof InformationUnitRelationship that)) {
+            return false;
+        }
+        return type == that.type && role == that.role && target.equals(that.target);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(type, role, target);
+    }
+
+    /** Omits the target, because external locators can identify people or records. */
+    @Override
+    public String toString() {
+        return "InformationUnitRelationship{type=" + type + ", role=" + role + "}";
+    }
+
+    /** Returns the UUID of a well-formed {@code urn:uuid:} URI, or null. */
+    private static UUID uuidOf(URI target) {
+        String text = target.toString();
+        if (text.length() != UUID_URN_PREFIX.length() + 36
+                || !text.substring(0, UUID_URN_PREFIX.length()).toLowerCase(Locale.ROOT).equals(UUID_URN_PREFIX)) {
+            return null;
+        }
+        String candidate = text.substring(UUID_URN_PREFIX.length());
+        try {
+            UUID parsed = UUID.fromString(candidate);
+            return parsed.toString().equalsIgnoreCase(candidate) ? parsed : null;
+        } catch (IllegalArgumentException malformed) {
+            return null;
+        }
+    }
+}
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/ModelChecks.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/ModelChecks.java
new file mode 100644
index 00000000..74b8f385
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/ModelChecks.java
@@ -0,0 +1,172 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.util.Locale;
+import java.util.Objects;
+import java.util.function.BiPredicate;
+import net.fhirfactory.harmonia.model.core.information.entity.valuesets.InformationFailureCategory;
+import net.fhirfactory.harmonia.model.core.information.entity.valuesets.MediaTopLevelType;
+import net.fhirfactory.harmonia.model.core.naming.Topic;
+
+/**
+ * Shared, value-free argument checks for the InformationUnit model.
+ *
+ * <p>Centralising these checks keeps every rejection consistent: the same
+ * category for the same fault, a structural field label, and no echo of the
+ * rejected value. The class is public only so the root and factory packages
+ * can reuse it; it carries no state and is not part of the model contract.</p>
+ */
+public final class ModelChecks {
+    private ModelChecks() {
+    }
+
+    /**
+     * Requires a non-null value.
+     *
+     * @param value value to check
+     * @param field structural label used in the failure
+     * @param <T> value type
+     * @return the same value
+     * @throws InformationModelException with {@code MISSING_INPUT} when null
+     */
+    public static <T> T required(T value, String field) {
+        if (value == null) {
+            throw InformationModelException.of(InformationFailureCategory.MISSING_INPUT, field);
+        }
+        return value;
+    }
+
+    /**
+     * Requires text that is present and not blank.
+     *
+     * @param value text to check
+     * @param field structural label used in the failure
+     * @return the same text, unmodified
+     * @throws InformationModelException {@code MISSING_INPUT} for null, {@code INVALID_INPUT} for blank
+     */
+    public static String requiredText(String value, String field) {
+        required(value, field);
+        if (value.isBlank()) {
+            throw InformationModelException.of(InformationFailureCategory.INVALID_INPUT, field);
+        }
+        return value;
+    }
+
+    /**
+     * Validates and normalises an IANA media type identifier.
+     *
+     * <p>The accepted form is one registered top-level token, a slash, and a
+     * syntactically valid restricted subtype token. Parameters and whitespace
+     * are rejected because this field identifies the media type only, not a
+     * media type plus transport parameters. RFC 6838 limits each name to 127
+     * ASCII characters. This structural check does not claim that a subtype
+     * is currently registered by IANA.</p>
+     *
+     * @param value media type identifier, for example {@code application/fhir+json}
+     * @param field structural label used in failures
+     * @return the identifier normalised to lowercase using {@link Locale#ROOT}
+     * @throws InformationModelException {@code MISSING_INPUT} for null;
+     *         {@code INVALID_INPUT} for malformed, unsupported-top-level or parameterised values
+     */
+    public static String mediaType(String value, String field) {
+        required(value, field);
+        if (value.isBlank()) {
+            throw InformationModelException.of(InformationFailureCategory.INVALID_INPUT, field);
+        }
+        int separator = value.indexOf('/');
+        if (separator <= 0 || separator != value.lastIndexOf('/') || separator == value.length() - 1
+                || separator > 127 || value.length() - separator - 1 > 127) {
+            throw InformationModelException.of(InformationFailureCategory.INVALID_INPUT, field);
+        }
+        String topLevel = value.substring(0, separator);
+        String subtype = value.substring(separator + 1);
+        String normalizedTopLevel = topLevel.toLowerCase(Locale.ROOT);
+        boolean registeredTopLevel = false;
+        for (MediaTopLevelType candidate : MediaTopLevelType.values()) {
+            if (candidate.getToken().equals(normalizedTopLevel)) {
+                registeredTopLevel = true;
+                break;
+            }
+        }
+        if (!registeredTopLevel || !isRestrictedName(topLevel) || !isRestrictedName(subtype)) {
+            throw InformationModelException.of(InformationFailureCategory.INVALID_INPUT, field);
+        }
+        return value.toLowerCase(Locale.ROOT);
+    }
+
+    /** Checks the restricted ASCII name syntax from RFC 6838. */
+    private static boolean isRestrictedName(String name) {
+        if (name.isEmpty() || name.length() > 127 || !isAsciiAlphaNumeric(name.charAt(0))) {
+            return false;
+        }
+        for (int index = 1; index < name.length(); index++) {
+            char character = name.charAt(index);
+            if (!isAsciiAlphaNumeric(character) && character != '!' && character != '#'
+                    && character != '$' && character != '&' && character != '-'
+                    && character != '^' && character != '_' && character != '.' && character != '+') {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    private static boolean isAsciiAlphaNumeric(char character) {
+        return (character >= 'a' && character <= 'z') || (character >= 'A' && character <= 'Z')
+                || (character >= '0' && character <= '9');
+    }
+
+    /**
+     * Compares two optional Topics including entry versions.
+     *
+     * <p>{@link Topic#equals(Object)} deliberately ignores entry versions. Lifetime
+     * rules ("an established value may not change") must not, because a changed
+     * version is a changed fact; they therefore compare the version-capable
+     * canonical form.</p>
+     *
+     * @param left first Topic, may be null
+     * @param right second Topic, may be null
+     * @return true when both are absent or have the same versioned canonical form
+     */
+    public static boolean sameVersionedTopic(Topic left, Topic right) {
+        if (left == null || right == null) {
+            return left == right;
+        }
+        return left.getCanonicalNameWithVersion().equals(right.getCanonicalNameWithVersion());
+    }
+
+    /**
+     * Applies the establish-once rule for a single optional value.
+     *
+     * @param current currently established value, or null when still unknown
+     * @param proposed proposed value, or null to leave unknown
+     * @param same equality used to recognise an idempotent re-statement
+     * @param field structural label used in the failure
+     * @param <T> value type
+     * @return the value to hold after the change
+     * @throws InformationModelException {@code IMMUTABILITY_VIOLATION} when an established value
+     *         would be removed or replaced
+     */
+    public static <T> T establishOnce(T current, T proposed, BiPredicate<T, T> same, String field) {
+        if (current == null) {
+            return proposed;
+        }
+        if (proposed == null || !same.test(current, proposed)) {
+            throw InformationModelException.of(InformationFailureCategory.IMMUTABILITY_VIOLATION, field);
+        }
+        return current;
+    }
+
+    /**
+     * Requires two values to be equal under ordinary value equality.
+     *
+     * @param expected the value that must be preserved
+     * @param actual the proposed value
+     * @param field structural label used in the failure
+     * @throws InformationModelException {@code IMMUTABILITY_VIOLATION} when they differ
+     */
+    public static void unchanged(Object expected, Object actual, String field) {
+        if (!Objects.equals(expected, actual)) {
+            throw InformationModelException.of(InformationFailureCategory.IMMUTABILITY_VIOLATION, field);
+        }
+    }
+}
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/OriginMetadata.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/OriginMetadata.java
new file mode 100644
index 00000000..01fcb89f
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/OriginMetadata.java
@@ -0,0 +1,160 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.time.Instant;
+import java.util.Objects;
+import java.util.Optional;
+import net.fhirfactory.harmonia.model.core.naming.Topic;
+
+/**
+ * Where an InformationUnit originally came from and when it entered Harmonia.
+ *
+ * <p>Draft 002.005 §1.3 records three facts, including for information that
+ * Harmonia generates internally:</p>
+ * <ul>
+ *   <li>{@code sourceSystem} - the original source system;</li>
+ *   <li>{@code entryComponent} - the first Harmonia component it entered;</li>
+ *   <li>{@code entryInstant} - when it entered Harmonia.</li>
+ * </ul>
+ * <p>Each fact may start unknown and may be established once. After that it
+ * is immutable: the {@code establish...} methods accept an idempotent
+ * re-statement of the same value (for Topics, the same versioned canonical
+ * form) and reject any replacement. Entry into Harmonia, source creation,
+ * logical location and derivation are separate facts; routing and itinerary
+ * belong to Pragma/Pragmatosis and are not recorded here.</p>
+ */
+public final class OriginMetadata {
+    private static final OriginMetadata UNKNOWN = new OriginMetadata(null, null, null);
+
+    private final Topic sourceSystem;
+    private final Topic entryComponent;
+    private final Instant entryInstant;
+
+    private OriginMetadata(Topic sourceSystem, Topic entryComponent, Instant entryInstant) {
+        this.sourceSystem = sourceSystem;
+        this.entryComponent = entryComponent;
+        this.entryInstant = entryInstant;
+    }
+
+    /**
+     * Returns the initialised value with every origin fact still unknown.
+     *
+     * @return the initialised value with every origin fact still unknown
+     */
+    public static OriginMetadata unknown() {
+        return UNKNOWN;
+    }
+
+    /**
+     * Establishes the original source system.
+     *
+     * @param sourceSystem source system Topic
+     * @return a new value with the fact established
+     * @throws InformationModelException {@code MISSING_INPUT} when null;
+     *         {@code IMMUTABILITY_VIOLATION} when a different value is already established
+     */
+    public OriginMetadata establishSourceSystem(Topic sourceSystem) {
+        ModelChecks.required(sourceSystem, "origin.sourceSystem");
+        return new OriginMetadata(ModelChecks.establishOnce(this.sourceSystem, sourceSystem,
+                ModelChecks::sameVersionedTopic, "origin.sourceSystem"), entryComponent, entryInstant);
+    }
+
+    /**
+     * Establishes the first Harmonia entry component.
+     *
+     * @param entryComponent entry component Topic
+     * @return a new value with the fact established
+     * @throws InformationModelException {@code MISSING_INPUT} when null;
+     *         {@code IMMUTABILITY_VIOLATION} when a different value is already established
+     */
+    public OriginMetadata establishEntryComponent(Topic entryComponent) {
+        ModelChecks.required(entryComponent, "origin.entryComponent");
+        return new OriginMetadata(sourceSystem, ModelChecks.establishOnce(this.entryComponent, entryComponent,
+                ModelChecks::sameVersionedTopic, "origin.entryComponent"), entryInstant);
+    }
+
+    /**
+     * Establishes the instant of entry into Harmonia.
+     *
+     * @param entryInstant entry instant
+     * @return a new value with the fact established
+     * @throws InformationModelException {@code MISSING_INPUT} when null;
+     *         {@code IMMUTABILITY_VIOLATION} when a different instant is already established
+     */
+    public OriginMetadata establishEntryInstant(Instant entryInstant) {
+        ModelChecks.required(entryInstant, "origin.entryInstant");
+        return new OriginMetadata(sourceSystem, entryComponent, ModelChecks.establishOnce(this.entryInstant,
+                entryInstant, Instant::equals, "origin.entryInstant"));
+    }
+
+    /**
+     * Verifies that a proposed replacement keeps every established fact unchanged.
+     *
+     * <p>Unknown facts may become known in the replacement; known facts may
+     * not be removed or changed.</p>
+     *
+     * @param proposed proposed replacement
+     * @throws InformationModelException {@code MISSING_INPUT} when null;
+     *         {@code IMMUTABILITY_VIOLATION} when an established fact differs
+     */
+    public void requirePreservedBy(OriginMetadata proposed) {
+        ModelChecks.required(proposed, "origin");
+        ModelChecks.establishOnce(sourceSystem, proposed.sourceSystem, ModelChecks::sameVersionedTopic,
+                "origin.sourceSystem");
+        ModelChecks.establishOnce(entryComponent, proposed.entryComponent, ModelChecks::sameVersionedTopic,
+                "origin.entryComponent");
+        ModelChecks.establishOnce(entryInstant, proposed.entryInstant, Instant::equals, "origin.entryInstant");
+    }
+
+    /**
+     * Returns the source system, when established.
+     *
+     * @return the source system, when established
+     */
+    public Optional<Topic> getSourceSystem() {
+        return Optional.ofNullable(sourceSystem);
+    }
+
+    /**
+     * Returns the first Harmonia entry component, when established.
+     *
+     * @return the first Harmonia entry component, when established
+     */
+    public Optional<Topic> getEntryComponent() {
+        return Optional.ofNullable(entryComponent);
+    }
+
+    /**
+     * Returns the Harmonia entry instant, when established.
+     *
+     * @return the Harmonia entry instant, when established
+     */
+    public Optional<Instant> getEntryInstant() {
+        return Optional.ofNullable(entryInstant);
+    }
+
+    @Override
+    public boolean equals(Object other) {
+        if (this == other) {
+            return true;
+        }
+        if (!(other instanceof OriginMetadata that)) {
+            return false;
+        }
+        return ModelChecks.sameVersionedTopic(sourceSystem, that.sourceSystem)
+                && ModelChecks.sameVersionedTopic(entryComponent, that.entryComponent)
+                && Objects.equals(entryInstant, that.entryInstant);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(sourceSystem, entryComponent, entryInstant);
+    }
+
+    /** Reports which facts are established, not their values. */
+    @Override
+    public String toString() {
+        return "OriginMetadata{sourceSystem=" + (sourceSystem != null) + ", entryComponent="
+                + (entryComponent != null) + ", entryInstant=" + (entryInstant != null) + "}";
+    }
+}
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/PersistenceLifecycleMetadata.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/PersistenceLifecycleMetadata.java
new file mode 100644
index 00000000..62568df7
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/PersistenceLifecycleMetadata.java
@@ -0,0 +1,160 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.util.Objects;
+import java.util.Optional;
+import java.util.OptionalLong;
+import net.fhirfactory.harmonia.model.core.information.entity.valuesets.InformationFailureCategory;
+import net.fhirfactory.harmonia.model.core.naming.Topic;
+
+/**
+ * Durable-lifecycle facts that Mnemosyne governs for one IU revision.
+ *
+ * <p>Draft 002.005 §1.2 places three facts here, as a direct constituent of
+ * {@link InformationMetadata}:</p>
+ * <ul>
+ *   <li>{@code managedRevision} - the authoritative Managed Revision that
+ *       Mnemosyne durably established. It is absent until Mnemosyne
+ *       establishes it; callers must never invent it. It is distinct from
+ *       Mneme's operational revision, the cache Active Generation, the Data
+ *       Version, any schema Topic version and any native payload version;</li>
+ *   <li>{@code disposition} - an optional retention/disposition Topic;</li>
+ *   <li>{@code legalHold} - whether a legal hold applies.</li>
+ * </ul>
+ * <p>Calliope only records these facts. It does not decide disposition,
+ * enforce retention, or perform the persistence handshake. Structural rules
+ * enforced here: a Managed Revision is positive and never regresses within a
+ * revision snapshot's history. A local candidate update retains its originating
+ * Managed Revision as the expected revision for the next governed write; only
+ * Mnemosyne establishes the successor number after persistence succeeds.</p>
+ */
+public final class PersistenceLifecycleMetadata {
+    private static final PersistenceLifecycleMetadata NOT_ESTABLISHED =
+            new PersistenceLifecycleMetadata(null, null, false);
+
+    private final Long managedRevision;
+    private final Topic disposition;
+    private final boolean legalHold;
+
+    private PersistenceLifecycleMetadata(Long managedRevision, Topic disposition, boolean legalHold) {
+        this.managedRevision = managedRevision;
+        this.disposition = disposition;
+        this.legalHold = legalHold;
+    }
+
+    /**
+     * Returns the initialised value: no Managed Revision, no disposition, no legal hold.
+     *
+     * @return the initialised value: no Managed Revision, no disposition, no legal hold
+     */
+    public static PersistenceLifecycleMetadata notEstablished() {
+        return NOT_ESTABLISHED;
+    }
+
+    /**
+     * Records the Managed Revision that Mnemosyne actually established.
+     *
+     * @param managedRevision positive revision number, not lower than any current value
+     * @return a new value
+     * @throws InformationModelException {@code INVALID_INPUT} when not positive;
+     *         {@code IMMUTABILITY_VIOLATION} when lower than the current Managed Revision
+     */
+    public PersistenceLifecycleMetadata withManagedRevision(long managedRevision) {
+        if (managedRevision <= 0) {
+            throw InformationModelException.of(InformationFailureCategory.INVALID_INPUT,
+                    "persistence.managedRevision");
+        }
+        if (this.managedRevision != null && managedRevision < this.managedRevision) {
+            throw InformationModelException.of(InformationFailureCategory.IMMUTABILITY_VIOLATION,
+                    "persistence.managedRevision");
+        }
+        return new PersistenceLifecycleMetadata(managedRevision, disposition, legalHold);
+    }
+
+
+    /**
+     * Records the disposition Topic.
+     *
+     * @param disposition disposition Topic, or null to record none
+     * @return a new value
+     */
+    public PersistenceLifecycleMetadata withDisposition(Topic disposition) {
+        return new PersistenceLifecycleMetadata(managedRevision, disposition, legalHold);
+    }
+
+    /**
+     * Records whether a legal hold applies.
+     *
+     * @param legalHold true when a legal hold applies
+     * @return a new value
+     */
+    public PersistenceLifecycleMetadata withLegalHold(boolean legalHold) {
+        return new PersistenceLifecycleMetadata(managedRevision, disposition, legalHold);
+    }
+
+    /**
+     * Verifies that a proposed replacement does not regress the Managed Revision.
+     *
+     * @param proposed proposed replacement
+     * @throws InformationModelException {@code MISSING_INPUT} when null;
+     *         {@code IMMUTABILITY_VIOLATION} when it removes or lowers the Managed Revision
+     */
+    public void requireNoRegressionBy(PersistenceLifecycleMetadata proposed) {
+        ModelChecks.required(proposed, "persistence");
+        if (managedRevision != null
+                && (proposed.managedRevision == null || proposed.managedRevision < managedRevision)) {
+            throw InformationModelException.of(InformationFailureCategory.IMMUTABILITY_VIOLATION,
+                    "persistence.managedRevision");
+        }
+    }
+
+    /**
+     * Returns the established Managed Revision, or empty before Mnemosyne establishes it.
+     *
+     * @return the established Managed Revision, or empty before Mnemosyne establishes it
+     */
+    public OptionalLong getManagedRevision() {
+        return managedRevision == null ? OptionalLong.empty() : OptionalLong.of(managedRevision);
+    }
+
+    /**
+     * Returns the disposition Topic, when recorded.
+     *
+     * @return the disposition Topic, when recorded
+     */
+    public Optional<Topic> getDisposition() {
+        return Optional.ofNullable(disposition);
+    }
+
+    /**
+     * Returns true when a legal hold applies.
+     *
+     * @return true when a legal hold applies
+     */
+    public boolean isLegalHold() {
+        return legalHold;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+        if (this == other) {
+            return true;
+        }
+        if (!(other instanceof PersistenceLifecycleMetadata that)) {
+            return false;
+        }
+        return Objects.equals(managedRevision, that.managedRevision) && legalHold == that.legalHold
+                && ModelChecks.sameVersionedTopic(disposition, that.disposition);
+    }
+
+    @Override
+    public int hashCode() {
+        return Objects.hash(managedRevision, disposition, legalHold);
+    }
+
+    @Override
+    public String toString() {
+        return "PersistenceLifecycleMetadata{managedRevision=" + managedRevision + ", dispositionPresent="
+                + (disposition != null) + ", legalHold=" + legalHold + "}";
+    }
+}
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/Relationships.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/Relationships.java
new file mode 100644
index 00000000..243bdab4
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/Relationships.java
@@ -0,0 +1,94 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.util.ArrayList;
+import java.util.Collection;
+import java.util.List;
+import net.fhirfactory.harmonia.model.core.information.entity.valuesets.InformationFailureCategory;
+
+/**
+ * The optional internal and external semantic links held in InformationMetadata.
+ *
+ * <p>The single ordered {@code relationships} list carries every link type
+ * (Draft 002.005 §1.4). It may be empty, which is the initialised default.
+ * The creator or an authorised updater may supply or change links; Calliope
+ * expresses that as a new immutable value and leaves authorisation to the
+ * calling Harmonia component. Order is preserved and duplicates are kept as
+ * supplied, because the model does not interpret relationship meaning.</p>
+ */
+public final class Relationships {
+    private static final Relationships NONE = new Relationships(List.of());
+
+    private final List<InformationUnitRelationship> relationships;
+
+    private Relationships(List<InformationUnitRelationship> relationships) {
+        this.relationships = relationships;
+    }
+
+    /**
+     * Returns the initialised empty value.
+     *
+     * @return the initialised empty value
+     */
+    public static Relationships none() {
+        return NONE;
+    }
+
+    /**
+     * Creates an independent snapshot of the supplied links.
+     *
+     * @param relationships ordered links; may be empty, must not contain null
+     * @return an immutable value unaffected by later changes to the supplied collection
+     * @throws InformationModelException {@code MISSING_INPUT} for a null collection or element
+     */
+    public static Relationships of(Collection<InformationUnitRelationship> relationships) {
+        ModelChecks.required(relationships, "relationships");
+        List<InformationUnitRelationship> copy = new ArrayList<>(relationships.size());
+        for (InformationUnitRelationship relationship : relationships) {
+            if (relationship == null) {
+                throw InformationModelException.of(InformationFailureCategory.MISSING_INPUT, "relationships");
+            }
+            copy.add(relationship);
+        }
+        return new Relationships(List.copyOf(copy));
+    }
+
+    /**
+     * Returns a new value with one link appended.
+     *
+     * @param relationship link to append
+     * @return a new value; this value is unchanged
+     * @throws InformationModelException {@code MISSING_INPUT} when null
+     */
+    public Relationships with(InformationUnitRelationship relationship) {
+        ModelChecks.required(relationship, "relationships");
+        List<InformationUnitRelationship> copy = new ArrayList<>(relationships);
+        copy.add(relationship);
+        return new Relationships(List.copyOf(copy));
+    }
+
+    /**
+     * Returns the unmodifiable ordered list of links.
+     *
+     * @return the unmodifiable ordered list of links
+     */
+    public List<InformationUnitRelationship> getRelationships() {
+        return relationships;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+        return this == other || other instanceof Relationships that && relationships.equals(that.relationships);
+    }
+
+    @Override
+    public int hashCode() {
+        return relationships.hashCode();
+    }
+
+    /** Shows the count only; targets can be sensitive. */
+    @Override
+    public String toString() {
+        return "Relationships{count=" + relationships.size() + "}";
+    }
+}
diff --git a/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/SecurityMetadata.java b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/SecurityMetadata.java
new file mode 100644
index 00000000..34aded40
--- /dev/null
+++ b/calliope/src/main/java/net/fhirfactory/harmonia/model/core/information/entity/datatypes/SecurityMetadata.java
@@ -0,0 +1,156 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.information.entity.datatypes;
+
+import java.util.Collection;
+import java.util.Collections;
+import java.util.NavigableSet;
+import java.util.Set;
+import java.util.TreeSet;
+import net.fhirfactory.harmonia.model.core.information.entity.valuesets.InformationFailureCategory;
+import net.fhirfactory.harmonia.model.core.naming.Topic;
+
+/**
+ * The security requirements that travel with an InformationUnit.
+ *
+ * <p>Each requirement is a qualified Topic naming a security criterion (for
+ * example a sensitivity or handling label). Calliope stores and carries these
+ * requirements without deciding their policy meaning. Themis-Krites is the
+ * external authority that adjudicates every proposed change, including
+ * strengthening, weakening and replacement. This value is immutable, but it
+ * does not impose an add-only lifecycle rule (Draft 002.005 §1.4).</p>
+ *
+ * <p>Security requirements are independent of coordinates and of quality.
+ * An empty set is the initialised default and means "no IU-specific
+ * requirement recorded", not "unrestricted": the default-deny decision still
+ * belongs to Themis.</p>
+ */
+public final class SecurityMetadata {
+    private static final SecurityMetadata NONE = new SecurityMetadata(Collections.emptyNavigableSet());
+
+    private final NavigableSet<Topic> requirements;
+
+    private SecurityMetadata(NavigableSet<Topic> requirements) {
+        this.requirements = requirements;
+    }
+
+    /**
+     * Returns the initialised value with no recorded requirements.
+     *
+     * @return the initialised value with no recorded requirements
+     */
+    public static SecurityMetadata none() {
+        return NONE;
+    }
+
+    /**
+     * Creates security metadata from a collection of requirement Topics.
+     *
+     * @param requirements requirement Topics; may be empty, no null elements
+     * @return an immutable value independent of the supplied collection
+     * @throws InformationModelException {@code MISSING_INPUT} for null input or element;
+     *         {@code INCONSISTENT_INPUT} when the same requirement appears with different versions
+     */
+    public static SecurityMetadata of(Collection<Topic> requirements) {
+        ModelChecks.required(requirements, "security.requirements");
+        return NONE.withAdded(requirements);
+    }
+
+    /**
+     * Returns a new proposal containing these requirements plus the additional ones.
+     *
+     * <p>Re-stating an existing requirement with the same entry versions is a
+     * no-op. A second version of the same Topic identity in one value is
+     * structurally ambiguous and is rejected; replacement should be expressed
+     * as a separate proposed value for Krites to adjudicate.</p>
+     *
+     * @param additional requirement Topics to add
+     * @return a new immutable proposal; this value is unchanged
+     * @throws InformationModelException {@code MISSING_INPUT} for null input or element;
+     *         {@code INCONSISTENT_INPUT} for a conflicting version of an existing requirement
+     */
+    public SecurityMetadata withAdded(Collection<Topic> additional) {
+        ModelChecks.required(additional, "security.requirements");
+        TreeSet<Topic> combined = new TreeSet<>(requirements);
+        for (Topic requirement : additional) {
+            ModelChecks.required(requirement, "security.requirements");
+            Topic existing = combined.ceiling(requirement);
+            if (existing != null && existing.equals(requirement)) {
+                if (!ModelChecks.sameVersionedTopic(existing, requirement)) {
+                    throw InformationModelException.of(InformationFailureCategory.INCONSISTENT_INPUT,
+                            "security.requirements");
+                }
+            } else {
+                combined.add(requirement);
+            }
+        }
+        return new SecurityMetadata(Collections.unmodifiableNavigableSet(combined));
+    }
+
+    /**
+     * Returns a new proposal with the specified existing requirements removed.
+     *
+     * <p>This operation does not determine whether removal is permitted. The
+     * caller must submit the resulting proposal to Themis-Krites for
+     * adjudication. Each target must match both Topic identity and its entry
+     * versions when the target identity exists, so an accidental version
+     * mismatch cannot silently remove a different requirement.</p>
+     *
+     * @param removed requirements to remove
+     * @return a new immutable proposal; this value is unchanged
+     * @throws InformationModelException {@code MISSING_INPUT} for null input or element;
+     *         {@code INCONSISTENT_INPUT} when a target has the same identity but a different version
+     */
+    public SecurityMetadata withRemoved(Collection<Topic> removed) {
+        ModelChecks.required(removed, "security.requirements");
+        TreeSet<Topic> remaining = new TreeSet<>(requirements);
+        for (Topic requirement : removed) {
+            ModelChecks.required(requirement, "security.requirements");
+            Topic existing = remaining.ceiling(requirement);
+            if (existing != null && existing.equals(requirement)) {
+                if (!ModelChecks.sameVersionedTopic(existing, requirement)) {
+                    throw InformationModelException.of(InformationFailureCategory.INCONSISTENT_INPUT,
+                            "security.requirements");
+                }
+                remaining.remove(existing);
+            }
+        }
+        return new SecurityMetadata(Collections.unmodifiableNavigableSet(remaining));
+    }
+
+    /**
+     * Returns the unmodifiable, ordered set of requirement Topics.
+     *
+     * @return the unmodifiable, ordered set of requirement Topics
+     */
+    public Set<Topic> getRequirements() {
+        return requirements;
+    }
+
+    @Override
+    public boolean equals(Object other) {
+        if (this == other) {
+            return true;
+        }
+        if (!(other instanceof SecurityMetadata that) || requirements.size() != that.requirements.size()) {
+            return false;
+        }
+        for (Topic requirement : requirements) {
+            Topic counterpart = that.requirements.contains(requirement) ? that.requirements.ceiling(requirement) : null;
+            if (!ModelChecks.sameVersionedTopic(requirement, counterpart)) {
+                return false;
+            }
+        }
+        return true;
+    }
+
+    @Override
+    public int hashCode() {
+        return requirements.hashCode();
+    }
+
+    /** Shows the count only; requirement labels can reveal sensitivity. */
+    @Override
+    public String toString() {
+        return "SecurityMetadata{requirements=" + requirements.size() + "}";
+    }
+}
