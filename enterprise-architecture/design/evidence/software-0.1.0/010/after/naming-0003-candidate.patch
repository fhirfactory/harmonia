+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming;
+
+import net.fhirfactory.harmonia.model.core.naming.datatypes.NamingDiagnostic;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.DiagnosticSeverity;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.MatchExitCategory;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFieldKind;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingOperation;
+
+/**
+ * Performs the accepted short-circuit positional evaluation for ordinary and
+ * universal masks.
+ *
+ * <p>Each ordinary entry invokes at most three full-field checks, so the
+ * accepted depth bound limits one comparison to 48 checks. Unexpected matcher
+ * failures return false; diagnostic delivery is isolated from that result.</p>
+ */
+final class MaskEvaluator {
+
+    private MaskEvaluator() {
+        throw new AssertionError("No instances");
+    }
+
+    /** Evaluates a candidate once and reports a safe final exit record to its local sink. */
+    static boolean evaluate(
+            TopicMask mask,
+            Topic candidate,
+            MatchDiagnosticSink sink,
+            FieldEvaluator evaluator) {
+        int depth = candidate == null ? 0 : candidate.getDepth();
+        if (candidate == null) {
+            emit(sink, DiagnosticSeverity.TRACE, MatchExitCategory.NULL_CANDIDATE,
+                    depth, null, NamingFieldKind.NONE);
+            return false;
+        }
+        if (mask == null) {
+            emit(sink, DiagnosticSeverity.ERROR, MatchExitCategory.EVALUATION_ERROR,
+                    depth, null, NamingFieldKind.NONE);
+            return false;
+        }
+        if (!mask.isOrdinary()) {
+            emit(sink, DiagnosticSeverity.TRACE, MatchExitCategory.UNIVERSAL_MATCH,
+                    depth, null, NamingFieldKind.NONE);
+            return true;
+        }
+        int requiredDepth = mask.getEntries().size();
+        if (depth < requiredDepth || (!mask.getContainmentFlag() && depth != requiredDepth)) {
+            emit(sink, DiagnosticSeverity.TRACE, MatchExitCategory.DEPTH_MISMATCH,
+                    depth, null, NamingFieldKind.DEPTH);
+            return false;
+        }
+        for (int index = 0; index < requiredDepth; index++) {
+            TopicEntry candidateEntry = candidate.getEntries().get(index);
+            TopicMaskEntry criterion = mask.getEntries().get(index);
+            if (!evaluateField(criterion, candidateEntry.getQualifier(), evaluator,
+                    MatchExitCategory.QUALIFIER_MISMATCH, NamingFieldKind.QUALIFIER_REGEX,
+                    depth, index, sink)) {
+                return false;
+            }
+            if (!evaluateField(criterion, candidateEntry.getValue(), evaluator,
+                    MatchExitCategory.VALUE_MISMATCH, NamingFieldKind.VALUE_REGEX,
+                    depth, index, sink)) {
+                return false;
+            }
+            if (criterion.hasVersionConstraint()) {
+                String version = candidateEntry.getVersion().orElse(null);
+                if (version == null) {
+                    emit(sink, DiagnosticSeverity.TRACE, MatchExitCategory.REQUIRED_VERSION_ABSENT,
+                            depth, index, NamingFieldKind.VERSION_REGEX);
+                    return false;
+                }
+                if (!evaluateField(criterion, version, evaluator,
+                        MatchExitCategory.VERSION_MISMATCH, NamingFieldKind.VERSION_REGEX,
+                        depth, index, sink)) {
+                    return false;
+                }
+            }
+        }
+        int lastIndex = requiredDepth - 1;
+        NamingFieldKind lastField = mask.getEntries().get(lastIndex).hasVersionConstraint()
+                ? NamingFieldKind.VERSION_REGEX : NamingFieldKind.VALUE_REGEX;
+        emit(sink, DiagnosticSeverity.TRACE, MatchExitCategory.MATCH,
+                depth, lastIndex, lastField);
+        return true;
+    }
+
+    /** Runs one field check and converts runtime failures into a fail-closed exit. */
+    private static boolean evaluateField(
+            TopicMaskEntry criterion,
+            String value,
+            FieldEvaluator evaluator,
+            MatchExitCategory mismatch,
+            NamingFieldKind field,
+            int depth,
+            int index,
+            MatchDiagnosticSink sink) {
+        try {
+            boolean matches = switch (field) {
+                case QUALIFIER_REGEX -> criterion.matchesQualifier(value, evaluator);
+                case VALUE_REGEX -> criterion.matchesValue(value, evaluator);
+                case VERSION_REGEX -> criterion.matchesVersion(value, evaluator);
+                default -> false;
+            };
+            if (!matches) {
+                emit(sink, DiagnosticSeverity.TRACE, mismatch, depth, index, field);
+            }
+            return matches;
+        } catch (RuntimeException exception) {
+            emit(sink, DiagnosticSeverity.ERROR, MatchExitCategory.EVALUATION_ERROR,
+                    depth, index, field);
+            return false;
+        }
+    }
+
+    /** Delivers bounded metadata while containing failures from the diagnostic consumer. */
+    private static void emit(
+            MatchDiagnosticSink sink,
+            DiagnosticSeverity severity,
+            MatchExitCategory category,
+            int depth,
+            Integer index,
+            NamingFieldKind field) {
+        if (sink == null) {
+            return;
+        }
+        try {
+            sink.accept(new NamingDiagnostic(severity, category,
+                    NamingOperation.MASK_MATCH, depth, index, field));
+        } catch (RuntimeException ignored) {
+            // A diagnostic failure cannot change the comparison outcome.
+        }
+    }
+}
