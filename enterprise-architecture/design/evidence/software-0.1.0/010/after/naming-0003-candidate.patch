+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming;
+
+import com.google.re2j.Pattern;
+import java.util.Objects;
+import java.util.Optional;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFailureCategory;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFieldKind;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingOperation;
+
+/**
+ * One immutable positional criterion with construction-time compiled RE2/J patterns.
+ *
+ * <p>Expressions use the pinned RE2/J dialect, including supported inline
+ * flags, and are evaluated as full-field matches. Backreferences and
+ * look-around are not supported, and Java RegEx fallback is not used. Original
+ * expressions remain the logical data for equality and interchange. Compiled
+ * Patterns are immutable and shared; each match call creates its own mutable
+ * matcher state.</p>
+ */
+public final class TopicMaskEntry {
+    private final String qualifierRegex;
+    private final String valueRegex;
+    private final String versionRegex;
+    private final Pattern qualifierPattern;
+    private final Pattern valuePattern;
+    private final Pattern versionPattern;
+
+    private TopicMaskEntry(
+            String qualifierRegex,
+            String valueRegex,
+            String versionRegex,
+            Pattern qualifierPattern,
+            Pattern valuePattern,
+            Pattern versionPattern) {
+        this.qualifierRegex = qualifierRegex;
+        this.valueRegex = valueRegex;
+        this.versionRegex = versionRegex;
+        this.qualifierPattern = qualifierPattern;
+        this.valuePattern = valuePattern;
+        this.versionPattern = versionPattern;
+    }
+
+    /** Validates original expressions and compiles each present field exactly once. */
+    static TopicMaskEntry create(
+            String qualifierRegex,
+            String valueRegex,
+            String versionRegex,
+            NamingOperation operation,
+            Integer index) {
+        if (qualifierRegex == null || valueRegex == null) {
+            throw TopicFieldRules.failure(NamingFailureCategory.MISSING_INPUT,
+                    operation, qualifierRegex == null ? NamingFieldKind.QUALIFIER_REGEX
+                            : NamingFieldKind.VALUE_REGEX, index);
+        }
+        Pattern qualifierPattern = ExpressionSafeguard.compile(qualifierRegex,
+                NamingFieldKind.QUALIFIER_REGEX, operation, index);
+        Pattern valuePattern = ExpressionSafeguard.compile(valueRegex,
+                NamingFieldKind.VALUE_REGEX, operation, index);
+        Pattern versionPattern = versionRegex == null ? null : ExpressionSafeguard.compile(
+                versionRegex, NamingFieldKind.VERSION_REGEX, operation, index);
+        return new TopicMaskEntry(qualifierRegex, valueRegex, versionRegex,
+                qualifierPattern, valuePattern, versionPattern);
+    }
+
+    /**
+     * Creates a criterion whose version is unconstrained.
+     *
+     * @param qualifierRegex expression applied to the complete qualifier
+     * @param valueRegex expression applied to the complete value
+     * @return an immutable criterion with compiled RE2/J patterns
+     * @throws NamingValidationException when an expression is invalid or exceeds a bound
+     */
+    public static TopicMaskEntry of(String qualifierRegex, String valueRegex) {
+        return create(qualifierRegex, valueRegex, null, NamingOperation.MASK_BUILD, null);
+    }
+
+    /**
+     * Creates a criterion with a present version expression, including empty.
+     *
+     * @param qualifierRegex expression applied to the complete qualifier
+     * @param valueRegex expression applied to the complete value
+     * @param versionRegex expression applied when the candidate version is present
+     * @return an immutable criterion with compiled RE2/J patterns
+     * @throws NamingValidationException when an expression is invalid or exceeds a bound
+     */
+    public static TopicMaskEntry of(
+            String qualifierRegex,
+            String valueRegex,
+            String versionRegex) {
+        return create(qualifierRegex, valueRegex, versionRegex, NamingOperation.MASK_BUILD, null);
+    }
+
+    /**
+     * Creates a criterion matching any qualifier and the supplied value expression.
+     *
+     * @param valueRegex expression applied to the complete value
+     * @return an immutable criterion with a {@code .*} qualifier expression
+     * @throws NamingValidationException when the expression is invalid or exceeds a bound
+     */
+    public static TopicMaskEntry forValue(String valueRegex) {
+        return of(".*", valueRegex);
+    }
+
+    /**
+     * Creates a criterion matching the supplied qualifier expression and any value.
+     *
+     * @param qualifierRegex expression applied to the complete qualifier
+     * @return an immutable criterion with a {@code .*} value expression
+     * @throws NamingValidationException when the expression is invalid or exceeds a bound
+     */
+    public static TopicMaskEntry forQualifier(String qualifierRegex) {
+        return of(qualifierRegex, ".*");
+    }
+
+    /** Creates an immutable criterion whose qualifier and value each match any complete field. */
+    public static TopicMaskEntry any() {
+        return of(".*", ".*");
+    }
+
+    /**
+     * Creates a criterion matching validated literal qualifier and value fields.
+     *
+     * @param qualifier nonempty valid Topic qualifier literal
+     * @param value nonempty valid Topic value literal
+     * @return an immutable criterion whose literals are quoted for RE2/J
+     * @throws NamingValidationException when either literal or its quoted expression is rejected
+     */
+    public static TopicMaskEntry ofLiterals(String qualifier, String value) {
+        validateLiterals(qualifier, value, null, false);
+        return of(Pattern.quote(qualifier), Pattern.quote(value));
+    }
+
+    /**
+     * Creates a criterion matching validated literal fields including a required version.
+     *
+     * @param qualifier nonempty valid Topic qualifier literal
+     * @param value nonempty valid Topic value literal
+     * @param version nonempty valid Topic version literal
+     * @return an immutable criterion whose literals are quoted for RE2/J
+     * @throws NamingValidationException when a literal or its quoted expression is rejected
+     */
+    public static TopicMaskEntry ofLiterals(String qualifier, String value, String version) {
+        validateLiterals(qualifier, value, version, true);
+        return of(Pattern.quote(qualifier), Pattern.quote(value), Pattern.quote(version));
+    }
+
+    /**
+     * Creates a criterion matching a literal value while leaving qualifier unrestricted.
+     *
+     * @param value nonempty valid Topic value literal
+     * @return an immutable criterion with a quoted value expression
+     * @throws NamingValidationException when the literal or quoted expression is rejected
+     */
+    public static TopicMaskEntry forLiteralValue(String value) {
+        TopicFieldRules.validateValue(value, NamingOperation.MASK_BUILD, null);
+        return of(".*", Pattern.quote(value));
+    }
+
+    /**
+     * Creates a criterion matching a literal qualifier while leaving value unrestricted.
+     *
+     * @param qualifier nonempty valid Topic qualifier literal
+     * @return an immutable criterion with a quoted qualifier expression
+     * @throws NamingValidationException when the literal or quoted expression is rejected
+     */
+    public static TopicMaskEntry forLiteralQualifier(String qualifier) {
+        TopicFieldRules.validateQualifierInput(qualifier, false, NamingOperation.MASK_BUILD, null);
+        return of(Pattern.quote(qualifier), ".*");
+    }
+
+    /** Returns the original qualifier expression, not a normalized or compiled rendering. */
+    public String getQualifierRegex() {
+        return qualifierRegex;
+    }
+
+    /** Returns the original value expression, not a normalized or compiled rendering. */
+    public String getValueRegex() {
+        return valueRegex;
+    }
+
+    /** Returns the original optional version expression, preserving present-empty. */
+    public Optional<String> getVersionRegex() {
+        return Optional.ofNullable(versionRegex);
+    }
+
+    /** Performs a full-field qualifier check through the supplied local evaluator seam. */
+    boolean matchesQualifier(String value, FieldEvaluator evaluator) {
+        return evaluator.matches(qualifierPattern, value);
+    }
+
+    /** Performs a full-field value check through the supplied local evaluator seam. */
+    boolean matchesValue(String value, FieldEvaluator evaluator) {
+        return evaluator.matches(valuePattern, value);
+    }
+
+    /** Performs a full-field version check through the supplied local evaluator seam. */
+    boolean matchesVersion(String value, FieldEvaluator evaluator) {
+        return evaluator.matches(versionPattern, value);
+    }
+
+    /** Distinguishes absent version criteria from a present-empty expression. */
+    boolean hasVersionConstraint() {
+        return versionRegex != null;
+    }
+
+    /** Validates source literals before quoting so invalid field data cannot enter an expression. */
+    private static void validateLiterals(
+            String qualifier,
+            String value,
+            String version,
+            boolean requireVersion) {
+        TopicFieldRules.validateTopicCompletedFields(qualifier, value, version,
+                NamingOperation.MASK_BUILD, null);
+        if (requireVersion && (version == null || version.isEmpty())) {
+            throw TopicFieldRules.failure(version == null ? NamingFailureCategory.MISSING_INPUT
+                            : NamingFailureCategory.INVALID_FIELD,
+                    NamingOperation.MASK_BUILD, NamingFieldKind.VERSION, null);
+        }
+    }
+
+    /** Compares original expressions and optional version presence, not compiled Pattern identity. */
+    @Override
+    public boolean equals(Object other) {
+        if (this == other) {
+            return true;
+        }
+        if (!(other instanceof TopicMaskEntry entry)) {
+            return false;
+        }
+        return qualifierRegex.equals(entry.qualifierRegex)
+                && valueRegex.equals(entry.valueRegex)
+                && Objects.equals(versionRegex, entry.versionRegex);
+    }
+
+    /** Hashes the original expressions and optional version presence used by {@link #equals(Object)}. */
+    @Override
+    public int hashCode() {
+        return Objects.hash(qualifierRegex, valueRegex, versionRegex);
+    }
+}
