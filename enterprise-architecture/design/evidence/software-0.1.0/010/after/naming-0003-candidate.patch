+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFailureCategory;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingLimits;
+import org.junit.jupiter.api.Test;
+
+/** Covers the qualified lexical guards and bounded RE2/J expression contract. */
+class ExpressionSafeguardTest {
+
+    @Test
+    void activeGroupDepthAndCountedBoundsAreGuarded() {
+        String sixteenGroups = "(".repeat(NamingLimits.MAX_REGEX_GROUP_DEPTH)
+                + "a" + ")".repeat(NamingLimits.MAX_REGEX_GROUP_DEPTH);
+        assertEquals(sixteenGroups, TopicMaskEntry.of(sixteenGroups, ".*").getQualifierRegex());
+
+        String seventeenGroups = "(".repeat(NamingLimits.MAX_REGEX_GROUP_DEPTH + 1)
+                + "a" + ")".repeat(NamingLimits.MAX_REGEX_GROUP_DEPTH + 1);
+        assertLimit(() -> TopicMaskEntry.of(seventeenGroups, ".*"));
+        assertEquals("a{256}", TopicMaskEntry.of("a{256}", ".*").getQualifierRegex());
+        assertLimit(() -> TopicMaskEntry.of("a{257}", ".*"));
+        assertLimit(() -> TopicMaskEntry.of("a{256}b{256}", ".*"));
+        assertLimit(() -> TopicMaskEntry.of("(abcd|efgh){256}", ".*"));
+    }
+
+    @Test
+    void escapedQuotedAndCharacterClassTextIsNotTreatedAsActiveSyntax() {
+        assertEquals("[{}]", TopicMaskEntry.of("[{}]", ".*").getQualifierRegex());
+        assertEquals("\\Q(a{999})\\E",
+                TopicMaskEntry.of("\\Q(a{999})\\E", ".*").getQualifierRegex());
+        assertEquals("\\(a\\)", TopicMaskEntry.of("\\(a\\)", ".*").getQualifierRegex());
+    }
+
+    @Test
+    void unsupportedEngineSyntaxAndOverlongExpressionsFailSafely() {
+        NamingValidationException unsupported = assertThrows(NamingValidationException.class,
+                () -> TopicMaskEntry.of("(?=A)A", ".*"));
+        assertEquals(NamingFailureCategory.EXPRESSION_REJECTED, unsupported.getCategory());
+        assertTrue(unsupported.getCause() == null);
+        assertTrue(!unsupported.getMessage().contains("(?=A)"));
+        assertLimit(() -> TopicMaskEntry.of("a".repeat(NamingLimits.MAX_EXPRESSION_CODE_POINTS + 1), ".*"));
+        assertEquals(NamingLimits.MAX_EXPRESSION_CODE_POINTS,
+                TopicMaskEntry.of("a".repeat(NamingLimits.MAX_EXPRESSION_CODE_POINTS), ".*")
+                        .getQualifierRegex().length());
+    }
+
+    private static void assertLimit(Runnable operation) {
+        NamingValidationException exception = assertThrows(NamingValidationException.class, operation::run);
+        assertEquals(NamingFailureCategory.LIMIT_EXCEEDED, exception.getCategory());
+    }
+}
