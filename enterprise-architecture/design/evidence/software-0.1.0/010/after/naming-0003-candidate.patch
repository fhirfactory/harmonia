+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming;
+
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertNotEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.concurrent.Callable;
+import java.util.concurrent.ExecutorService;
+import java.util.concurrent.Executors;
+import java.util.concurrent.Future;
+import java.util.concurrent.TimeUnit;
+import java.util.concurrent.atomic.AtomicInteger;
+import net.fhirfactory.harmonia.model.core.naming.datatypes.NamingDiagnostic;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.DiagnosticSeverity;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.MatchExitCategory;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingLimits;
+import org.junit.jupiter.api.Test;
+
+/** Verifies TopicMask kinds, structural expressions, evaluation, and local diagnostics. */
+class TopicMaskTest {
+
+    @Test
+    void ordinaryMaskUsesPositionFullFieldAndTrailingContainmentRules() {
+        Topic topic = Topic.builder().addEntry("System", "Harmonia")
+                .addEntry("Component", "Petasos.Receiver")
+                .addEntry("Action", "Delivered").build();
+        TopicMask exact = TopicMask.builder().addRegex("System", "Harmonia")
+                .addRegex("Component", "Petasos\\.Receiver").build();
+        TopicMask inclusive = TopicMask.builder().addRegex("System", "Harmonia")
+                .addRegex("Component", "Petasos\\.Receiver")
+                .includeContainedElements(true).build();
+
+        assertFalse(exact.matches(topic));
+        assertTrue(inclusive.matches(topic));
+        assertFalse(TopicMask.builder().addRegex("System", "Harmonia")
+                .addRegex("Component", "Receiver").includeContainedElements(true).build().matches(topic));
+        assertTrue(TopicMask.builder().addRegex("(?i:system)", "Harmonia")
+                .includeContainedElements(true).build().matches(topic));
+        assertFalse(TopicMask.builder().addRegex("system", "Harmonia")
+                .includeContainedElements(true).build().matches(topic));
+        assertFalse(exact.matches(null));
+        assertThrows(NamingValidationException.class, () -> TopicMask.builder().build());
+    }
+
+    @Test
+    void versionConstraintDistinguishesAbsentPresentEmptyAndWildcard() {
+        Topic absent = Topic.builder().addEntry("Role", "LAB").build();
+        Topic present = Topic.builder().addEntry("Role", "LAB", "v1").build();
+        TopicMask unconstrained = TopicMask.builder().add(TopicMaskEntry.of("Role", "LAB")).build();
+        TopicMask presentEmpty = TopicMask.builder().addRegex("Role", "LAB", "").build();
+        TopicMask wildcard = TopicMask.builder().addRegex("Role", "LAB", ".*").build();
+        List<NamingDiagnostic> events = new ArrayList<>();
+
+        assertEquals(absent, present);
+        assertTrue(unconstrained.matches(absent));
+        assertTrue(unconstrained.matches(present));
+        assertFalse(presentEmpty.matches(absent, events::add));
+        assertEquals(MatchExitCategory.REQUIRED_VERSION_ABSENT, events.get(0).category());
+        events.clear();
+        assertFalse(presentEmpty.matches(present, events::add));
+        assertEquals(MatchExitCategory.VERSION_MISMATCH, events.get(0).category());
+        assertTrue(wildcard.matches(present));
+        assertFalse(wildcard.matches(absent));
+        assertTrue(TopicMask.builder().addRegex("Role", "LAB", "v1").build().matches(present));
+        assertFalse(TopicMask.builder().addRegex("Role", "LAB", "v1").build().matches(absent));
+        assertNotEquals(TopicMaskEntry.of("Role", "LAB"), TopicMaskEntry.of("Role", "LAB", ""));
+    }
+
+    @Test
+    void canonicalMaskRoundTripPreservesOuterEscapesAndEmptyExpressions() {
+        TopicMask original = TopicMask.builder()
+                .addRegex("(?i:Zone)", "A.B", "2\\.4")
+                .addRegex("", "")
+                .includeContainedElements(true)
+                .build();
+
+        TopicMask decoded = TopicMask.fromCanonicalExpression(
+                original.getCanonicalExpression(), original.isIncludeContainedElements());
+        TopicMask presentEmptyVersion = TopicMask.fromCanonicalExpression("Role:=LAB", false);
+        TopicMask emptyExpressions = TopicMask.fromCanonicalExpression("=", false);
+
+        assertEquals(original, decoded);
+        assertEquals(original.hashCode(), decoded.hashCode());
+        assertEquals(original.getCanonicalExpression(), decoded.getCanonicalExpression());
+        assertEquals("", presentEmptyVersion.getEntries().get(0).getVersionRegex().orElseThrow());
+        assertEquals("=", emptyExpressions.getCanonicalExpression());
+        assertFalse(emptyExpressions.matches(Topic.builder().addEntry("Role", "LAB").build()));
+        assertThrows(NamingValidationException.class,
+                () -> TopicMask.fromCanonicalExpression("Role=LAB\\q", false));
+    }
+
+    @Test
+    void universalMaskIsDistinctAndOrdinaryAccessorsRejectIt() {
+        TopicMask universal = TopicMask.all();
+        TopicMask broadOrdinary = TopicMask.builder().addRegex("(?s:.*)", "(?s:.*)")
+                .includeContainedElements(true).build();
+        Topic topic = Topic.builder().addEntry("Role", "LAB").build();
+
+        assertTrue(universal.isUniversal());
+        assertEquals(List.of(), universal.getEntries());
+        assertTrue(universal.matches(topic));
+        assertFalse(universal.matches(null));
+        assertNotEquals(universal, broadOrdinary);
+        assertTrue(broadOrdinary.matches(topic));
+        assertThrows(IllegalStateException.class, universal::getCanonicalExpression);
+        assertThrows(IllegalStateException.class, universal::isIncludeContainedElements);
+    }
+
+    @Test
+    void literalHelpersQuoteMetacharactersWithoutChangingTheSelectorBasis() {
+        TopicMask literal = TopicMask.builder().addLiterals("Role", "A.B")
+                .includeContainedElements(false).build();
+        Topic dotted = Topic.builder().addEntry("Role", "A.B").build();
+        Topic wildcardMatch = Topic.builder().addEntry("Role", "AxB").build();
+
+        assertTrue(literal.matches(dotted));
+        assertFalse(literal.matches(wildcardMatch));
+        assertTrue(TopicMask.builder().addForLiteralValue("A.B").build().matches(dotted));
+        assertTrue(TopicMask.builder().addForLiteralQualifier("Role").build().matches(dotted));
+        assertEquals(literal, TopicMask.builder().addRegex(
+                TopicMaskEntry.ofLiterals("Role", "A.B").getQualifierRegex(),
+                TopicMaskEntry.ofLiterals("Role", "A.B").getValueRegex()).build());
+    }
+
+    @Test
+    void matchDiagnosticsAreSafeFailClosedAndCannotChangeTheOutcome() {
+        Topic topic = Topic.builder().addEntry("System", "Harmonia").build();
+        TopicMask mask = TopicMask.builder().addRegex("System", "Harmonia").build();
+        List<NamingDiagnostic> events = new ArrayList<>();
+
+        assertFalse(mask.matches(topic, events::add, (pattern, value) -> {
+            throw new IllegalStateException("secret " + value);
+        }));
+        NamingDiagnostic failure = events.get(0);
+        assertEquals(DiagnosticSeverity.ERROR, failure.severity());
+        assertEquals(MatchExitCategory.EVALUATION_ERROR, failure.category());
+        assertEquals(0, failure.entryIndex());
+        assertFalse(failure.toString().contains("Harmonia"));
+        assertTrue(mask.matches(topic, diagnostic -> {
+            throw new IllegalStateException("diagnostic failure");
+        }));
+    }
+
+    @Test
+    void diagnosticsRecordDepthFieldAndSuccessfulExitMetadata() {
+        Topic candidate = Topic.builder().addEntry("System", "Harmonia").build();
+        List<NamingDiagnostic> events = new ArrayList<>();
+
+        assertFalse(TopicMask.builder().addAny().addAny().build().matches(candidate, events::add));
+        assertEquals(MatchExitCategory.DEPTH_MISMATCH, events.get(0).category());
+        assertEquals(null, events.get(0).entryIndex());
+        events.clear();
+
+        assertFalse(TopicMask.builder().addRegex("Elsewhere", ".*").build()
+                .matches(candidate, events::add));
+        assertEquals(MatchExitCategory.QUALIFIER_MISMATCH, events.get(0).category());
+        assertEquals(0, events.get(0).entryIndex());
+        events.clear();
+
+        assertFalse(TopicMask.builder().addRegex("System", "Other").build()
+                .matches(candidate, events::add));
+        assertEquals(MatchExitCategory.VALUE_MISMATCH, events.get(0).category());
+        assertEquals(0, events.get(0).entryIndex());
+        events.clear();
+
+        assertTrue(TopicMask.builder().addRegex("System", "Harmonia").build()
+                .matches(candidate, events::add));
+        assertEquals(MatchExitCategory.MATCH, events.get(0).category());
+        assertEquals(0, events.get(0).entryIndex());
+    }
+
+    @Test
+    void maskBuilderFailureAndLaterSuccessPreserveEarlierSnapshots() {
+        TopicMaskBuilder builder = TopicMask.builder().addAny();
+        TopicMask first = builder.build();
+        assertThrows(NamingValidationException.class, () -> builder.addRegex("(?=A)", ".*"));
+        assertEquals(first, builder.build());
+
+        builder.addForLiteralValue("A.B");
+        TopicMask second = builder.build();
+        assertEquals(1, first.getEntries().size());
+        assertEquals(2, second.getEntries().size());
+        assertThrows(UnsupportedOperationException.class,
+                () -> first.getEntries().add(first.getEntries().get(0)));
+    }
+
+    @Test
+    void checksDepthBeforeExpressionsAndNeverExceedsFortyEightFieldEvaluations() {
+        TopicMask twoEntries = TopicMask.builder().addAny().addAny().build();
+        Topic oneEntry = Topic.builder().addEntry("Role", "LAB").build();
+        AtomicInteger evaluations = new AtomicInteger();
+        assertFalse(twoEntries.matches(oneEntry, diagnostic -> { }, (pattern, value) -> {
+            evaluations.incrementAndGet();
+            return true;
+        }));
+        assertEquals(0, evaluations.get());
+
+        TopicMaskBuilder builder = TopicMask.builder();
+        TopicBuilder topicBuilder = Topic.builder();
+        for (int index = 0; index < NamingLimits.MAX_DEPTH; index++) {
+            builder.addRegex(".*", ".*", ".*");
+            topicBuilder.addEntry("N" + index, "v" + index, "v" + index);
+        }
+        assertTrue(builder.build().matches(topicBuilder.build(), diagnostic -> { }, (pattern, value) -> {
+            evaluations.incrementAndGet();
+            return true;
+        }));
+        assertEquals(3 * NamingLimits.MAX_DEPTH, evaluations.get());
+    }
+
+    @Test
+    void deterministicMaximumDepthWorkloadRecordsElapsedTime() {
+        TopicMaskBuilder maskBuilder = TopicMask.builder();
+        TopicBuilder topicBuilder = Topic.builder();
+        for (int index = 0; index < NamingLimits.MAX_DEPTH; index++) {
+            maskBuilder.addRegex(".*", ".*", ".*");
+            topicBuilder.addEntry("N" + index, "value" + index, "v" + index);
+        }
+        TopicMask mask = maskBuilder.build();
+        Topic topic = topicBuilder.build();
+        for (int index = 0; index < 50; index++) {
+            assertTrue(mask.matches(topic));
+        }
+
+        long start = System.nanoTime();
+        for (int index = 0; index < 1_000; index++) {
+            assertTrue(mask.matches(topic));
+        }
+        long elapsedNanos = System.nanoTime() - start;
+        System.out.printf("Naming max-depth workload: iterations=1000, depth=%d, fieldChecks=48, elapsedNs=%d%n",
+                NamingLimits.MAX_DEPTH, elapsedNanos);
+    }
+
+    @Test
+    void oneImmutableMaskCanBeReusedConcurrently() throws Exception {
+        TopicMask shared = TopicMask.builder().addRegex("System", "Harmonia", "v[0-9]+").build();
+        ExecutorService executor = Executors.newFixedThreadPool(8);
+        try {
+            List<Callable<Boolean>> checks = new ArrayList<>();
+            for (int index = 0; index < 160; index++) {
+                int candidateIndex = index;
+                checks.add(() -> shared.matches(Topic.builder()
+                        .addEntry("System", "Harmonia", "v" + candidateIndex).build()));
+            }
+            List<Future<Boolean>> results = executor.invokeAll(checks);
+            for (Future<Boolean> result : results) {
+                assertTrue(result.get(5, TimeUnit.SECONDS));
+            }
+        } finally {
+            executor.shutdownNow();
+        }
+    }
+}
