@@ -0,0 +1,192 @@
+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming;
+
+import com.google.re2j.Pattern;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFailureCategory;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFieldKind;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingLimits;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingOperation;
+
+/**
+ * Applies simple lexical safeguards before RE2/J compilation and then checks
+ * the engine's native program-size measurement.
+ *
+ * <p>The scanner skips escaped, character-class, and {@code \Q...\E} literal
+ * text. It is not a second regular-expression parser and makes no complexity
+ * claim beyond the approved group, counted-bound, and expansion limits.</p>
+ */
+final class ExpressionSafeguard {
+
+    private ExpressionSafeguard() {
+        throw new AssertionError("No instances");
+    }
+
+    /** Validates and compiles one expression without retaining engine messages or causes. */
+    static Pattern compile(
+            String expression,
+            NamingFieldKind field,
+            NamingOperation operation,
+            Integer index) {
+        TopicFieldRules.validateExpression(expression, field, true, operation, index);
+        guardComplexity(expression, field, operation, index);
+        Pattern compiled;
+        try {
+            compiled = Pattern.compile(expression);
+        } catch (RuntimeException exception) {
+            throw TopicFieldRules.failure(NamingFailureCategory.EXPRESSION_REJECTED,
+                    operation, field, index);
+        }
+        if (compiled.programSize() > NamingLimits.MAX_REGEX_PROGRAM_SIZE) {
+            throw TopicFieldRules.failure(NamingFailureCategory.LIMIT_EXCEEDED,
+                    operation, field, index);
+        }
+        return compiled;
+    }
+
+    /** Rejects active excessive groups and explicit counted repetitions before compilation. */
+    private static void guardComplexity(
+            String expression,
+            NamingFieldKind field,
+            NamingOperation operation,
+            Integer index) {
+        int groupDepth = 0;
+        int classDepth = 0;
+        boolean classFirst = false;
+        boolean quoted = false;
+        long estimatedUnits = Math.max(1, expression.codePointCount(0, expression.length()));
+        for (int offset = 0; offset < expression.length(); offset++) {
+            char current = expression.charAt(offset);
+            if (current == '\\' && offset + 1 < expression.length()) {
+                char escaped = expression.charAt(offset + 1);
+                if (quoted) {
+                    if (escaped == 'E') {
+                        quoted = false;
+                    }
+                    offset++;
+                    continue;
+                }
+                if (classDepth > 0) {
+                    classFirst = false;
+                    offset++;
+                    continue;
+                }
+                if (escaped == 'Q') {
+                    quoted = true;
+                }
+                offset++;
+                continue;
+            }
+            if (quoted) {
+                continue;
+            }
+            if (classDepth > 0) {
+                if (current == '[') {
+                    classDepth++;
+                    classFirst = true;
+                } else if (current == ']') {
+                    if (classFirst) {
+                        classFirst = false;
+                    } else {
+                        classDepth--;
+                    }
+                } else if (current != '^' || !classFirst) {
+                    classFirst = false;
+                }
+                continue;
+            }
+            if (current == '[') {
+                classDepth = 1;
+                classFirst = true;
+            } else if (current == '(') {
+                groupDepth++;
+                if (groupDepth > NamingLimits.MAX_REGEX_GROUP_DEPTH) {
+                    rejectLimit(operation, field, index);
+                }
+            } else if (current == ')') {
+                groupDepth = Math.max(0, groupDepth - 1);
+            } else if (current == '{') {
+                Repetition repetition = parseRepetition(expression, offset);
+                if (repetition != null) {
+                    if (repetition.maximum() > NamingLimits.MAX_REGEX_REPEAT_BOUND) {
+                        rejectLimit(operation, field, index);
+                    }
+                    estimatedUnits = saturatedMultiply(estimatedUnits,
+                            Math.max(1, repetition.maximum()));
+                    if (estimatedUnits > NamingLimits.MAX_REGEX_EXPANSION_UNITS) {
+                        rejectLimit(operation, field, index);
+                    }
+                    offset = repetition.endIndex();
+                }
+            }
+        }
+    }
+
+    /** Recognizes only a complete simple numeric repetition at the current brace. */
+    private static Repetition parseRepetition(String expression, int start) {
+        NumberPart lower = readNumber(expression, start + 1);
+        if (lower == null) {
+            return null;
+        }
+        int offset = lower.nextIndex();
+        int upper = lower.value();
+        if (offset < expression.length() && expression.charAt(offset) == ',') {
+            NumberPart upperPart = readNumber(expression, offset + 1);
+            if (upperPart == null) {
+                if (offset + 1 >= expression.length() || expression.charAt(offset + 1) != '}') {
+                    return null;
+                }
+                offset++;
+            } else {
+                upper = upperPart.value();
+                offset = upperPart.nextIndex();
+            }
+        }
+        if (offset >= expression.length() || expression.charAt(offset) != '}') {
+            return null;
+        }
+        return new Repetition(offset, Math.max(lower.value(), upper));
+    }
+
+    /** Reads ASCII digits with saturation so huge source integers cannot overflow. */
+    private static NumberPart readNumber(String expression, int start) {
+        if (start >= expression.length() || !isAsciiDigit(expression.charAt(start))) {
+            return null;
+        }
+        int value = 0;
+        int offset = start;
+        while (offset < expression.length() && isAsciiDigit(expression.charAt(offset))) {
+            value = Math.min(NamingLimits.MAX_REGEX_REPEAT_BOUND + 1,
+                    value * 10 + expression.charAt(offset) - '0');
+            offset++;
+        }
+        return new NumberPart(value, offset);
+    }
+
+    /** Tests the ASCII-only digit syntax accepted for counted repetitions. */
+    private static boolean isAsciiDigit(char value) {
+        return value >= '0' && value <= '9';
+    }
+
+    /** Multiplies the estimate while saturating immediately above its fixed ceiling. */
+    private static long saturatedMultiply(long value, int multiplier) {
+        if (value > NamingLimits.MAX_REGEX_EXPANSION_UNITS / (long) multiplier) {
+            return NamingLimits.MAX_REGEX_EXPANSION_UNITS + 1L;
+        }
+        return value * multiplier;
+    }
+
+    /** Raises the common safe limit category without exposing expression text. */
+    private static void rejectLimit(
+            NamingOperation operation,
+            NamingFieldKind field,
+            Integer index) {
+        throw TopicFieldRules.failure(NamingFailureCategory.LIMIT_EXCEEDED,
+                operation, field, index);
+    }
+
+    private record NumberPart(int value, int nextIndex) {
+    }
+
+    private record Repetition(int endIndex, int maximum) {
+    }
+}
