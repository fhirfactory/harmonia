+        assertEquals(expected, mask);
+        assertArrayEquals(fixture, NamingXmlCodec.writeTopicMask(mask));
+        assertArrayEquals(NamingXmlCodec.writeTopicMask(TopicMask.all()),
+                NamingXmlCodec.writeTopicMask(NamingXmlCodec.readTopicMask(
