+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming;
+
+import static org.junit.jupiter.api.Assertions.assertArrayEquals;
+import static org.junit.jupiter.api.Assertions.assertEquals;
+import static org.junit.jupiter.api.Assertions.assertThrows;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.io.InputStream;
+import java.nio.charset.StandardCharsets;
+import java.util.Arrays;
+import net.fhirfactory.harmonia.model.core.naming.interchange.NamingXmlCodec;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFailureCategory;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingLimits;
+import org.junit.jupiter.api.Test;
+
+/** Checks deterministic XML fixtures, lossless masks, and fail-closed parsing. */
+class NamingXmlCodecTest {
+
+    @Test
+    void topicFixtureRoundTripsOrderedVersionsAndDeterministicBytes() throws IOException {
+        byte[] fixture = resource("topic.xml");
+        Topic topic = NamingXmlCodec.readTopic(fixture);
