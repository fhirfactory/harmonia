+                + "<entry><qualifierRegex encoding=\"base64\">@@</qualifierRegex>"
+                + "<valueRegex encoding=\"base64\">Lio=</valueRegex></entry></topicMask>")
+                .getBytes(StandardCharsets.UTF_8);
+        byte[] emptyTopicVersion = ("<topic><entry><qualifier>Role</qualifier><value>LAB</value>"
+                + "<version></version></entry></topic>").getBytes(StandardCharsets.UTF_8);
