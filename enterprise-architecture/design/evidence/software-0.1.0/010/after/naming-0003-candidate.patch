+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming.valuesets;
+
+/**
+ * Defines the release-approved resource limits for the standalone Naming model.
+ *
+ * <p>These bounds protect construction, parsing, matching, and interchange from
+ * inputs whose cost is disproportionate to their logical content. The limits
+ * are deliberately part of the shared Naming contract rather than hidden in a
+ * parser or a particular serialization adapter.</p>
+ */
+public final class NamingLimits {
+
+    /** Maximum number of entries in a Topic or ordinary TopicMask. */
+    public static final int MAX_DEPTH = 16;
+    /** Maximum decoded qualifier length in Unicode code points. */
+    public static final int MAX_QUALIFIER_CODE_POINTS = 64;
+    /** Maximum decoded value length in Unicode code points. */
+    public static final int MAX_VALUE_CODE_POINTS = 256;
+    /** Maximum decoded version length in Unicode code points. */
+    public static final int MAX_VERSION_CODE_POINTS = 64;
+    /** Maximum length of one decoded regular-expression field. */
+    public static final int MAX_EXPRESSION_CODE_POINTS = 512;
+    /** Maximum UTF-8 size of either Topic canonical representation. */
+    public static final int MAX_TOPIC_CANONICAL_UTF8_BYTES = 32 * 1024;
+    /** Maximum UTF-8 size of an ordinary mask canonical expression. */
+    public static final int MAX_MASK_CANONICAL_UTF8_BYTES = 128 * 1024;
+    /** Maximum UTF-8 size of one complete XML record. */
+    public static final int MAX_XML_RECORD_UTF8_BYTES = 256 * 1024;
+    /** Maximum active nested regular-expression group depth. */
+    public static final int MAX_REGEX_GROUP_DEPTH = 16;
+    /** Maximum explicit numeric repetition bound in a regular expression. */
+    public static final int MAX_REGEX_REPEAT_BOUND = 256;
+    /** Maximum conservative expansion estimate for a regular expression. */
+    public static final int MAX_REGEX_EXPANSION_UNITS = 4_096;
+    /** Maximum compiled RE2/J program instruction count. */
+    public static final int MAX_REGEX_PROGRAM_SIZE = 1_024;
+    /** Maximum full-field checks in one ordinary mask evaluation. */
+    public static final int MAX_FIELD_EVALUATIONS = 48;
+
+    private NamingLimits() {
+        throw new AssertionError("No instances");
+    }
+}
