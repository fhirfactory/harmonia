+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming.datatypes;
+
+import net.fhirfactory.harmonia.model.core.naming.valuesets.DiagnosticSeverity;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.MatchExitCategory;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFieldKind;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingLimits;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingOperation;
+
+/**
+ * Safe metadata describing the exit of one synchronous TopicMask comparison.
+ *
+ * <p>The record deliberately has no field for candidate text, Topic paths,
+ * expressions, exception messages, or causes. A {@code null} entry index means
+ * no field had been evaluated when the comparison exited.</p>
+ *
+ * @param severity conditional TRACE or handling-boundary ERROR intent
+ * @param category the stable comparison exit category
+ * @param operation the bounded operation that produced the diagnostic
+ * @param depth the candidate depth, or zero when no candidate exists
+ * @param entryIndex zero-based last checked entry, or {@code null}
+ * @param fieldKind field category last checked, or {@link NamingFieldKind#NONE}
+ */
+public record NamingDiagnostic(
+        DiagnosticSeverity severity,
+        MatchExitCategory category,
+        NamingOperation operation,
+        int depth,
+        Integer entryIndex,
+        NamingFieldKind fieldKind) {
+
+    /** Validates that diagnostic metadata is bounded and internally coherent. */
+    public NamingDiagnostic {
+        if (severity == null || category == null || operation == null || fieldKind == null) {
+            throw new IllegalArgumentException("Diagnostic metadata is required");
+        }
+        if (depth < 0 || (entryIndex != null
+                && (entryIndex < 0 || entryIndex >= NamingLimits.MAX_DEPTH))) {
+            throw new IllegalArgumentException("Diagnostic metadata is out of range");
+        }
+    }
+}
