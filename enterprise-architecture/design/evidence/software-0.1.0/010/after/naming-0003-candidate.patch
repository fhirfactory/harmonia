+import javax.xml.parsers.DocumentBuilderFactory;
+import javax.xml.parsers.ParserConfigurationException;
+import net.fhirfactory.harmonia.model.core.naming.NamingValidationException;
+import net.fhirfactory.harmonia.model.core.naming.Topic;
+import net.fhirfactory.harmonia.model.core.naming.TopicEntry;
+import net.fhirfactory.harmonia.model.core.naming.TopicMask;
+import net.fhirfactory.harmonia.model.core.naming.TopicMaskEntry;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFailureCategory;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingFieldKind;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingLimits;
+import net.fhirfactory.harmonia.model.core.naming.valuesets.NamingOperation;
+import org.w3c.dom.Document;
+import org.w3c.dom.Element;
+import org.w3c.dom.NamedNodeMap;
+import org.w3c.dom.Node;
+import org.w3c.dom.NodeList;
+import org.xml.sax.ErrorHandler;
+import org.xml.sax.InputSource;
+import org.xml.sax.SAXException;
+import org.xml.sax.SAXParseException;
+
+/**
+ * Deterministic UTF-8 XML interchange for complete Topics and TopicMasks.
+ *
+ * <p>Topic entries are emitted in path order. Mask kind and containment are
+ * explicit, and regex fields use reversible Base64 so expression whitespace
+ * and line endings are not normalized by XML. Input size is checked before
+ * decoding, DTDs and external entities are disabled, and unknown structure is
+ * rejected.</p>
+ */
+public final class NamingXmlCodec {
+    private static final String XML_HEADER = "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n";
+    private static final int MAX_ENTRY_FIELDS = 3;
+    private static final int MAX_EXPRESSION_BASE64_CHARS = 4 * ((
+            NamingLimits.MAX_EXPRESSION_CODE_POINTS * 4 + 2) / 3);
+
+    /** Prevents construction; callers use the stateless public conversion operations. */
+    private NamingXmlCodec() {
+        throw new AssertionError("No instances");
+    }
+
+    /**
+     * Encodes a complete Topic as deterministic UTF-8 XML.
+     *
+     * @param topic immutable Topic to encode
+     * @return bounded UTF-8 XML bytes
+     * @throws NamingValidationException when input is absent or output exceeds the record limit
+     */
+    public static byte[] writeTopic(Topic topic) {
+        if (topic == null) {
+            throw failure(NamingFailureCategory.MISSING_INPUT,
+                    NamingOperation.TOPIC_XML_WRITE, NamingFieldKind.NONE, null);
+        }
+        StringBuilder xml = new StringBuilder(XML_HEADER).append("<topic>\n");
+        for (TopicEntry entry : topic.getEntries()) {
+            xml.append("  <entry>\n")
+                    .append("    <qualifier>").append(escapeText(entry.getQualifier()))
+                    .append("</qualifier>\n")
+                    .append("    <value>").append(escapeText(entry.getValue()))
+                    .append("</value>\n");
+            entry.getVersion().ifPresent(version -> xml.append("    <version>")
+                    .append(escapeText(version)).append("</version>\n"));
+            xml.append("  </entry>\n");
+        }
+        xml.append("</topic>");
+        return boundedBytes(xml.toString(), NamingOperation.TOPIC_XML_WRITE);
+    }
+
+    /**
+     * Decodes a complete Topic record, rejecting malformed or unsafe XML.
+     *
+     * @param record bounded UTF-8 record bytes
+     * @return reconstructed immutable Topic
+     * @throws NamingValidationException when bytes, XML structure, or Topic fields are rejected
+     */
+    public static Topic readTopic(byte[] record) {
+        NamingOperation operation = NamingOperation.TOPIC_XML_READ;
+        Document document = parse(record, operation);
+        Element root = document.getDocumentElement();
+        requireName(root, "topic", operation);
+        requireAttributes(root, List.of(), operation);
+        List<Element> entryElements = childElements(root, operation, NamingLimits.MAX_DEPTH);
+        if (entryElements.isEmpty() || entryElements.size() > NamingLimits.MAX_DEPTH) {
+            throw failure(entryElements.isEmpty() ? NamingFailureCategory.MALFORMED_RECORD
+                            : NamingFailureCategory.LIMIT_EXCEEDED,
+                    operation, NamingFieldKind.DEPTH, null);
+        }
+        net.fhirfactory.harmonia.model.core.naming.TopicBuilder builder = Topic.builder();
+        for (int index = 0; index < entryElements.size(); index++) {
+            Element entry = entryElements.get(index);
+            requireName(entry, "entry", operation);
+            requireAttributes(entry, List.of(), operation);
+            List<Element> fields = childElements(entry, operation, MAX_ENTRY_FIELDS);
+            if (fields.size() < 2 || fields.size() > 3) {
+                throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                        operation, NamingFieldKind.NONE, index);
+            }
+            requireName(fields.get(0), "qualifier", operation);
+            requireName(fields.get(1), "value", operation);
+            requireAttributes(fields.get(0), List.of(), operation);
+            requireAttributes(fields.get(1), List.of(), operation);
+            String qualifier = simpleText(fields.get(0), operation, index);
+            String value = simpleText(fields.get(1), operation, index);
+            String version = null;
+            if (fields.size() == 3) {
+                requireName(fields.get(2), "version", operation);
+                requireAttributes(fields.get(2), List.of(), operation);
+                version = simpleText(fields.get(2), operation, index);
+                if (version.isEmpty()) {
+                    throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                            operation, NamingFieldKind.VERSION, index);
+                }
+            }
+            builder.addEntry(qualifier, value, version);
+        }
+        return builder.build();
+    }
+
+    /**
+     * Encodes an ordinary or explicit universal TopicMask as deterministic XML.
+     *
+     * @param mask immutable mask to encode
+     * @return bounded UTF-8 XML bytes
+     * @throws NamingValidationException when input is absent or output exceeds the record limit
+     */
+    public static byte[] writeTopicMask(TopicMask mask) {
+        if (mask == null) {
+            throw failure(NamingFailureCategory.MISSING_INPUT,
+                    NamingOperation.MASK_XML_WRITE, NamingFieldKind.NONE, null);
+        }
+        StringBuilder xml = new StringBuilder(XML_HEADER);
+        if (mask.isUniversal()) {
+            xml.append("<topicMask kind=\"universal\"></topicMask>");
+            return boundedBytes(xml.toString(), NamingOperation.MASK_XML_WRITE);
+        }
+        xml.append("<topicMask kind=\"ordinary\" includeContainedElements=\"")
+                .append(mask.isIncludeContainedElements()).append("\">\n");
+        for (TopicMaskEntry entry : mask.getEntries()) {
+            xml.append("  <entry>\n")
+                    .append("    <qualifierRegex encoding=\"base64\">")
+                    .append(encodeBase64(entry.getQualifierRegex())).append("</qualifierRegex>\n")
+                    .append("    <valueRegex encoding=\"base64\">")
+                    .append(encodeBase64(entry.getValueRegex())).append("</valueRegex>\n");
+            entry.getVersionRegex().ifPresent(version -> xml.append(
+                    "    <versionRegex encoding=\"base64\">")
+                    .append(encodeBase64(version)).append("</versionRegex>\n"));
+            xml.append("  </entry>\n");
+        }
+        xml.append("</topicMask>");
+        return boundedBytes(xml.toString(), NamingOperation.MASK_XML_WRITE);
+    }
+
+    /**
+     * Decodes an ordinary or universal TopicMask and recompiles its expressions.
+     *
+     * @param record bounded UTF-8 record bytes
+     * @return reconstructed immutable mask
+     * @throws NamingValidationException when bytes, XML structure, or expressions are rejected
+     */
+    public static TopicMask readTopicMask(byte[] record) {
+        NamingOperation operation = NamingOperation.MASK_XML_READ;
+        Document document = parse(record, operation);
+        Element root = document.getDocumentElement();
+        requireName(root, "topicMask", operation);
+        String kind = requiredAttribute(root, "kind", operation);
+        if (kind.equals("universal")) {
+            requireAttributes(root, List.of("kind"), operation);
+            if (!childElements(root, operation, 0).isEmpty()) {
+                throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                        operation, NamingFieldKind.XML_RECORD, null);
+            }
+            return TopicMask.all();
+        }
+        if (!kind.equals("ordinary")) {
+            throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                    operation, NamingFieldKind.XML_RECORD, null);
+        }
+        requireAttributes(root, List.of("kind", "includeContainedElements"), operation);
+        boolean include = parseBoolean(requiredAttribute(root, "includeContainedElements", operation), operation);
+        List<Element> entryElements = childElements(root, operation, NamingLimits.MAX_DEPTH);
+        if (entryElements.isEmpty() || entryElements.size() > NamingLimits.MAX_DEPTH) {
+            throw failure(entryElements.isEmpty() ? NamingFailureCategory.MALFORMED_RECORD
+                            : NamingFailureCategory.LIMIT_EXCEEDED,
+                    operation, NamingFieldKind.DEPTH, null);
+        }
+        net.fhirfactory.harmonia.model.core.naming.TopicMaskBuilder builder = TopicMask.builder();
+        for (int index = 0; index < entryElements.size(); index++) {
+            Element entry = entryElements.get(index);
+            requireName(entry, "entry", operation);
+            requireAttributes(entry, List.of(), operation);
+            List<Element> fields = childElements(entry, operation, MAX_ENTRY_FIELDS);
+            if (fields.size() < 2 || fields.size() > 3) {
+                throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                        operation, NamingFieldKind.NONE, index);
+            }
+            requireName(fields.get(0), "qualifierRegex", operation);
+            requireName(fields.get(1), "valueRegex", operation);
+            String qualifier = decodeBase64Element(fields.get(0), operation, index);
+            String value = decodeBase64Element(fields.get(1), operation, index);
+            if (fields.size() == 3) {
+                requireName(fields.get(2), "versionRegex", operation);
+                builder.addRegex(qualifier, value,
+                        decodeBase64Element(fields.get(2), operation, index));
+            } else {
+                builder.addRegex(qualifier, value);
+            }
+        }
+        return builder.includeContainedElements(include).build();
+    }
+
+    /** Builds a hardened parser for a size-checked record and maps parser details to safe failures. */
+    private static Document parse(byte[] record, NamingOperation operation) {
+        String xml = decodeRecord(record, operation);
+        try {
+            DocumentBuilderFactory factory = DocumentBuilderFactory.newInstance();
+            factory.setNamespaceAware(false);
+            factory.setXIncludeAware(false);
+            factory.setExpandEntityReferences(false);
+            factory.setFeature(XMLConstants.FEATURE_SECURE_PROCESSING, true);
+            factory.setFeature("http://apache.org/xml/features/disallow-doctype-decl", true);
+            factory.setFeature("http://xml.org/sax/features/external-general-entities", false);
+            factory.setFeature("http://xml.org/sax/features/external-parameter-entities", false);
+            factory.setFeature("http://apache.org/xml/features/nonvalidating/load-external-dtd", false);
+            factory.setAttribute("http://www.oracle.com/xml/jaxp/properties/maxElementDepth", "4");
+            factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_DTD, "");
+            factory.setAttribute(XMLConstants.ACCESS_EXTERNAL_SCHEMA, "");
+            DocumentBuilder builder = factory.newDocumentBuilder();
+            builder.setEntityResolver((publicId, systemId) -> {
+                throw new SAXException("External entities are disabled");
+            });
+            builder.setErrorHandler(new StrictErrorHandler());
+            Document document = builder.parse(new InputSource(new StringReader(xml)));
+            validateDocumentChildren(document, operation);
+            return document;
+        } catch (ParserConfigurationException | SAXException | IOException | IllegalArgumentException exception) {
+            throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                    operation, NamingFieldKind.XML_RECORD, null);
+        }
+    }
+
+    /** Decodes strict UTF-8 only after enforcing the complete record byte limit. */
+    private static String decodeRecord(byte[] record, NamingOperation operation) {
+        if (record == null) {
+            throw failure(NamingFailureCategory.MISSING_INPUT,
+                    operation, NamingFieldKind.XML_RECORD, null);
+        }
+        if (record.length > NamingLimits.MAX_XML_RECORD_UTF8_BYTES) {
+            throw failure(NamingFailureCategory.LIMIT_EXCEEDED,
+                    operation, NamingFieldKind.XML_RECORD, null);
+        }
+        try {
+            return StandardCharsets.UTF_8.newDecoder()
+                    .onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT)
+                    .decode(ByteBuffer.wrap(record)).toString();
+        } catch (CharacterCodingException exception) {
+            throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                    operation, NamingFieldKind.XML_RECORD, null);
+        }
+    }
+
+    /** Collects only element children and enforces the local structure count before list growth. */
+    private static List<Element> childElements(
+            Element parent,
+            NamingOperation operation,
+            int maximumChildren) {
+        NodeList children = parent.getChildNodes();
+        List<Element> elements = new ArrayList<>();
+        for (int index = 0; index < children.getLength(); index++) {
+            Node child = children.item(index);
+            if (child.getNodeType() == Node.ELEMENT_NODE) {
+                if (elements.size() >= maximumChildren) {
+                    NamingFailureCategory category = maximumChildren == NamingLimits.MAX_DEPTH
+                            ? NamingFailureCategory.LIMIT_EXCEEDED : NamingFailureCategory.MALFORMED_RECORD;
+                    throw failure(category, operation, NamingFieldKind.XML_RECORD, null);
+                }
+                elements.add((Element) child);
+            } else if (child.getNodeType() == Node.TEXT_NODE && child.getNodeValue().isBlank()) {
+                continue;
+            } else {
+                throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                        operation, NamingFieldKind.XML_RECORD, null);
+            }
+        }
+        return elements;
+    }
+
+    /** Reads a text-only field without normalizing its content or accepting nested elements. */
+    private static String simpleText(Element element, NamingOperation operation, int index) {
+        NodeList children = element.getChildNodes();
+        StringBuilder text = new StringBuilder();
+        for (int childIndex = 0; childIndex < children.getLength(); childIndex++) {
+            Node child = children.item(childIndex);
+            if (child.getNodeType() != Node.TEXT_NODE && child.getNodeType() != Node.CDATA_SECTION_NODE) {
+                throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                        operation, NamingFieldKind.XML_RECORD, index);
+            }
+            text.append(child.getNodeValue());
+        }
+        return text.toString();
+    }
+
+    /** Validates canonical Base64 and strict UTF-8 before returning one bounded expression. */
+    private static String decodeBase64Element(Element element, NamingOperation operation, int index) {
+        requireAttributes(element, List.of("encoding"), operation);
+        if (!requiredAttribute(element, "encoding", operation).equals("base64")) {
+            throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                    operation, NamingFieldKind.XML_RECORD, index);
+        }
+        String encoded = simpleText(element, operation, index);
+        if (encoded.length() > MAX_EXPRESSION_BASE64_CHARS) {
+            throw failure(NamingFailureCategory.LIMIT_EXCEEDED,
+                    operation, NamingFieldKind.XML_RECORD, index);
+        }
+        try {
+            byte[] decoded = Base64.getDecoder().decode(encoded);
+            if (!Base64.getEncoder().encodeToString(decoded).equals(encoded)) {
+                throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                        operation, NamingFieldKind.XML_RECORD, index);
+            }
+            return StandardCharsets.UTF_8.newDecoder()
+                    .onMalformedInput(CodingErrorAction.REPORT)
+                    .onUnmappableCharacter(CodingErrorAction.REPORT)
+                    .decode(ByteBuffer.wrap(decoded)).toString();
+        } catch (IllegalArgumentException | CharacterCodingException exception) {
+            throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                    operation, NamingFieldKind.XML_RECORD, index);
+        }
+    }
+
+    /** Reads a mandatory attribute without exposing record contents in a failure. */
+    private static String requiredAttribute(Element element, String name, NamingOperation operation) {
+        if (!element.hasAttribute(name)) {
+            throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                    operation, NamingFieldKind.XML_RECORD, null);
+        }
+        return element.getAttribute(name);
+    }
+
+    /** Rejects every attribute not explicitly part of the interchange contract. */
+    private static void requireAttributes(Element element, List<String> allowed, NamingOperation operation) {
+        NamedNodeMap attributes = element.getAttributes();
+        for (int index = 0; index < attributes.getLength(); index++) {
+            Node attribute = attributes.item(index);
+            if (!allowed.contains(attribute.getNodeName())) {
+                throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                        operation, NamingFieldKind.XML_RECORD, null);
+            }
+        }
+    }
+
+    /** Enforces exact unqualified element names rather than accepting aliases or namespaces. */
+    private static void requireName(Element element, String expected, NamingOperation operation) {
+        if (!element.getTagName().equals(expected)) {
+            throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                    operation, NamingFieldKind.XML_RECORD, null);
+        }
+    }
+
+    /** Accepts only canonical lowercase boolean literals for the containment flag. */
+    private static boolean parseBoolean(String value, NamingOperation operation) {
+        if (value.equals("true")) {
+            return true;
+        }
+        if (value.equals("false")) {
+            return false;
+        }
+        throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                operation, NamingFieldKind.XML_RECORD, null);
+    }
+
+    /** Requires exactly one document root and rejects comments or other document-level content. */
+    private static void validateDocumentChildren(Document document, NamingOperation operation) {
+        NodeList children = document.getChildNodes();
+        int roots = 0;
+        for (int index = 0; index < children.getLength(); index++) {
+            Node child = children.item(index);
+            if (child.getNodeType() == Node.ELEMENT_NODE) {
+                roots++;
+            } else if (child.getNodeType() == Node.TEXT_NODE && child.getNodeValue().isBlank()) {
+                continue;
+            } else {
+                throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                        operation, NamingFieldKind.XML_RECORD, null);
+            }
+        }
+        if (roots != 1) {
+            throw failure(NamingFailureCategory.MALFORMED_RECORD,
+                    operation, NamingFieldKind.XML_RECORD, null);
+        }
+    }
+
+    /** Encodes deterministic UTF-8 output and checks the complete serialized record size. */
+    private static byte[] boundedBytes(String xml, NamingOperation operation) {
+        byte[] bytes = xml.getBytes(StandardCharsets.UTF_8);
+        if (bytes.length > NamingLimits.MAX_XML_RECORD_UTF8_BYTES) {
+            throw failure(NamingFailureCategory.LIMIT_EXCEEDED,
+                    operation, NamingFieldKind.XML_RECORD, null);
+        }
+        return bytes;
+    }
+
+    /** Encodes expression bytes so XML parsing cannot normalize regex characters. */
+    private static String encodeBase64(String expression) {
+        return Base64.getEncoder().encodeToString(expression.getBytes(StandardCharsets.UTF_8));
+    }
+
+    /** Escapes Topic field text for XML without changing the reconstructed value. */
+    private static String escapeText(String text) {
+        StringBuilder escaped = new StringBuilder(text.length());
+        for (int index = 0; index < text.length(); index++) {
+            char current = text.charAt(index);
+            switch (current) {
+                case '&' -> escaped.append("&amp;");
+                case '<' -> escaped.append("&lt;");
+                case '>' -> escaped.append("&gt;");
+                default -> escaped.append(current);
+            }
+        }
+        return escaped.toString();
+    }
+
+    /** Creates a safe record-level validation result with no parser cause or payload. */
+    private static NamingValidationException failure(
+            NamingFailureCategory category,
+            NamingOperation operation,
+            NamingFieldKind field,
+            Integer index) {
+        return NamingValidationException.create(category, operation, field, index);
+    }
+
+    /** Prevents XML parser diagnostics from echoing untrusted record text. */
+    private static final class StrictErrorHandler implements ErrorHandler {
+        /** Rejects warnings to keep accepted XML structure unambiguous. */
+        @Override
+        public void warning(SAXParseException exception) throws SAXException {
+            throw new SAXException("Malformed XML");
+        }
+
+        /** Converts recoverable parser errors to a fixed, payload-free failure. */
+        @Override
+        public void error(SAXParseException exception) throws SAXException {
+            throw new SAXException("Malformed XML");
+        }
+
+        /** Stops parsing on fatal XML syntax or security errors. */
+        @Override
+        public void fatalError(SAXParseException exception) throws SAXException {
+            throw new SAXException("Malformed XML");
+        }
+    }
+}
