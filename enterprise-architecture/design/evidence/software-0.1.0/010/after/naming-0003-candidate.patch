+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming;
+
+import com.google.re2j.Pattern;
+
+/** Local test seam for invoking a full-field RE2/J evaluation. */
+@FunctionalInterface
+interface FieldEvaluator {
+    FieldEvaluator RE2J = (pattern, value) -> pattern.matcher(value).matches();
+
+    /** Evaluates one complete field using the supplied compiled immutable pattern. */
+    boolean matches(Pattern pattern, String value);
+}
