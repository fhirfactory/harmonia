+/* Copyright (c) 2026 Mark Hunter. SPDX-License-Identifier: GPL-3.0-or-later */
+package net.fhirfactory.harmonia.model.core.naming;
+
+import static org.junit.jupiter.api.Assertions.assertFalse;
+import static org.junit.jupiter.api.Assertions.assertTrue;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.stream.Stream;
+import org.junit.jupiter.api.Test;
+
+/** Enforces the bounded source-file size and standalone Naming ownership boundary. */
+class NamingStructureTest {
+    private static final Path SOURCE_ROOT = Path.of(
+            "src/main/java/net/fhirfactory/harmonia/model/core/naming");
+
+    @Test
+    void productionFilesStayBoundedAndDoNotDependOnHigherGovernanceLayers() throws IOException {
+        try (Stream<Path> sources = Files.walk(SOURCE_ROOT)) {
+            for (Path source : sources.filter(path -> path.toString().endsWith(".java")).toList()) {
+                assertTrue(Files.readAllLines(source).size() <= 500, source.toString());
+                String contents = Files.readString(source);
+                assertFalse(contents.contains("net.fhirfactory.harmonia.themis"), source.toString());
+                assertFalse(contents.contains("org.apache.logging"), source.toString());
+                assertFalse(contents.contains("java.util.regex"), source.toString());
+            }
+        }
+        String pom = Files.readString(Path.of("pom.xml"));
+        assertTrue(pom.contains("<artifactId>re2j</artifactId>"));
+        assertTrue(pom.contains("<version>1.8</version>"));
+        assertTrue(pom.contains("<artifactId>junit-jupiter</artifactId>"));
+        assertTrue(pom.contains("<version>5.10.2</version>"));
+    }
+}
