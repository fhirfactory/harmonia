\label{tab:strategic_capabilities}
\end{table}

\subsection{Strategic Value Stream Flow}
The end-to-end flow of clinical information across Harmonia realizes the following sequential value stream:
\begin{equation*}
\text{Ingest Trigger} \longrightarrow \text{Transport \&amp; Deduplicate} \longrightarrow \text{Orchestrate Erga} \longrightarrow \text{Update Cache Grid} \longrightarrow \text{Dispatch Egress / Serve FHIR APIs}
\end{equation*}

