                  <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;48-clinic--operational-queue-progression-process&quot;,&quot;line&quot;:187,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.8 Clinic / Operational Queue Progression Process&quot;},{&quot;anchor&quot;:&quot;48-clinic--operational-queue-progression-process&quot;,&quot;line&quot;:188,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Clinic &amp; Practice Operations`&quot;}]"/>
                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;This Process follows an individual's operational passage through the clinic. Waiting, rooming, consultation and departure have different implications for flow and communication, while the clinic's overall session has its own state. The progression is therefore patient-specific operational context rather than a complete account of clinic capacity or clinical priority.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:clinic--practice-operations&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CLINIC-PRACTICE-OPERATIONS.PR-CLINIC-OPERATIONAL-QUEUE-PROGRESSION-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Clinic / Operational Queue Progression Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Clinic \\&amp; Practice Operations}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the movement and state tracking of outpatients through an ambulatory specialty clinic session.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Scheduled → Patient Arrived → Checked-In → Roomed /\\allowbreak{} Pre-Consult → Consultation In-Progress → Consultation Concluded → Departed\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Scheduled}}: Appointment booked on session list.\n\n\n\n\\item \n\\texttt{\\seqsplit{Patient Arrived}}: Patient enters waiting area.\n\n\n\n\\item \n\\texttt{\\seqsplit{Checked-In}}: Reception verifies demographics and marks patient ready.\n\n\n\n\\item \n\\texttt{\\seqsplit{Roomed / Pre-Consult}}: Nursing staff record baseline vitals and room patient.\n\n\n\n\\item \n\\texttt{\\seqsplit{Consultation In-Progress}}: Clinician actively conducting consultation.\n\n\n\n\\item \n\\texttt{\\seqsplit{Consultation Concluded}}: Clinical discussion finished; follow-up orders placed.\n\n\n\n\\item \n\\texttt{\\seqsplit{Departed}}: Patient checks out and departs clinic facility.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-SETTING-OPERATIONS-ENABLEMENT.CT3-BEC-CLINIC-PRACTICE-OPERATIONS.PR-CLINIC-OPERATIONAL-QUEUE-PROGRESSION-PROCESS&quot;],&quot;key&quot;:&quot;process:clinic--operational-queue-progression-process&quot;,&quot;latex_label&quot;:&quot;process:clinic-operational-queue-progression-process&quot;,&quot;local_id&quot;:&quot;CLINIC-OPERATIONAL-QUEUE-PROGRESSION-PROCESS&quot;,&quot;name&quot;:&quot;Clinic / Operational Queue Progression Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-clinic-practice-operations&quot;,&quot;owner_key&quot;:&quot;capability:clinic--practice-operations&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-clinic-operational-queue-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:clinic--practice-operations&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;48-clinic--operational-queue-progression-process&quot;,&quot;line&quot;:187,&quot;source&quot;:&quot;processes&quo