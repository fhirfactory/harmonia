                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Notification management does not define the obligation or own the operational response. Surveillance evidence can inform other abilities without establishing their findings.&quot;,&quot;Capability Overview&quot;:&quot;Population Health Surveillance establishes patterns and change across a defined population and manages the surveillance arrangements through which they are considered. Its children separate longitudinal assessment, surveillance management, event identification, formal notification and reporting. These distinctions matter because an observed pattern can be significant without being notifiable, and identifying a notifiable event does not demonstrate that the notification obligation has been discharged.&quot;,&quot;Intent&quot;:&quot;Make population-health concerns and applicable communication obligations visible in their population and temporal context.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-POPULATION-HEALTH-HEALTH-SYSTEM-PLANNING.CT2-POPULATION-HEALTH-SURVEILLANCE&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:population-health--health-system-planning&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;,&quot;semantic_relationship_representation&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-POPULATION-HEALTH-HEALTH-SYSTEM-PLANNING.CT2-POPULATION-HEALTH-SURVEILLANCE&quot;,&quot;canonical_name&quot;:&quot;Population Health Surveillance&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nUnderstand population-health state and manage organised surveillance, significant events and applicable notification.\n\n&quot;,&quot;id_aliases&quot;:[],&q