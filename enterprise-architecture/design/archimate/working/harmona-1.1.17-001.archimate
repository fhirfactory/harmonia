{Queued in Dispatch}}: Job prioritized in operational queue.\n\n\n\n\\item \n\\texttt{\\seqsplit{Assigned to Worker}}: Job allocated to specific staff member or team.\n\n\n\n\\item \n\\texttt{\\seqsplit{Job Accepted}}: Worker acknowledges dispatch on mobile device.\n\n\n\n\\item \n\\texttt{\\seqsplit{Work In-Progress}}: Task actively being executed.\n\n\n\n\\item \n\\texttt{\\seqsplit{Work Completed / Aborted}}: Job marked finished or formally cancelled with reason.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-OPERATIONAL-WORKFORCE-COORDINATION.CT3-BEC-WORK-ALLOCATION-DISPATCH.PR-OPERATIONAL-WORK-PROGRESSION-PROCESS&quot;],&quot;key&quot;:&quot;process:operational-work-progression-process&quot;,&quot;latex_label&quot;:&quot;process:operational-work-progression-process&quot;,&quot;local_id&quot;:&quot;OPERATIONAL-WORK-PROGRESSION-PROCESS&quot;,&quot;name&quot;:&quot;Operational Work Progression Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-work-allocation-dispatch&quot;,&quot;owner_key&quot;:&quot;capability:work-allocation--dispatch&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-operational-work-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:work-allocation--dispatch&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;410-operational-work-progression-process&quot;,&quot;line&quot;:218,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.10 Operational Work Progression Process&quot;},{&quot;anchor&quot;:&quot;410-operational-work-progression-process&quot;,&quot;line&quot;:219,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Work Allocation &amp; Dispatch`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:health-service-operations&quot;]}"/>
