                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Privacy safeguards do not replace broader estate resilience, access decisions or originating consent authority.&quot;,&quot;Capability Overview&quot;:&quot;This capability establishes safeguards and assurance arrangements concerning the privacy consequences of supplying, exposing or using information. It focuses on the effect on people and legitimate information use, distinguishing that concern from protection of the information estate itself. Technical access restrictions may contribute without exhausting the organisational privacy responsibility.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-HEALTH-INFORMATION-PROTECTION.CT3-HEALTH-PRIVACY-SAFEGUARD-MANAGEMENT&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;business-capability:health-information-protection&quot;,&quot;tier&quot;:&quot;CT3&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-HEALTH-INFORMATION-PROTECTION.CT3-HEALTH-PRIVACY-SAFEGUARD-MANAGEMENT&quot;,&quot;canonical_name&quot;:&quot;Health Privacy Safeguard Management&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nEstablish organisational safeguards and assurance processes concerning privacy consequences of information supply, exposure or use.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:health-privacy-safeguard-management&quot;,&quot;latex_label&quot;:&quot;cap:bc-health-privacy-safeguard-management&quot;,&quot;local_id&quot;:&quot;HEALTH-PRIVACY-SAFEGUARD-MANAGEMENT&quot;,&quot;name&quot;:&quot;Health Privacy Safeguard Management&quot;,&