-capability:clinical-knowledge-management&quot;,&quot;latex_label&quot;:&quot;cap:bc-clinical-knowledge-management&quot;,&quot;local_id&quot;:&quot;CLINICAL-KNOWLEDGE-MANAGEMENT&quot;,&quot;name&quot;:&quot;Clinical Knowledge Management&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-BC-health-information-knowledge-management&quot;,&quot;parent_key&quot;:&quot;capability:health-information--knowledge-management&quot;,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BC-clinical-knowledge-management&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;ct2--clinical-knowledge-management&quot;,&quot;line&quot;:664,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;##### CT2 — Clinical Knowledge Management&quot;},{&quot;anchor&quot;:&quot;ct2--clinical-knowledge-management&quot;,&quot;line&quot;:666,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Tier and ancestry:** CT2; parent Health Information &amp; Knowledge Management (CT1).&quot;},{&quot;anchor&quot;:&quot;ct2--clinical-knowledge-management&quot;,&quot;line&quot;:668,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Identify, extract, formulate, associate, govern and share reusable clinical knowledge.&quot;},{&quot;anchor&quot;:&quot;ct2--clinical-knowledge-management&quot;,&quot;line&quot;:681,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Boundary:** Source identified ≠ extracted material ≠ formulated knowledge ≠ reviewed/approved knowledge ≠ publication ≠ individual application. Reusable knowledge differs from source health information and individual clinical facts. Formulation is distinct from Health Information Structure Management and does not establish approval. Concept association does not redefine terminology or semantic authority. Publication establishes neither individual applicability nor a clinical conclusion/decision. Clinical knowledge and source provenance/authority remain distinguishable; no mandatory knowledge workflow is prescribed.&quot;}],&quot;structural_id_status&quot;:&quot;Established&quot;,&quot;tier&quot;:&quot;CT2&quot;,&quot;type&quot;:&quot;capability&quot;,&quot;unresolved&quot;:[&quot;relevance&quot;,&quot;semantic_relationship_representation&quot;],&quot;views&quot;:[&quot;region:health-information--digital-health&quot;]}"/>
