{
  &quot;type&quot;: &quot;capability_decomposition&quot;,
  &quot;from&quot;: &quot;proposal:bec-longitudinal-community-care-integration&quot;,
  &quot;to&quot;: &quot;capability:community-care&quot;,
  &quot;status&quot;: &quot;Proposed&quot;,
