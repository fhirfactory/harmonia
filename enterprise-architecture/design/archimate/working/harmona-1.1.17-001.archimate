                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;General people administration does not itself establish practitioner clinical qualification or privilege.&quot;,&quot;Capability Overview&quot;:&quot;People Management addresses people across the organisation as an enterprise support responsibility. It retains a scope broader than the practitioner-specific standing, privilege and coverage concerns of Health Workforce Management. This distinction allows health-service activity to consume relevant people context without redefining all workforce administration as clinical governance.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-CORPORATE-RESOURCES-ENTERPRISE-SERVICES.CT2-CORPORATE-SUPPORT-SERVICES.CT3-PEOPLE-MANAGEMENT&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;business-capability:corporate-support-services&quot;,&quot;tier&quot;:&quot;CT3&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-CORPORATE-RESOURCES-ENTERPRISE-SERVICES.CT2-CORPORATE-SUPPORT-SERVICES.CT3-PEOPLE-MANAGEMENT&quot;,&quot;canonical_name&quot;:&quot;People Management&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nManage people across the organisation, distinct from practitioner-specific Health Workforce Management.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:people-management&quot;,&quot;latex_label&quot;:&quot;cap:bc-people-management&quot;,&quot;local_id&quot;:&quot;PEOPLE-MANAGEMENT&quot;,&quot;name&quot;:&quot;People Management&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;