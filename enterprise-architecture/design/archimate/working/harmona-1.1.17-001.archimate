t;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The responsibility concerns support continuity, remote participation and preventive follow-up through appropriately assembled and exchanged care context. It is the finest capability frame required for the established behaviour; the older contextual heading is not another capability tier.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;reference_id&quot;:&quot;HCM-BEC-primary-care&quot;,&quot;relevance&quot;:&quot;Harmonia-Relevant&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-enabling-capabilities.md&quot;,&quot;docs/markdown/03-business-architecture/behaviours/03-service-delivery.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;view-3-service-delivery&quot;,&quot;line&quot;:362,&quot;source&quot;:&quot;enabling&quot;,&quot;text&quot;:&quot;2. Primary Care [Harmonia-Relevant]&quot;},{&quot;anchor&quot;:&quot;2-primary-care-harmonia-relevant&quot;,&quot;line&quot;:389,&quot;source&quot;:&quot;enabling&quot;,&quot;text&quot;:&quot;#### 2. Primary Care (`Harmonia-Relevant`)&quot;},{&quot;anchor&quot;:&quot;21-primary-care&quot;,&quot;line&quot;:51,&quot;source&quot;:&quot;sd&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Primary Care`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT3&quot;,&quot;type&quot;:&quot;capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[&quot;view:service-delivery&quot;]},&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BEC-primary-care&quot;,&quot;relevance&quot;:&quot;Harmonia-Relevant&quot;,&quot;relocation_reason&quot;:&quot;The established information integration/coordination responsibility survives; it does not identify or track infrastructure prerequisites of a clinical service.&quot;,&quot;responsibility_owner_key&quot;:null,&quot;review_provenance&quot;:{&quot;authority&quot;:&quot;Proposed structural assertions; existing Canonical semantic standing retained&quot;,&quot;derivation&quot;:&quot;Reconciliation against the explicit human-reviewed BEC candidate hierarchy&quot;,&quot;evidence&quot;:[{&quot;line&quot;:2,&quot;path&quot;:&quot;docs/latex-rad/Harmonia-EA-Capability-Map/v0.2-draft/reviewed-bec-hierarchy.json&quot;,&quot;standing&quot;:&quot;Explicit human task decision; reviewed candidate, not RADS acceptance&quot;,&quot;text&quot;:&quot; \&quot;authority\&quot;: \&quot;User-provided human-adjudicated reviewed candidate BEC hierarchy, 2026-10-16; bounded reconciliation input, not RADS acceptance.\&quot;,&quot;}],&quot;method&quot;:&quot;Bounded semantic reconciliation; no unconstrained synthesis&quot;},&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-enabling-capabilities.md&quot;,&quot;docs/markdown/03-business-architecture/behaviours/03-service-delivery.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;view-3-service-delivery&quot;,&quot;line&quot;:362,&quot;source&quot;:&quot;enabling&quot;,&quot;text&quot;:&quot;2. Primary Care [Harmonia-Relevant]&quot;},{&quot;anchor&quot;:&quot;2-primary-care-harmonia-relevant&quot;,&quot;line&quot;:389,&quot;source&quot;:&quot;enabling&quot;,&quot;text&quot;:&quot;#### 2. Primary Care (`Harmonia-Relevant`)&quot;},{&quot;anchor&quot;:&quot;21-primary-care&quot;,&quot;line&quot;:51,&quot;source&quot;:&quot;sd&quot;,&quot;text&quot;:&q