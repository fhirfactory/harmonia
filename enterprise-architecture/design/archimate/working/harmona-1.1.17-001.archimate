                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Modelling criteria does not inherently approve them. Detailed criterion states and approval workflows remain unresolved, and criteria need not all originate in formal Governance.&quot;,&quot;Capability Overview&quot;:&quot;Assurance Criteria Management maintains reusable evaluative criteria with governed standing and temporal applicability. Version and effective context matter because a conclusion must be understood against the criteria applicable to the subject and time being assessed. Criteria may operationalise governing requirements, but their management is not authority to change those requirements.&quot;,&quot;Harmonia Architectural Relevance&quot;:&quot;Formal relevance remains Unresolved. Established assurance support explains the enabling purpose without classifying it by inference or allocating software responsibility.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;tier&quot;,&quot;root_status&quot;,&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;contextual_view&quot;,&quot;feature_decomposition&quot;,&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;boundary&quot;:&quot;Information administration does not confer authority over the represented person, organisation, service, place, device or clinical activity.&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-INDEPENDENT-SERVICE-ASSURANCE-ENABLEMENT.CT2-BEC-ASSURANCE-SPECIFICATION-ENABLEMENT.CT3-BEC-ASSURANCE-CRITERIA-MANAGEMENT&quot;,&quot;canonical_name&quot;:&quot;Assurance Criteria Management&quot;,&quot;category&quot;:&quot;business_enabling&quot;,&quot;confidence&quot;:&quot;High&quot