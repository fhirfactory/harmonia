                    <property key="v0.2 / Construct Type" value="feature"/>
                    <property key="v0.2 / Capability Tier" value="FT"/>
                    <property key="v0.2 / Architectural Status" value="Proposed"/>
                    <property key="v0.2 / Record State" value="pending_adjudication"/>
                    <property key="v0.2 / Placement Status" value="Proposed"/>
                    <property key="v0.2 / Structural ID Status" value="Proposed"/>
                    <property key="v0.2 / Structural Canonical ID" value="CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-RESOURCE-CAPACITY-COORDINATION.CT3-BEC-SERVICE-OFFERING-READINESS-COORDINATION.FEAT-STEP2-SERVICE-READINESS-DEPENDENCY-ASSESSMENT"/>
                    <property key="v0.2 / Name Status" value="Proposed"/>
                    <property key="v0.2 / Architecture Identity Status" value="Unresolved — representation ID only"/>
                    <property key="v0.2 / Derivation Provenance" value="{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Inferred from capability-specific behaviour, v0.3 inspection and current architectural evidence&quot;,&quot;evidence&quot;:[{&quot;line&quot;:403,&quot;path&quot;:&quot;docs/markdown/02-strategy/capabilities/business-capabilities.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;**Boundary:** Available staff, equipment or an unoccupied bed does not establish usable service capacity. Available for service coverage ≠ deployed to a care requirement ≠ assigned operational work. Care Resource Deployment consumes availability, role, qualification, engagement and privilege context without changing authoritative rosters, qualifications, employment or privilege records. It establishes no Harmonia authority over clinical work, enterprise assets or hospital-wide logistics. Operational capacity is distinct from strategic/tactical capacity planning and from collective service readiness (OI-BC-002).&quot;},{&quot;line&quot;:34,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/information-responsibility/information-responsibility.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;[Context-specific Capacity Management](../behaviours/04-health-service-operations.md#capacity-management-responsibility-boundary) establishes/manages capacity meaning for Clinic &amp; Practice Operations, Ward Operations, Theatre Operations, Emergency Department Operations, Outpatient Operations and Mobile Staff Management. Their local information responsibilities express available, committed and utilised capacity without prescribing a shared formal Information Object or identical model. Bed/care-place and equipment state contribute; they do not alone establish service capacity. Service Capacity Management consumes/coordinates those capacity states; Work Allocation &amp; Dispatch and Discharge Management may consume them without acquiring their ownership. Exact provider contracts remain unestablished.&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;}"/>
                    <property key="v0.2 / Snapshot Record JSON" value="{&quot;adjudication_note&quot;:&quot;HUMAN ADJUDICATION REQUIRED: source proposal determines collective readiness; reviewed scope establishes dependency tracking only. Evidence may be reused, but determination authority is not silently transferred.&quot;,&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Proposed&quot;,&quot;baseline_version&quot;:null,&quot;boundary&quot;:&quot;Readiness evidence does not originate clinical clearance or transfer resource management.&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-RESOURCE-CAPACITY-COORDINATION.CT3-BEC-SERVICE-OFFERING-READINESS-COORDINATION.FEAT-STEP2-SERVICE-READINESS-DEPENDENCY-ASSESSMENT&quot;,&quot;canonical_name&quot;:null,&quot;category&quot;:null,&quot;confidence&quot;:&quot;Low&quot;,&quot;definition&quot;:&quot;Associate time- and context-qualified dependency evidence to establish a bounded readiness view for an offering.&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;proposal:feature-service-readiness-dependency-assessment&quot;,&quot;latex_label&quot;:&quot;feature:service-readiness-dependency-assessment&quot;,&quot;local_id&quot;:&quot;STEP2-SERVICE-READINESS-DEPENDENCY-ASSESSMENT&quot;,&quot;name&quot;:&quot;Service Readiness Dependency Assessment&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Proposed&quot;,&quot;overview&quot;:&quot;An offering may be in operating hours but not deliverable because staffing, equipment, materials or supporting services are missing. A readiness view retains insufficiency and the owners of those dependency assertions.&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-service-offering-readiness-coordination&quot;,&quot;owner_key&quot;:&quot;proposal:bec-service-offering-readiness-coordination&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_rationale&quot;:&q