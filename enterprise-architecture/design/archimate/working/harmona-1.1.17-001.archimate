iases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-BEC-specialist-clinical-context-integration&quot;,&quot;parent_key&quot;:&quot;proposal:bec-specialist-clinical-context-integration&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The responsibility concerns integrate specialist assessment, investigation and therapeutic information with longitudinal and episode context. It is the finest capability frame required for the established behaviour; the older contextual heading is not another capability tier.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;reference_id&quot;:&quot;HCM-BEC-therapeutic-services&quot;,&quot;relevance&quot;:&quot;Adjacent&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-enabling-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;view-3-service-delivery&quot;,&quot;line&quot;:369,&quot;source&quot;:&quot;e