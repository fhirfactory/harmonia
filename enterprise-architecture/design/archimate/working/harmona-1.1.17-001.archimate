                    <property key="v0.2 / Historical ID Aliases" value="[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-OPERATIONAL-WORKFORCE-COORDINATION.CT3-BEC-MOBILE-STAFF-MANAGEMENT.FEAT-STEP2-MOBILE-SERVICE-CAPACITY-MANAGEMENT&quot;]"/>
