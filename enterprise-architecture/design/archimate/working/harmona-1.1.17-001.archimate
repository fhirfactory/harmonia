                <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;ct2--health-service-alignment&quot;,&quot;line&quot;:889,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;##### CT2 — Health Service Alignment&quot;},{&quot;anchor&quot;:&quot;ct2--health-service-alignment&quot;,&quot;line&quot;:891,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Tier and ancestry:** CT2; parent Health Service Direction &amp; Stewardship (CT1).&quot;},{&quot;anchor&quot;:&quot;ct2--health-service-alignment&quot;,&quot;line&quot;:893,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Position the service coherently in its wider health-service ecosystem.&quot;},{&quot;anchor&quot;:&quot;ct2--health-service-alignment&quot;,&quot;line&quot;:904,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Boundary:** Alignment does not establish the authoritative service catalogue; it positions the service within the environment represented by that catalogue. Modelling determines what service is needed; alignment determines how it fits; Offering Management establishes the identifiable offering. Expected future Service Catalogue richness explains architectural relevance, but establishes neither a BEC identity/hierarchy nor a BC↔BEC mapping. Alignment does not resolve operational-readiness ancestry.&quot;}]"/>
                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Alignment does not establish the service offering, own the required resources or settle the unresolved ancestry of collective operational readiness.&quot;,&quot;Capability Overview&quot;:&quot;Health Service Alignment positions a service among the other services, resources and arrangements on which it depends. It considers reciprocal dependencies, required resources, financial fit and the organisational changes needed for introduction or material change. Where modelling asks what service is needed, alignment asks how it can fit coherently into its environment.&quot;,&quot;Intent&quot;:&quot;Expose the dependencies and surrounding commitments that affect service viability.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-HEALTH-SERVICE-DIRECTION-STEWARDSHIP.CT2-HEALTH-SERVICE-ALIGNMENT&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:health-service-direction--stewardship&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-HEALTH-SERVICE-DIRECTION-STEWARDSHIP.CT2-HEALTH-SERVICE-ALIGNMENT&quot;,&quot;canonical_name&quot;:&quot;Health Service Alignment&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nPosition the service coherently in its wider health-service ecosystem.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:health-service-alignment&quot;,&quot;latex_label&quot;:&quot;cap:bc-health-service-alignment&quot;,&quot;local_id&quot;:&quot;HEALTH-SERVICE-ALIGNMENT&quot;,&quot;name&quot;:&quot;Health Service Alignment&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot