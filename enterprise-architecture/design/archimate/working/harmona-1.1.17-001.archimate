                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;Discharge progression coordinates the confirmations and practical requirements around leaving care. Clinical readiness, medications, destination arrangements and transport are related but distinct contributions, and the source progression retains its stated local applicability. Operational coordination does not originate the clinical discharge decision or prove that another provider assumed responsibility.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:discharge-management&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-DISCHARGE-MANAGEMENT.PR-DISCHARGE-PROGRESSION-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Discharge Progression Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Discharge Management}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the multidisciplinary coordination of patient discharge planning, pharmacy reconciliation, transport, and community handover.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Discharge Planning Initiated → Clinical Readiness Confirmed → Medications Reconciled → Transport \\&amp; Services Booked → Discharge Summary Signed → Physically Departed (Illustrative preparation; publication, authorisation and exit distinct)\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Discharge Planning Initiated}}: Estimated Date of Discharge (EDD) set on admission.\n\n\n\n\\item \n\\texttt{\\seqsplit{Clinical Readiness Confirmed}}: Attending medical team declares patient fit for discharge.\n\n\n\n\\item \n\\texttt{\\seqsplit{Medications Reconciled}}: Hospital pharmacy reconciles and dispenses discharge medications.\n\n\n\n\\item \n\\texttt{\\seqsplit{Transport \\&amp; Services Booked}}: Community nursing, home equipment, and patient transport booked.\n\n\n\n\\item \n\\texttt{\\seqsplit{Discharge Summary Signed}}: Applicable signed summary is available/\\allowbreak{}published and may be communicated before departure where the Business behaviour requires it; signing, finalisation, publication and discharge authorisation remain distinct.\n\n\n\n\\item \n\\texttt{\\seqsplit{Physically Departed}}: Confirmed physical exit triggers departure notifications, updated bed-state communication and finalised-summary dispatch to external care providers under \\texttt{\\seqsplit{FEAT-HSO-29}}; care-place turnover follows its own responsibility.\n\n\n\n\\end{itemize}\n\n\n\\item \n\\textbf{Timing reconciliation}: Preparation, information availability/\\allowbreak{}publication, applicable discharge authorisation and physical exit are distinct. Earlier preparation/\\allowbreak{}communication is permitted; it does not realise a Feature triggered by confirmed exit. This illustrated local pathway establishes neither universal publication timing nor a universal discharge state machine, and adds no inferred publication event or authorisation state.\n\n\n\n\\item \n\\textbf{Preserved uncertainty}: Summary signing and finalisation are not universal equivalents. Detailed applicability, discharge-authority workflows and timing beyond the established preparation/\\allowbreak{}confirmed-exit distinction remain unestablished.\n\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-MOVEMENT-TRANSITION-COORDINATION.CT3-BEC-DISCHARGE-MANAGEMENT.PR-DISCHARGE-PROGRESSION-PROCESS&quot;],&quot;key&quot;:&quot;process:discharge-progression-process&quot;,&quot;latex_label&quot;:&quot;process:discharge-progression-process&quot;,&quot;local_id&quot;:&quot;DISCHARGE-PROGRESSION-PROCESS&quot;,&quot;name&quot;:&quot;Discharge Progression Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-discharge-management&quot;,&quot;owner_key&quot;:&quot;capability:discharge-management&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-discharge-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:discharge-management&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;413-discharge-progression-process&quot;,&quot;line&quot;:263,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 4.13 Discharge Progression Process&quot;},{&quot;anchor&quot;:&quot;413-discharge-progression-process&quot;,&quot;line&quot;:264,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Discharge Management`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:health-service-operations&quot;]}"/>
