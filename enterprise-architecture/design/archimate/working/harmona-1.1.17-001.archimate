ssurance Design&quot;,&quot;category&quot;:&quot;business_enabling&quot;,&quot;confidence&quot;:&quot;High&quot;,&quot;governed_definition_latex&quot;:&quot;\nThe capability to determine and define how satisfaction of a governed requirement, constraint or expected behaviour will be assured, including its assurance disposition, applicable criteria, required evidence and evaluation expectations.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;capability:assurance-design&quot;,&quot;latex_label&quot;:&quot;cap:bec-assurance-design&quot;,&quot;local_id&quot;:&quot;BEC-ASSURANCE-DESIGN&quot;,&quot;name&quot;:&quot;Assurance Design&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-BEC-assurance-specification-enablement&quot;,&quot;parent_key&quot;:&quot;proposal:bec-assurance-specification-enablement&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The responsibility concerns model how satisfaction will be assured and maintain applicable, temporally qualified criteria. It is the finest capability frame required for the established behaviour; the older contextual heading is not another capability tier.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;reference_id&quot;:&quot;HCM-BEC-assurance-design&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-enabling-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;assurance-design&quot;,&quot;line&quot;:680,&quot;source&quot;:&quot;enabling&quot;,&quot;text&quot;:&quot;### Assurance Design&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT3&quot;,&quot;type&quot;:&quot;capability&quot;,&quot;unresolved&quot;:[&quot;feature_decomposition&quot;,&quot;relevance&quot;],&quot;views&quot;:[]},&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BEC-assurance-design&quot;,&quot;responsibility_owner_key&quot;:null,&quot;review_provenance&quot;:{&quot;authority&quot;:&quot;Proposed structural assertions; existing Canonical semantic standing retained&quot;,&quot;derivation&quot;:&quot;Reconciliation against the explicit human-reviewed BEC candidate hierarchy&quot;,&quot;evidence&quot;:[{&quot;line&quot;:2,&quot;path&quot;:&quot;docs/latex-rad/Harmonia-EA-Capability-Map/v0.2-draft/reviewed-bec-hierarchy.json&quot;,&quot;standing&quot;:&quot;Explicit human task decision; reviewed candidate, not RADS acceptance&quot;,&quot;text&quot;:&quot; \&quot;authority\&quot;: \&quot;User-provided human-adjudicated reviewed candidate BEC hierarchy, 2026-10-16; bounded reconciliation input, not RADS acceptance.\&quot;,&quot;}],&quot;method&quot;:&quot;Bounded semantic reconciliation; no unconstrained synthesis&quot;},&quot;reviewed_name&quot;:&quot;Assurance Design&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-enabling-capabilities.md&quot;]