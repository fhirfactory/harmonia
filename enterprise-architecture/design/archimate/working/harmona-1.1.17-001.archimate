                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Evaluation does not establish adoption, authorise a clinical change or create an implementation responsibility. The single established child does not imply a complete innovation lifecycle.&quot;,&quot;Capability Overview&quot;:&quot;Health Innovation Evaluation is the organisation's ability to form a considered view of a proposed or emerging innovation before treating it as suitable for use. Within Health Innovation it brings suitability, value and implications into the same evaluative context, so that potential benefit can be considered alongside consequences for the health-service or clinical setting. The outcome supports informed consideration of adoption rather than making adoption inevitable.&quot;,&quot;Intent&quot;:&quot;Give decision makers an intelligible basis for considering whether an innovation merits further adoption consideration.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-HEALTH-RESEARCH-INNOVATION.CT2-HEALTH-INNOVATION.CT3-HEALTH-INNOVATION-EVALUATION&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;business-capability:health-innovation&quot;,&quot;tier&quot;:&quot;CT3&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-HEALTH-RESEARCH-INNOVATION.CT2-HEALTH-INNOVATION.CT3-HEALTH-INNOVATION-EVALUATION&quot;,&quot;canonical_name&quot;:&quot;Health Innovation Evaluation&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nEvaluate proposed/\\allowbreak{}emerging innovation for suitability, value, implications and potential adoption.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:health-innovation-evaluation&quot;,&q