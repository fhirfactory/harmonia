                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Conformance does not establish clinical truth, information authority or disclosure permission. Calliope is an established responsibility centre, not the definition of the capability.&quot;,&quot;Capability Overview&quot;:&quot;This capability makes canonical information models, terminology bindings, mappings and conformance rules governable across enterprise use. It addresses both what representations mean and whether they respect the published rules, keeping version and compatibility concerns explicit. A conformant representation can therefore be distinguished from one that merely uses a supported transport or parser.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;EC-13&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-EC-GOVERNED-INFORMATION-OPERATIONS.CT2-EC-13&quot;,&quot;canonical_name&quot;:&quot;Semantic Governance &amp; Conformance&quot;,&quot;category&quot;:&quot;enterprise&quot;,&quot;confidence&quot;:&quot;High&quot;,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Architectural Scope}: Govern canonical models, schemas, terminologies, value sets, mapping tables, constraint rules, and semantic conformance validation across the enterprise.\n\n\n\n\\item \n\\textbf{Functional Responsibilities}:\n\n\n\\begin{itemize}\n\n\\item \nDefining and publishing canonical healthcare data models and profile structures.\n\n\n\n\\item \nGoverning clinical terminology mappings, value sets, and concept lookups (SNOMED CT, LOINC).\n\n\n\n\\item \nValidating inbound and outbound message representations against published semantic rules.\n\n\n\n\\item \nGoverning semantic versioning, deprecation, and backward compatibility across schema revisions.\n\n\n\n\\end{itemize}\n\n\n\\item \n\\textbf{Component Relationship}: Informs the Calliope strategic logical component, but Calliope is the responsibility centre, not the capability definition.\n\n\n\n\\end{itemize}\n&quot;,&quot;id_aliases&quot;:[&quot;EC-13&quot;],&quot;key&quot;:&quot;enterprise:ec-13&quot;,&quot;latex_label&quot;:&quot;cap:ec-13&quot;,&quot;local_id&quot;:&quot;EC-13&quot;,&quot;name&quot;:&quot;Semantic Governance &amp; Conformance&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-EC-governed-information-operations&quot;,&quot;parent_key&quot;:&quot;proposal:ec-governed-information-operations&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The established reusable responsibility is a constituent ability of Governed Information Operations; its canonical scope and exclusions remain unchanged.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;EC-13&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/enterprise-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;ec-13-semantic-governance-conformance&quot;,&quot;line&quot;:215,&quot;source&quot;:&quot;enterprise&quot;,&quot;text&quot;:&quot;### EC-13: Semantic Governance &amp; Conformance&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT2&quot;,&quot;type&quot;:&quot;enterprise_capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[]}"/>
