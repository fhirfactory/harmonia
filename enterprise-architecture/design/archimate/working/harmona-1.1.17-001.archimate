                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Oversight evaluates governance without performing every peer activity. Adoption includes its own model-impact consideration; the listed abilities do not establish a sequential adoption Process.&quot;,&quot;Capability Overview&quot;:&quot;This capability governs which information models and standards the organisation adopts and how their use is supported and evaluated. The model distinguishes discovering candidates, adopting models, educating users, addressing conformity and overseeing governance. Standards impact identification has a separate established place because its implications may extend into clinical practice, policy and obligations beyond information-system implementation.&quot;,&quot;Intent&quot;:&quot;Make organisational standards use deliberate and its consequences understandable.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-STANDARDS-SEMANTICS-REFERENCE-GOVERNANCE.CT2-HEALTH-INFORMATION-STANDARDS-GOVERNANCE&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:standards-semantics--reference-governance&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-STANDARDS-SEMANTICS-REFERENCE-GOVERNANCE.CT2-HEALTH-INFORMATION-STANDARDS-GOVERNANCE&quot;,&quot;canonical_name&quot;:&quot;Health Information Standards Governance&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nGovern organisational adoption and use of health-information models and applicable standards.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:health-information-standards-governance&quot;,&quot;latex_label&quot;:&quot;cap