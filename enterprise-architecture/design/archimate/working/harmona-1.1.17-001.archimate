                <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;ct2--health-workforce-management&quot;,&quot;line&quot;:916,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;##### CT2 — Health Workforce Management&quot;},{&quot;anchor&quot;:&quot;ct2--health-workforce-management&quot;,&quot;line&quot;:918,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Tier and ancestry:** CT2; parent Workforce &amp; Organisational Capability (CT1).&quot;},{&quot;anchor&quot;:&quot;ct2--health-workforce-management&quot;,&quot;line&quot;:920,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Govern practitioners’ professional standing, engagement/privilege and whole-enterprise service coverage.&quot;},{&quot;anchor&quot;:&quot;ct2--health-workforce-management&quot;,&quot;line&quot;:930,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Boundary:** Qualified ≠ engaged ≠ privileged for a particular activity. Coverage is broader than rostering; it asks whether required work can be covered and how coverage should change. Care Resource Deployment applies available resources to a particular care requirement; Care Support Work Coordination progresses particular support work. Neither consumption of qualification/coverage information nor directory representation transfers the underlying workforce authority to Harmonia.&quot;}]"/>
                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Coverage is broader than rostering. Applying an available resource to a care requirement and progressing a particular support work item remain separate operational responsibilities.&quot;,&quot;Capability Overview&quot;:&quot;Health Workforce Management governs practitioners' professional standing, authorised participation and the ability to cover required enterprise work. Its three children separate qualification from engagement and privilege, and both from whole-enterprise coverage. This prevents an available or rostered person from being treated as automatically qualified and privileged for a particular activity.&quot;,&quot;Intent&quot;:&quot;Support legitimate practitioner participation and an informed understanding of service-coverage gaps and risks.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-WORKFORCE-ORGANISATIONAL-CAPABILITY.CT2-HEALTH-WORKFORCE-MANAGEMENT&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:workforce--organisational-capability&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-WORKFORCE-ORGANISATIONAL-CAPABILITY.CT2-HEALTH-WORKFORCE-MANAGEMENT&quot;,&quot;canonical_name&quot;:&quot;Health Workforce Management&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nGovern practitioners’ professional standing, engagement/\\allowbreak{}privilege and whole-enterprise service coverage.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:health-workforce-management&quot;,&quot;latex_label&quot;:&quot;cap:bc-health-workforce-management&quot;,&quot;local_id&quot;:&quot;HEALTH-WORKFORCE-MANAGEMENT&quot;,&quot;name&quot;:&quot;Health Workforce Management&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-BC-workforce-organisational-capability&quot;,&quot;parent_key&quot;:&quot;capability:workforce--organisational-capability&quot;,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BC-health-workforce-management&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;ct2--health-workforce-management&quot;,&quot;line&quot;:916,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;##### CT2 — Health Workforce Management&quot;},{&quot;anchor&quot;:&quot;ct2--health-workforce-management&quot;,&quot;line&quot;:918,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Tier and ancestry:** CT2; parent Workforce &amp; Organisational Capability (CT1).&quot;},{&quot;anchor&quot;:&quot;ct2--health-workforce-management&quot;,&quot;line&quot;:920,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Govern practitioners’ professional standing, engagement/privilege and whole-enterprise service coverage.&quot;},{&quot;anchor&quot;:&quot;ct2--health-workforce-management&quot;,&quot;line&quot;:930,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Boundary:** Qualified ≠ engaged ≠ privileged for a particular activity. Coverage is broader than rostering; it asks whether required work can be covered and how coverage should change. Care Resource Deployment applies available resources to a particular care requirement; Care Support Work Coordination progresses particular support work. Neither consumption of qualification/coverage information nor director