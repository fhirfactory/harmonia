                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Context participation does not transfer semantic ownership. Generic context management and assurance-specific context semantics contribute together without allocating a new central Context Service.&quot;,&quot;Capability Overview&quot;:&quot;Context Management preserves the circumstances in which information and activity have meaning as they cross processing boundaries. Subject, encounter, provider, service and security context must remain attributable and consistent rather than be reconstructed from convenient local assumptions. Its reuse is especially significant in multi-hop activity where a syntactically valid message can otherwise lose the context required for legitimate interpretation.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;EC-02&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-EC-GOVERNED-INFORMATION-OPERATIONS.CT2-EC-02&quot;,&quot;canonical_name&quot;:&quot;Context Management&quot;,&quot;category&quot;:&quot;enterprise&quot;,&quot;confidence&quot;:&quot;High&quot;,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Architectural Scope}: Establish, validate, propagate, and preserve the execution, clinical, security, and administrative context within which information and activities have meaning.\n\n\n\n\\item \n\\textbf{Functional Responsibilities}:\n\n\n\\begin{itemize}\n\n\\item \nBinding the subject of care, encounter, ordering provider, and healthcare service context to in-flight messages and transactions.\n\n\n\n\\item \nPropagating tamper-evident, attributable security context across asynchronous, multi-hop operational boundaries.\n\n\n\n\\item \nEnsuring context preservation during cross-protocol transformations across disparate healthcare exchange formats and protocols.\n\n\n\n\\item \nDetecting and rejecting requests where mandatory operational or clinical context is missing or inconsistent.\n\n\n\n\\end{itemize}\n\n\n\\item \n\\textbf{Collaborative Nature}: Bounded reusable context responsibility may be realised through participation across gateways, activity execution and information-access boundaries. Participation does not transfer semantic ownership.\n\n\n\n\\end{itemize}\n&quot;,&quot;id_aliases&quot;:[&quot;EC-02&quot;],&quot;key&quot;:&quot;enterprise:ec-02&quot;,&quot;latex_label&quot;:&quot;cap:ec-02&quot;,&quot;local_id&quot;:&quot;EC-02&quot;,&quot;name&quot;:&quot;Context Management&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-EC-governed-information-operations&quot;,&quot;parent_key&quot;:&quot;proposal:ec-governed-information-operations&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The established reusable responsibility is a constituent ability of Governed Information Operations; its canonical scope and exclusions remain unchanged.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;EC-02&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/enterprise-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;ec-02-context-management&quot;,&quot;line&quot;:112,&quot;source&quot;:&quot;enterprise&quot;,&quot;text&quot;:&quot;### EC-02: Context Management&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT2&quot;,&quot;type&quot;:&quot;enterprise_capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[]}"/>
                <property key="v0.2 / Source Parent Reference" value="HCM-EC-governed-information-operations"/>
