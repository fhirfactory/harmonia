                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Receiving a notification does not determine the consumer's business response; topics and queues do not define the capability.&quot;,&quot;Capability Overview&quot;:&quot;Event &amp; Subscription connects significant changes with participants whose registered interests match them. It makes event ingestion, correlation, interest criteria and notification reusable across clinical and operational contexts. The architectural meaning is the relationship between a change and an interested consumer, rather than the broker constructs used to carry it.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;EC-09&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-EC-COORDINATED-ACTIVITY-INTERACTION.CT2-EC-09&quot;,&quot;canonical_name&quot;:&quot;Event &amp; Subscription&quot;,&quot;category&quot;:&quot;enterprise&quot;,&quot;confidence&quot;:&quot;High&quot;,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Architectural Scope}: Publish, ingest, correlate, filter, and syndicate events and subscription-driven changes across the enterprise landscape.\n\n\n\n\\item \n\\textbf{Functional Responsibilities}:\n\n\n\\begin{itemize}\n\n\\item \nIngesting operational and clinical event triggers from external systems and internal state changes.\n\n\n\n\\item \nManaging topic- and criteria-based event subscriptions for internal and external consumers.\n\n\n\n\\item \nEvaluating dynamic subscription filters to match event payloads with interested subscriber criteria.\n\n\n\n\\item \nDelivering asynchronous event notifications reliably to registered subscribers.\n\n\n\n\\end{itemize}\n\n\n\\item \n\\textbf{Decoupling Note}: Defined strictly in terms of event publishing, criteria matching, and notification delivery; entirely independent of broker topics, partitions, or queues.\n\n\n\n\\end{itemize}\n&quot;,&quot;id_aliases&quot;:[&quot;EC-09&quot;],&quot;key&quot;:&quot;enterprise:ec-09&quot;,&quot;latex_label&quot;:&quot;cap:ec-09&quot;,&quot;local_id&quot;:&quot;EC-09&quot;,&quot;name&quot;:&quot;Event &amp; Subscription&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-EC-coordinated-activity-interaction&quot;,&quot;parent_key&quot;:&quot;proposal:ec-coordinated-activity-interaction&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;The established reusable responsibility is a constituent ability of Coordinated Activity &amp; Interaction; its canonical scope and exclusions remain unchanged.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;EC-09&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/enterprise-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;ec-09-event-subscription&quot;,&quot;line&quot;:175,&quot;source&quot;:&quot;enterprise&quot;,&quot;text&quot;:&quot;### EC-09: Event &amp; Subscription&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT2&quot;,&quot;type&quot;:&quot;enterprise_capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[]}"/>
                <property key="v0.2 / Source Parent Reference" value="HCM-EC-coordinated-activity-interaction"/>
