                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Defining control context does not itself enforce the controls or establish that they operate effectively.&quot;,&quot;Capability Overview&quot;:&quot;Access Control Context Management establishes what requires control, the circumstances in which control applies and how those requirements are modelled. It gives access governance an explicit subject and context rather than reducing it to assembling runtime attributes. The responsibility can encompass information, functions and activities under physical, procedural or digital arrangements.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-DIGITAL-IDENTITY-ACCESS-GOVERNANCE.CT3-ACCESS-CONTROL-CONTEXT-MANAGEMENT&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;business-capability:digital-identity--access-governance&quot;,&quot;tier&quot;:&quot;CT3&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-DIGITAL-IDENTITY-ACCESS-GOVERNANCE.CT3-ACCESS-CONTROL-CONTEXT-MANAGEMENT&quot;,&quot;canonical_name&quot;:&quot;Access Control Context Management&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nDetermine what information, functions, activities or other concerns require control, under what circumstances and how requirements are modelled.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:access-control-context-management&quot;,&quot;latex_label&quot;:&quot;cap:bc-access-control-context-management&quot;,&quot;local_id&quot;:&quot;ACCESS-CONTROL-CONTEXT-MANAGEMENT&quot;,&quot;name&quot;:&quot;Access Control Context Management&quot