                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Determining clinical meaning does not itself select the care response. No CT3 taxonomy has been adjudicated; diagnosis and prognostic judgement illustrate this responsibility without becoming additional catalogue elements.&quot;,&quot;Capability Overview&quot;:&quot;Clinical Determination turns assessed findings into clinically interpreted understanding of a person's condition, risk or prognosis. It represents the professional responsibility for deciding what the findings mean in the individual's clinical context, including the significance of changes identified through monitoring. This is the interpretive responsibility within Individual Care Delivery, rather than another method of collecting evidence.&quot;,&quot;Intent&quot;:&quot;Establish clinical conclusions on which an intended response can be based.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-INDIVIDUAL-CARE-DELIVERY.CT2-CLINICAL-DETERMINATION&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:individual-care-delivery&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-INDIVIDUAL-CARE-DELIVERY.CT2-CLINICAL-DETERMINATION&quot;,&quot;canonical_name&quot;:&quot;Clinical Determination&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nThe capability to interpret assessed health information and establish clinically meaningful conclusions about an individual's health state, condition, risk or prognosis.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;capability:clinical-determination&quot;,&quot;latex_label&quot;:&quot;cap:bc-clinical-determination&quot;,&quot;local_id&quot;:&quot;CLINICAL-DETERMINATION&quot;,&quot;name&quot;:&quot;Clinical Determination&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-BC-individual-care-delivery&quot;,&quot;parent_key&quot;:&quot;capability:individual-care-delivery&quot;,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BC-clinical-determination&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;0102-clinical-determination&quot;,&quot;line&quot;:186,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;##### 01.02 Clinical Determination&quot;},{&quot;anchor&quot;:&quot;0102-clinical-determination&quot;,&quot;line&quot;:188,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Tier and ancestry:** CT2; parent Individual Care Delivery (CT1).&quot;}],&quot;structural_id_status&quot;:&quot;Established&quot;,&quot;tier&quot;:&quot;CT2&quot;,&quot;type&quot;:&quot;capability&quot;,&quot;unresolved&quot;:[&quot;relevance&quot;],&quot;views&quot;:[&quot;region:care--health-delivery&quot;]}"/>
