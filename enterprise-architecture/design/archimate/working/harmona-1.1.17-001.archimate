                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Process Overview&quot;:&quot;This Process illustrates one specialist pathway through validation, triage and booking. It makes that pathway's progression visible without imposing it on every referral: rejection, decline or redirection can be legitimate dispositions, and a request need not universally lead to attendance. Neither a transmitted referral nor the local compound acceptance/waitlist checkpoint establishes actual responsibility transfer.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:&quot;capability:referral-administration&quot;,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;ancestry&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;feature_association&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-BEC-CARE-ADMINISTRATION-INFORMATION-ENABLEMENT.CT2-BEC-REFERRAL-ADMINISTRATION.PR-REFERRAL-PROGRESSION-PROCESS&quot;,&quot;canonical_name&quot;:&quot;Referral Progression Process&quot;,&quot;category&quot;:null,&quot;governed_definition_latex&quot;:&quot;\n\\begin{itemize}\n\n\\item \n\\textbf{Owning Capability}: \\texttt{\\seqsplit{Referral Administration}}\n\n\n\n\\item \n\\textbf{Process Purpose}: Governs the end-to-end operational progression of an incoming clinical referral from receipt through specialist clinical triage, booking, and final service acceptance.\n\n\n\n\\item \n\\textbf{Scope qualification}: This illustrates a specialist booking/\\allowbreak{}attendance pathway; Referral does not universally require acceptance, scheduling, attendance or discharge, or establish delivery, responsibility actually assumed or Transfer of Care. Decline, rejection and redirection remain valid dispositions without invented transition paths. \\texttt{\\seqsplit{Accepted / Waitlisted}} is a local compound checkpoint, not universal equivalence between acceptance and waitlisting.\n\n\n\n\\item \n\\textbf{State Progression Lifecycle}: Submitted → Intake Validated → Clinically Triaged → Accepted /\\allowbreak{} Waitlisted → Scheduled → Consultation Attended → Discharged /\\allowbreak{} Rejected (Illustrative specialist pathway; dispositions vary)\n\n\n\n\\item \n\\textbf{Key State Dispositions}:\n\n\n\\begin{itemize}\n\n\\item \n\\texttt{\\seqsplit{Submitted}}: Electronic referral received from GP or external facility.\n\n\n\n\\item \n\\texttt{\\seqsplit{Intake Validated}}: Administrative validation of patient details, mandatory fields, and tests.\n\n\n\n\\item \n\\texttt{\\seqsplit{Clinically Triaged}}: Senior clinician assigns urgency category (e.g., Cat 1 urgent within 30 days).\n\n\n\n\\item \n\\texttt{\\seqsplit{Accepted / Waitlisted}}: Referral accepted and placed onto the specialty waitlist.\n\n\n\n\\item \n\\texttt{\\seqsplit{Scheduled}}: Outpatient appointment allocated and patient notified.\n\n\n\n\\item \n\\texttt{\\seqsplit{Consultation Attended}}: Patient seen; initial specialist assessment completed.\n\n\n\n\\item \n\\texttt{\\seqsplit{Discharged / Rejected}}: Referral completed and discharged back to primary care, or formally rejected with clinical rationale.\n\n\n\n\\end{itemize}\n\n\n\\end{itemize}\n\n\\par\\smallskip\n&quot;,&quot;id_aliases&quot;:[&quot;CT1-BEC-CARE-ADMINISTRATION-INFORMATION-ENABLEMENT.CT2-BEC-CARE-ACCESS-TRANSACTION-ENABLEMENT.CT3-BEC-REFERRAL-ADMINISTRATION.PR-REFERRAL-PROGRESSION-PROCESS&quot;],&quot;key&quot;:&quot;process:referral-progression-process&quot;,&quot;latex_label&quot;:&quot;process:referral-progression-process&quot;,&quot;local_id&quot;:&quot;REFERRAL-PROGRESSION-PROCESS&quot;,&quot;name&quot;:&quot;Referral Progression Process&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:&quot;HCM-BEC-referral-administration&quot;,&quot;owner_key&quot;:&quot;capability:referral-administration&quot;,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-PR-referral-progression-process&quot;,&quot;responsibility_owner_key&quot;:&quot;capability:referral-administration&quot;,&quot;source_rad_documents&quot;:[&quot;docs/markdown/03-business-architecture/processes/business-processes.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;33-referral-progression-process&quot;,&quot;line&quot;:102,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;### 3.3 Referral Progression Process&quot;},{&quot;anchor&quot;:&quot;33-referral-progression-process&quot;,&quot;line&quot;:103,&quot;source&quot;:&quot;processes&quot;,&quot;text&quot;:&quot;- **Owning Capability**: `Referral Administration`&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:null,&quot;type&quot;:&quot;process&quot;,&quot;unresolved&quot;:[&quot;feature_association&quot;],&quot;views&quot;:[&quot;view:service-administration&quot;]}"/>
