                <property key="v0.2 / Source Locators" value="[{&quot;anchor&quot;:&quot;ct2--care-coordination--transition&quot;,&quot;line&quot;:405,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;##### CT2 — Care Coordination &amp; Transition&quot;},{&quot;anchor&quot;:&quot;ct2--care-coordination--transition&quot;,&quot;line&quot;:407,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Tier and ancestry:** CT2; parent Care Access &amp; Coordination (CT1).&quot;},{&quot;anchor&quot;:&quot;ct2--care-coordination--transition&quot;,&quot;line&quot;:409,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Coordinate care participation, actual responsibility transition and discharge.&quot;},{&quot;anchor&quot;:&quot;ct2--care-coordination--transition&quot;,&quot;line&quot;:419,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Boundary:** Patient moved ≠ care responsibility transferred. Arrival, referral submission, message receipt, discharge readiness or physical departure does not itself establish acceptance of responsibility. Information assembly for clinical handover does not confer clinical-handover management authority on Harmonia.&quot;}]"/>
                <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Harmonia may assemble handover information without managing clinical handover. Arrival, discharge readiness and physical departure are not equivalent to responsibility acceptance.&quot;,&quot;Capability Overview&quot;:&quot;Care Coordination &amp; Transition supports continuity by keeping participation, actual responsibility assumption and discharge progression distinct. Care teams may collaborate while responsibility is shared or changes, but physical transit and information exchange do not themselves establish who has accepted care. The capability therefore addresses continuity of accountable participation as well as the practical circumstances of departure.&quot;,&quot;Intent&quot;:&quot;Avoid gaps in care continuity caused by treating a movement or communication as an accepted responsibility transition.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-CARE-ACCESS-COORDINATION.CT2-CARE-COORDINATION-TRANSITION&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;capability:care-access--coordination&quot;,&quot;tier&quot;:&quot;CT2&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-CARE-ACCESS-COORDINATION.CT2-CARE-COORDINATION-TRANSITION&quot;,&quot;canonical_name&quot;:&quot;Care Coordination &amp; Transition&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nCoordinate care participation, actual responsibility transition and discharge.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:care-coordination--transition&quot;,&quot;latex_label&quot;:&quot;cap:bc-care-coordination-transition&quot;,&quot;local_id&quot;:&quot;CARE-COORDINATION-TR