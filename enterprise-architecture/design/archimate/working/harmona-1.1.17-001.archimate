                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;ancestry_status&quot;:&quot;established&quot;,&quot;architectural_status&quot;:&quot;Canonical&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Authentication neither establishes every required identity-quality condition nor authorises the requested activity.&quot;,&quot;Capability Overview&quot;:&quot;This capability identifies the acting participant and authenticates the asserted identity. It establishes who is acting under the applicable identity arrangements so that later control and accountability can be grounded in an identified actor. The outcome remains distinct from confidence established through identity evidence and from authority to access a controlled concern.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-DIGITAL-IDENTITY-ACCESS-GOVERNANCE.CT3-IDENTITY-IDENTIFICATION-AUTHENTICATION&quot;,&quot;owner_key&quot;:null,&quot;parent_key&quot;:&quot;business-capability:digital-identity--access-governance&quot;,&quot;tier&quot;:&quot;CT3&quot;},&quot;baseline_unresolved&quot;:[&quot;relevance&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-SECURITY-PRIVACY-DIGITAL-TRUST.CT2-DIGITAL-IDENTITY-ACCESS-GOVERNANCE.CT3-IDENTITY-IDENTIFICATION-AUTHENTICATION&quot;,&quot;canonical_name&quot;:&quot;Identity Identification &amp; Authentication&quot;,&quot;category&quot;:&quot;business&quot;,&quot;governed_definition_latex&quot;:&quot;\nIdentify an actor and authenticate the asserted identity.\n\n&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:identity-identification--authentication&quot;,&quot;latex_label&quot;:&quot;cap:bc-identity-identification-authentication&quot;,&quot;local_id&quot;:&quot;IDENTITY-IDENTIFICATION-AUTHENTICATION&quot;,&quot;name&quot;:&quot;Identity Identification &amp; Authentication&quot;,&quot;name_aliases&quot;:[],&quot;name_sta