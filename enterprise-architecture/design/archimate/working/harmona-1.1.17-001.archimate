                  <property key="v0.2 / Snapshot Record JSON" value="{&quot;alternative_considered&quot;:&quot;Health Service Direction &amp; Stewardship is plausible for standing site/service readiness; access-oriented placement is chosen to retain the deliverability question.&quot;,&quot;ancestry_status&quot;:&quot;proposed&quot;,&quot;architectural_status&quot;:&quot;Candidate&quot;,&quot;baseline_description&quot;:{&quot;Boundary&quot;:&quot;Tier, parent and CT1 ancestry remain unresolved. Site-level and session-level exercises do not establish separate capabilities, and no convenient parent is allocated here.&quot;,&quot;Capability Overview&quot;:&quot;This candidate concern asks whether an identifiable health-service offering can actually be delivered from its operational context. Its meaning is collective: workforce, places, equipment, materials, utilities and other dependencies must be considered together without acquiring their ownership. It explains why a defined offering, available practitioner or ready bed alone cannot establish service readiness.&quot;},&quot;baseline_placement&quot;:{&quot;canonical_id&quot;:null,&quot;owner_key&quot;:null,&quot;parent_key&quot;:null,&quot;tier&quot;:null},&quot;baseline_unresolved&quot;:[&quot;tier&quot;,&quot;ancestry&quot;,&quot;root_status&quot;,&quot;canonical_id&quot;,&quot;code_allocation&quot;,&quot;identified_readiness_placement&quot;],&quot;baseline_version&quot;:&quot;0.1&quot;,&quot;canonical_id&quot;:&quot;CT1-CARE-ACCESS-COORDINATION.CT2-BC-SERVICE-DELIVERY-PREPAREDNESS-MANAGEMENT.CT3-BC-HEALTH-SERVICE-OPERATIONAL-READINESS&quot;,&quot;canonical_name&quot;:&quot;Health Service Operational Readiness&quot;,&quot;category&quot;:&quot;business&quot;,&quot;confidence&quot;:&quot;Low&quot;,&quot;governed_definition_latex&quot;:&quot;&quot;,&quot;id_aliases&quot;:[],&quot;key&quot;:&quot;business-capability:health-service-operational-readiness&quot;,&quot;latex_label&quot;:&quot;cap:bc-health-service-operational-readiness&quot;,&quot;local_id&quot;:&quot;BC-HEALTH-SERVICE-OPERATIONAL-READINESS&quot;,&quot;name&quot;:&quot;Health Service Operational Readiness&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Candidate&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:&quot;HCM-BC-service-delivery-preparedness-management&quot;,&quot;parent_key&quot;:&quot;proposal:bc-service-delivery-preparedness-management&quot;,&quot;placement_provenance&quot;:{&quot;authority&quot;:&quot;Proposed only; cited source standing is not inherited&quot;,&quot;derivation&quot;:&quot;Responsibility-preserving proposed decomposition&quot;,&quot;evidence&quot;:[{&quot;line&quot;:49,&quot;path&quot;:&quot;docs/markdown/03-business-architecture/metamodel/business-architecture-metamodel.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;Harmonia SHALL use the fixed three-tier Capability decomposition:&quot;},{&quot;line&quot;:668,&quot;path&quot;:&quot;docs/markdown/governance/architectural-axioms.md&quot;,&quot;standing&quot;:&quot;Current corpus evidence; does not promote the derived assertion&quot;,&quot;text&quot;:&quot;### AX-14 — Semantic Distinctions Are Preserved&quot;}],&quot;method&quot;:&quot;AI architectural synthesis under the explicitly authorised Step 2 task&quot;},&quot;placement_rationale&quot;:&quot;Collective readiness is an access prerequisite and has a coherent proposed preparedness frame; it is not reduced to capacity, resource state or service alignment.&quot;,&quot;placement_status&quot;:&quot;Proposed&quot;,&quot;proposal_boundary&quot;:&quot;The element remains Candidate. The definition/placement elaboration is Proposed and does not adjudicate the unresolved RAD question or transfer source-domain authority.&quot;,&quot;proposal_definition&quot;:&quot;Establish collective operational readiness of a service offering in a site or session context from its applicable dependencies.&quot;,&quot;proposal_overview&quot;:&quot;Collective readiness is an access prerequisite and has a coherent proposed preparedness frame; it is not reduced to capacity, resource state or service alignment.&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BC-health-service-operational-readiness&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;oi-bc-002--health-service-operational-readiness-placement&quot;,&quot;line&quot;:1201,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;Its provisional name/identified identity and boundary are retained, but **CT2 parent,&quot;}],&quot;structural_id_status&quot;:&quot;Proposed&quot;,&quot;tier&quot;:&quot;CT3&quot;,&quot;type&quot;:&quot;capability&quot;,&quot;unresolved&quot;:[&quot;identified_readiness_placement&quot;],&quot;views&quot;:[]}"/>
