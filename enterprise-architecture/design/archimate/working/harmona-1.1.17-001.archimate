nected-health-services&quot;,&quot;latex_label&quot;:&quot;cap:bc-connected-health-services&quot;,&quot;local_id&quot;:&quot;CONNECTED-HEALTH-SERVICES&quot;,&quot;name&quot;:&quot;Connected Health Services&quot;,&quot;name_aliases&quot;:[],&quot;name_status&quot;:&quot;Canonical&quot;,&quot;owner_identifier&quot;:null,&quot;owner_key&quot;:null,&quot;parent_identifier&quot;:null,&quot;parent_key&quot;:null,&quot;placement_status&quot;:&quot;Established&quot;,&quot;record_state&quot;:&quot;current&quot;,&quot;reference_id&quot;:&quot;HCM-BC-connected-health-services&quot;,&quot;relevance&quot;:&quot;Harmonia-Core&quot;,&quot;responsibility_owner_key&quot;:null,&quot;source_rad_documents&quot;:[&quot;docs/markdown/02-strategy/capabilities/business-capabilities.md&quot;],&quot;sources&quot;:[{&quot;anchor&quot;:&quot;11-connected-health-services&quot;,&quot;line&quot;:730,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;#### 11. Connected Health Services&quot;},{&quot;anchor&quot;:&quot;11-connected-health-services&quot;,&quot;line&quot;:734,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;**Definition:** Exchange health information appropriately and provide digitally mediated communication, notifications and collaborative interaction between health-service participants.&quot;},{&quot;anchor&quot;:null,&quot;line&quot;:120,&quot;source&quot;:&quot;business&quot;,&quot;text&quot;:&quot;catalogue domains below are explicitly **CT1 roots**; each branch statement&quot;}],&quot;structural_id_status&quot;:&quot;Established&quot;,&quot;tier&quot;:&quot;CT1&quot;,&quot;type&quot;:&quot;capability&quot;,&quot;unresolved&quot;:[],&quot;views&quot;:[&quot;region:health-information--digital-health&quot;]}"/>
