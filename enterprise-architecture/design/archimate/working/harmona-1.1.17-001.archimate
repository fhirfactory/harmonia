                    <property key="v0.2 / Historical ID Aliases" value="[&quot;CT1-BEC-CARE-OPERATIONS-COORDINATION-ENABLEMENT.CT2-BEC-CARE-SETTING-OPERATIONS-ENABLEMENT.CT3-BEC-CLINIC-PRACTICE-OPERATIONS.FEAT-STEP2-CLINIC-SESSION-CAPACITY-MANAGEMENT&quot;]"/>
