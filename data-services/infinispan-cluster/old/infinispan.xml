<infinispan
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xmlns="urn:infinispan:config:15.0"
        xsi:schemaLocation="urn:infinispan:config:15.0 https://infinispan.org/schemas/infinispan-config-15.0.xsd">

    <jgroups>
        <stack name="tcp-stack">
            <TCP bind_port="7800" port_range="10" recv_buf_size="20M" send_buf_size="640K"
                 bundler_type="transfer-queue"
                 thread_pool.min_threads="0" thread_pool.max_threads="20" thread_pool.keep_alive_time="30000"/>
            <RED/>
            <MPING break_on_coord_rsp="true"
                   mcast_addr="${jgroups.mping.mcast_addr:239.2.4.1}"
                   mcast_port="${jgroups.mping.mcast_port:46655}"
                   ip_ttl="${jgroups.udp.ip_ttl:2}"
                   num_discovery_runs="3"/>
            <MERGE3 min_interval="10000" max_interval="30000"/>
            <FD_SOCK/>
            <FD_ALL timeout="60000" interval="15000"/>
            <VERIFY_SUSPECT timeout="1500"/>
            <pbcast.NAKACK2 xmit_interval="1000"
                            xmit_table_num_rows="100"
                            xmit_table_msgs_per_row="10000"
                            xmit_table_max_compaction_time="30000"
                            resend_last_seqno="true"/>
            <UNICAST3 xmit_interval="500"
                      xmit_table_num_rows="100"
                      xmit_table_msgs_per_row="10000"
                      xmit_table_max_compaction_time="30000"/>
            <pbcast.STABLE desired_avg_gossip="50000"
                           max_bytes="4M"/>
            <pbcast.GMS print_local_addr="true" join_timeout="2000"/>
            <UFC max_credits="2M" min_threshold="0.4"/>
            <MFC max_credits="2M" min_threshold="0.4"/>
            <FRAG3 frag_size="60K"/>
        </stack>
    </jgroups>

    <cache-container name="hie-cluster-container" default-cache="person-cache" statistics="true">
        <transport cluster="hie-fhir-cluster" stack="tcp-stack" node-name="${infinispan.node.name:node1}"/>

        <!-- Replicated Caches with Write-Behind Persistence -->
        <replicated-cache name="person-cache" mode="SYNC" statistics="true">
            <encoding media-type="application/json"/>
            <persistence>
                <store class="net.fhirfactory.hie.persistence.store.FhirRestCacheStore" shared="true" preload="false" fetch-state="false" segmented="false">
                    <property name="serverUrl">${fhir.server.url:http://hapi-fhir-jpa-server-1:8080/fhir}</property>
                    <property name="timeoutSeconds">10</property>
                    <write-behind modification-queue-size="1024" />
                </store>
            </persistence>
        </replicated-cache>

        <replicated-cache name="relatedperson-cache" mode="SYNC" statistics="true">
